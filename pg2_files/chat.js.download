(() => {
  // UI text in the viewer's language: pgTc() comes from /assets/compiled/js/i18n.js. Without it
  // the Hebrew comes back as written, with its {placeholders} filled.
  const _pgTc = function (text, vars, ctx) {
    if (typeof window.pgTc === 'function') return window.pgTc(text, vars, ctx);
    return vars ? String(text).replace(/\{(\w+)\}/g, function (m, k) { return Object.prototype.hasOwnProperty.call(vars, k) ? String(vars[k]) : m; }) : text;
  };
  // The page's direction, for the panels this file builds as HTML strings. They sit inside a
  // position:fixed widget that does not inherit it, so each one has to carry it. Hebrew and
  // Arabic get 'rtl' — the value that was written here literally before English existed.
  const _pgDir = function () {
    return document.documentElement.getAttribute('dir') === 'ltr' ? 'ltr' : 'rtl';
  };
  // A count: pgTn() maps it to the Arabic plural forms; Hebrew picks one/other exactly like tn().
  const _pgTn = function (one, other, n, vars, ctx) {
    if (typeof window.pgTn === 'function') return window.pgTn(one, other, n, vars, ctx);
    const count = parseInt(n, 10) || 0;
    const all = Object.assign({}, vars || {});
    if (!Object.prototype.hasOwnProperty.call(all, 'n')) all.n = count;
    return _pgTc(count === 1 ? one : other, all);
  };
  // A rejection text from the socket server (pgishonim_chat_server/chat-server.js), which answers
  // in Hebrew: its fixed texts are keys of the common catalog, and its one text carrying a
  // number is matched back to its key — as a count, since the wait is 1..5 seconds and the
  // catalog words it per plural form (the same text twice keeps the Hebrew exactly as sent).
  const _pgServerText = function (text) {
    const s = String(text);
    const wait = s.match(/^ניתן לשלוח הודעה כל 5 שניות\. נסה שוב בעוד (\d+) שניות$/);
    if (wait) return _pgTn('ניתן לשלוח הודעה כל 5 שניות. נסה שוב בעוד {n} שניות', 'ניתן לשלוח הודעה כל 5 שניות. נסה שוב בעוד {n} שניות', wait[1], { n: wait[1] });
    return _pgTc(s);
  };
  const state = {
    tab: "threads",
    activeThreadId: null,
    threads: [],
    onlineUsers: new Map(), // { "type:id": { type, id, name } }
    lastSeenAt: new Map(), // { "type:id": Date } - tracks when user was last seen online
    unreadCount: 0,
    isOpen: false,
    serverConnected: false,
    threadsLoaded: false,
    initialDbBootstrapDone: false,
    supportOpen: false,
    aiChatBotType: null,
    // The support team's answers waiting while the chat is closed (support_notice.js) — counted on the button.
    supportUnseen: 0,
    // The support chat's own poll is running (startHuman) — the page's lighter watch is not needed then.
    supportPolling: false,
    activeGroupMembers: [],
    activeGroupMemberCount: 0,       // every member; the list itself is a manager's, loaded in pages
    activeGroupMembersHasMore: false,
    activeThreadMuted: false,
    activeThreadCanManageMembers: false,
    activeThreadIsOwner: false,
    activeThreadCanMessageMode: 'all',
    activeThreadSchedule: [],
    activeThreadReads: new Map(),
    activeThreadDelivered: new Map(),
    activeThreadDeliveredSupported: false,
    reactionsByMsg: new Map(),
    oldestMessageId: null,
    hasMoreMessages: false,
    loadingMoreMessages: false,
    editingMessageId: null,
    parentChildren: new Map(), // { parentId: "first last - class, ..." } for parents missing from cfg.contacts
  };

  const cfg = window.PG_CHAT;
  if (!cfg) {
    console.error('PG_CHAT config missing', cfg);
    // Show error to user
    if (document.getElementById('pgChatList')) {
      document.getElementById('pgChatList').innerHTML = '<div class="p-4 text-center text-danger"><strong>' + _pgTc('שגיאה:') + '</strong> ' + _pgTc('הגדרות הצ\'אט לא נטענו. אנא רענן את הדף.') + '</div>';
    }
    return;
  }

  cfg.chatServerUrl = cfg.chatServerUrl || window.location.origin;

  // ── Persist widget state across page navigations ──
  var _chatStateKey = 'pg_chat_state';
  function saveWidgetState() {
    try {
      localStorage.setItem(_chatStateKey, JSON.stringify({
        isOpen: state.isOpen,
        tab: state.tab,
        activeThreadId: state.activeThreadId,
        supportOpen: state.supportOpen,
        aiChatBotType: state.supportOpen ? (state.aiChatBotType || null) : null,
        ts: Date.now()
      }));
    } catch (e) {}
  }
  function loadWidgetState() {
    try {
      var raw = localStorage.getItem(_chatStateKey);
      if (!raw) return null;
      var s = JSON.parse(raw);
      // Expire after 30 minutes of inactivity
      if (!s || !s.ts || (Date.now() - s.ts) > 30 * 60 * 1000) {
        localStorage.removeItem(_chatStateKey);
        return null;
      }
      return s;
    } catch (e) { return null; }
  }
  var _skipSaveOnUnload = false;
  function clearWidgetState() {
    _skipSaveOnUnload = true;
    try { localStorage.removeItem(_chatStateKey); } catch (e) {}
  }

  // Show initial unread badge immediately (from PHP session, no API call)
  if (cfg.initialUnread > 0) {
    var _badge = document.getElementById("pgChatBadge");
    if (_badge) {
      _badge.textContent = cfg.initialUnread > 99 ? "99+" : cfg.initialUnread;
      _badge.classList.add("visible");
    }
  }

  // Widget Elements
  const elWidget = document.getElementById("pgChatWidget");
  const elToggle = document.getElementById("pgChatToggle");
  const elBadge = document.getElementById("pgChatBadge");
  const elClose = document.getElementById("pgChatCloseWidget");
  const elSidebar = document.getElementById("pgChatSidebar");
  const elMain = document.getElementById("pgChatMain");
  const elAlertSettingsBtn = document.getElementById("pgChatAlertSettingsBtn");

  const elList = document.getElementById("pgChatList");
  const elSearch = document.getElementById("pgChatSearch");
  const elMessages = document.getElementById("pgChatMessages");
  const elForm = document.getElementById("pgChatForm");
  const elInput = document.getElementById("pgChatInput");
  const elTitle = document.getElementById("pgChatTitle");
  const elSubtitle = document.getElementById("pgChatSubtitle");
  const elStatus = document.getElementById("pgChatStatus");
  const elBack = document.getElementById("pgChatBackBtn");
  const elActiveAvatar = document.getElementById("pgChatActiveAvatar");
  const elHeaderActions = document.getElementById("pgChatHeaderActions");
  let elGroupMembersPanel = null;
  let elGroupMembersCount = null;
  let elGroupMembersList = null;
  let elHeaderMuteBtn = null;
  var openFallbackTimeout = null;
  // Image attachments loaded in the background (loadAttachmentImages).
  const localAttachmentBlobs = new Map(); // message id -> the file this tab has just uploaded
  const attachmentBlobUrls = new Set();
  const elEditBanner = document.getElementById("pgChatEditBanner");
  const elEditCancel = document.getElementById("pgChatEditCancel");
  // Edit / delete-for-everyone window — must match the server
  // (chat-server.js EDIT_DELETE_WINDOW_MINUTES / threads_api.php $edit_window_minutes).
  const EDIT_DELETE_WINDOW_MS = 15 * 60 * 1000;
  // Rendered message id -> message object, so an edit/delete can re-render a
  // single bubble in place. Cleared whenever the message list fully repaints.
  const renderedMessages = new Map();
  // Optimistic dedup key -> optimistic DOM id, so an own message's server echo
  // can "promote" its optimistic bubble to carry the real (editable) id.
  const optimisticByKey = new Map();

  // Socket init (resilient — noop if socket.io blocked)
  const _noop = function() {};
  const _noopEE = { on: _noop, once: _noop, off: _noop, emit: _noop };
  let socket;
  try {
    socket = (typeof io === 'function') ? io(cfg.chatServerUrl, {
      transports: ["websocket", "polling"],
      upgrade: true,
      withCredentials: false,
      reconnection: true,
      reconnectionDelay: 1000,
      reconnectionDelayMax: 5000,
      reconnectionAttempts: 10,
      timeout: 10000,
      autoConnect: false,
    }) : { on: _noop, once: _noop, off: _noop, emit: _noop, connect: _noop, disconnect: _noop, connected: false, io: _noopEE };
  } catch(e) {
    socket = { on: _noop, once: _noop, off: _noop, emit: _noop, connect: _noop, disconnect: _noop, connected: false, io: _noopEE };
  }

  if (!elList || !elMessages || !elForm || !elInput) {
    return;
  }

  // Clear widget state when clicking navigation links inside the widget (settings, alerts, avatar)
  document.querySelectorAll('.pg-chat-nav-link').forEach(function(link) {
    link.addEventListener('click', function() {
      clearWidgetState();
    });
  });

  const apiBase = (cfg.threadsApiUrl || '').replace(/\?.*$/, '') || '/chat/threads_api.php';

  function buildApiUrl(action, extraParams) {
    const url = new URL(apiBase, window.location.origin);
    url.searchParams.set('action', action);
    if (extraParams && typeof extraParams === 'object') {
      Object.keys(extraParams).forEach(function (k) {
        if (extraParams[k] !== undefined && extraParams[k] !== null && extraParams[k] !== '') {
          url.searchParams.set(k, String(extraParams[k]));
        }
      });
    }
    return url.toString();
  }

  function apiFetchJson(action, payload) {
    var bodyParams = new URLSearchParams();
    bodyParams.append('action', action);
    Object.keys(payload || {}).forEach(function (k) {
      if (payload[k] !== undefined && payload[k] !== null) {
        bodyParams.append(k, String(payload[k]));
      }
    });
    return fetch(apiBase, {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
      body: bodyParams.toString()
    }).then(function (r) {
      return r.text().then(function (txt) {
        var parsed = null;
        try { parsed = txt ? JSON.parse(txt) : {}; } catch (e) { parsed = null; }
        if (r.ok) {
          return parsed || {};
        }
        var error = new Error((parsed && parsed.error) ? parsed.error : ('http_' + r.status));
        error.status = r.status;
        error.payload = parsed;
        error.body = txt;
        throw error;
      });
    });
  }

  function normalizeMemberType(memberType) {
    var key = String(memberType || '').trim().toLowerCase();
    if (!key) return '';
    if (key === 't') return 'teacher';
    if (key === 's') return 'student';
    if (key === 'p') return 'parent';
    if (key === 'u') return 'user';
    if (key === 'teachers') return 'teacher';
    if (key === 'students') return 'student';
    if (key === 'parents') return 'parent';
    if (key === 'users') return 'user';
    return key;
  }

  function setServerConnected(connected) {
    state.serverConnected = !!connected;
  }

  function connectSocketIfNeeded() {
    if (state.serverConnected) return;
    if (socket && !socket.connected) {
      try {
        socket.connect();
      } catch (e) {
      }
    }
  }

  function runSocketDiagnostics(error) {
    var baseUrl = String(cfg.chatServerUrl || '').replace(/\/$/, '');
    if (!baseUrl) return;
    var pollingUrl = baseUrl + '/socket.io/?EIO=4&transport=polling&t=' + Date.now();

    console.groupCollapsed('Socket diagnostics');
    console.log('chatServerUrl:', cfg.chatServerUrl);
    console.log('pollingProbeUrl:', pollingUrl);
    if (error) {
      console.log('connect_error:', {
        message: error && error.message,
        description: error && error.description,
        context: error && error.context,
        type: error && error.type
      });
    }

    fetch(pollingUrl, {
      method: 'GET',
      mode: 'cors',
      credentials: 'omit',
      cache: 'no-store'
    }).then(function (response) {
      return response.text().then(function (body) {
        console.log('pollingProbeStatus:', response.status);
        console.log('pollingProbeBody:', String(body || '').slice(0, 250));
        console.groupEnd();
      });
    }).catch(function (probeErr) {
      console.error('pollingProbeFailed:', probeErr);
      console.groupEnd();
    });
  }

  function setStatus(text) {
    if (elStatus) elStatus.textContent = text || "";
  }

  function initChatHeaderTooltips() {
    if (!elAlertSettingsBtn) return;
    if (typeof bootstrap === 'undefined' || !bootstrap || typeof bootstrap.Tooltip !== 'function') return;
    try {
      var existing = bootstrap.Tooltip.getInstance(elAlertSettingsBtn);
      if (existing) {
        existing.dispose();
      }
      new bootstrap.Tooltip(elAlertSettingsBtn);
    } catch (e) {
    }
  }

  function notifyUser(message, type) {
    var msg = String(message || '').trim();
    if (!msg) return;
    var toastType = String(type || 'error').toLowerCase();
    if (typeof showToast === 'function') {
      showToast(msg, toastType, 3500, 3500);
      return;
    }
    if (typeof window !== 'undefined' && typeof window.showToast === 'function') {
      window.showToast(msg, toastType, 3500, 3500);
      return;
    }
    setStatus(msg);
    console.warn('showToast is not available:', msg);
  }

  function installAlertToToastBridge() {
    if (typeof window === 'undefined') return;
    if (window.__pgChatAlertBridgeInstalled) return;

    var originalAlert = (typeof window.alert === 'function') ? window.alert.bind(window) : null;
    window.__pgChatAlertBridgeInstalled = true;

    window.alert = function (message) {
      var msg = String(message || '').trim();
      if (!msg) return;

      if (typeof showToast === 'function' || (typeof window !== 'undefined' && typeof window.showToast === 'function')) {
        notifyUser(msg, 'error');
        return;
      }

      if (originalAlert) {
        originalAlert(msg);
      }
    };
  }

  installAlertToToastBridge();
  initChatHeaderTooltips();

  function setComposerVisible(visible) {
    var composer = elForm ? elForm.closest('.card-footer') : null;
    if (!composer) return;
    composer.style.display = visible ? '' : 'none';
  }

  function initWidgetMultiSelects(container) {
    var root = container || document;
    if (!root || typeof root.querySelectorAll !== 'function') return;

    var multiSelects = root.querySelectorAll('select[multiple]');
    if (!multiSelects || !multiSelects.length) return;

    multiSelects.forEach(function (sel) {
      if (!sel.classList.contains('dselect')) {
        sel.classList.add('dselect');
      }

      if (sel.dataset.dselectBound === '1') {
        return;
      }

      if (typeof dselect === 'function') {
        try {
          dselect(sel, {
            search: true,
            clearable: true
          });
          sel.dataset.dselectBound = '1';
        } catch (e) {
        }
      } else if (typeof dselectInit === 'function') {
        try {
          dselectInit();
          sel.dataset.dselectBound = '1';
        } catch (e) {
        }
      }
    });
  }

  function canCreateGroups() {
    return !!(cfg && cfg.permissions && cfg.permissions.canCreateGroup);
  }

  function roleLabel(type) {
    var t = String(type || '').toLowerCase();
    if (t === 'teacher') return _pgTc('מורה');
    if (t === 'student') return _pgTc('תלמיד');
    if (t === 'parent') return _pgTc('הורה');
    if (t === 'user') return _pgTc('צוות');
    return t;
  }

  function getInitials(name) {
    var raw = String(name || '').trim();
    if (!raw) return '?';
    // Use Array.from to handle multi-byte Unicode characters (Hebrew, emoji, etc.)
    var chars = Array.from(raw);
    var first = chars[0] || '?';
    // Skip non-letter characters (emoji, symbols, punctuation)
    for (var i = 0; i < chars.length; i++) {
      if (/[\p{L}]/u.test(chars[i])) { first = chars[i]; break; }
    }
    return first.toUpperCase();
  }

  function buildMemberAvatarHtml(member) {
    var memberName = (member && member.name) ? member.name : _pgTc('משתמש #{id}', { id: (member && member.id ? member.id : '') });
    var memberAvatar = (member && member.avatar) ? String(member.avatar).trim() : '';
    var fallback = '<span class="avatar-initials rounded-circle bg-primary text-white" style="font-size: 0.75rem;">' + escapeHtml(getInitials(memberName)) + '</span>';
    if (memberAvatar) {
      return '<img src="/assets/compiled/jpg/' + escapeHtml(memberAvatar) + '" alt="' + escapeHtml(memberName) + '" class="rounded-circle" onerror="_avatarImgError(this)">';
    }
    return fallback;
  }

  function ensureGroupMembersPanel() {
    if (!elMessages) return null;
    if (elGroupMembersPanel && elGroupMembersPanel.isConnected) return elGroupMembersPanel;
    elGroupMembersPanel = null;
    elGroupMembersCount = null;
    elGroupMembersList = null;

    elMessages.style.position = 'relative';

    var panel = document.createElement('div');
    panel.className = 'pg-chat__members-panel';
    panel.innerHTML = '' +
      '<div class="pg-chat__members-panel-header">' +
      '<div>' +
      '<h6 class="mb-0">' + _pgTc('משתתפי הקבוצה') + '</h6>' +
      '<small class="text-muted" id="pgChatMembersCount">' + _pgTn('{n} משתתפים', '{n} משתתפים', 0) + '</small>' +
      '</div>' +
      '<div class="d-flex align-items-center gap-2">' +
      '<button type="button" class="btn btn-sm btn-outline-secondary min-w-auto d-none" id="pgChatMembersRename" title="' + _pgTc('שינוי שם הקבוצה') + '"><i class="bi bi-pencil-fill"></i></button>' +
      '<button type="button" class="btn btn-sm btn-outline-primary min-w-auto d-none" id="pgChatMembersAdd">' + _pgTc('הוסף משתתפים') + '</button>' +
      '<button type="button" class="btn btn-sm btn-link text-muted p-0 min-w-auto" id="pgChatMembersClose" aria-label="' + _pgTc('סגור') + '">' +
      '<i class="bi bi-x-lg"></i>' +
      '</button>' +
      '</div>' +
      '</div>' +
      '<div class="px-3 pt-2" id="pgChatMembersCanMsg"></div>' +
      '<div class="pg-chat__members-list" id="pgChatMembersList"></div>';

    elMessages.appendChild(panel);

    elGroupMembersPanel = panel;
    elGroupMembersCount = panel.querySelector('#pgChatMembersCount');
    elGroupMembersList = panel.querySelector('#pgChatMembersList');

    var closeBtn = panel.querySelector('#pgChatMembersClose');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        hideGroupMembersPanel();
      });
    }

    return panel;
  }

  function hideGroupMembersPanel() {
    if (elGroupMembersPanel) {
      elGroupMembersPanel.classList.remove('open');
    }
  }

  var SCHED_DAY_NAMES = [_pgTc('ראשון', null, 'weekday'), _pgTc('שני', null, 'weekday'), _pgTc('שלישי', null, 'weekday'), _pgTc('רביעי', null, 'weekday'), _pgTc('חמישי', null, 'weekday'), _pgTc('שישי', null, 'weekday'), _pgTc('שבת', null, 'weekday')];

  function schedRangeRow(start, end) {
    return '<div class="pg-chat__sched-range d-flex align-items-center gap-1 mt-1">' +
      '<input type="text" class="form-control form-control-sm pg-sched-start timepicker" placeholder="--:--" value="' + escapeHtml(start || '') + '">' +
      '<span class="small text-muted">–</span>' +
      '<input type="text" class="form-control form-control-sm pg-sched-end timepicker" placeholder="--:--" value="' + escapeHtml(end || '') + '">' +
      '<button type="button" class="btn btn-sm btn-link text-danger p-0 min-w-auto pg-sched-remove" aria-label="' + _pgTc('הסר') + '"><i class="bi bi-x-lg"></i></button>' +
      '</div>';
  }

  // Attach the shared flatpickr timepicker to any un-initialised .timepicker
  // inputs in a container (flatpickr is loaded globally via inc/header.php).
  function initSchedTimepickers(container) {
    if (!container || typeof flatpickr !== 'function') return;
    container.querySelectorAll('.timepicker:not(.flatpickr-input)').forEach(function (el) {
      flatpickr(el, { enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, locale: 'he', disableMobile: true });
    });
  }

  // Manager-only editor: per-day blocked-send windows. Appends to the given box.
  function renderGroupScheduleEditor(box) {
    var schedule = Array.isArray(state.activeThreadSchedule) ? state.activeThreadSchedule : [];
    var byDay = {};
    schedule.forEach(function (w) { (byDay[w.day] = byDay[w.day] || []).push(w); });

    var html = '<button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-2" id="pgSchedToggle">' +
      '<i class="bi bi-clock me-1"></i>' + _pgTc('שעות חסומות לשליחה') + '</button>' +
      '<div class="pg-chat__sched d-none" id="pgSchedEditor">' +
      '<div class="small text-muted mt-2 mb-1">' + _pgTc('בשעות המסומנות רק מנהל הקבוצה יוכל לשלוח הודעות.') + '</div>';
    for (var d = 0; d < 7; d++) {
      var ranges = byDay[d] || [];
      html += '<div class="pg-chat__sched-day" data-day="' + d + '">' +
        '<div class="d-flex justify-content-between align-items-center">' +
        '<span class="small fw-bold">' + SCHED_DAY_NAMES[d] + '</span>' +
        '<button type="button" class="btn btn-sm btn-link p-0 min-w-auto pg-sched-add" data-day="' + d + '" aria-label="' + _pgTc('הוסף טווח') + '"><i class="bi bi-plus-circle"></i></button>' +
        '</div>' +
        '<div class="pg-chat__sched-ranges" data-day="' + d + '">' +
        ranges.map(function (r) { return schedRangeRow(r.start, r.end); }).join('') +
        '</div></div>';
    }
    html += '<button type="button" class="btn btn-sm btn-success w-100 mt-2" id="pgSchedSave">' + _pgTc('שמירת שעות') + '</button>' +
      '<div class="small text-danger mt-1 d-none" id="pgSchedErr"></div>' +
      '</div>';
    box.insertAdjacentHTML('beforeend', html);

    var toggle = box.querySelector('#pgSchedToggle');
    var editor = box.querySelector('#pgSchedEditor');
    if (toggle && editor) {
      toggle.addEventListener('click', function () {
        editor.classList.toggle('d-none');
        if (!editor.classList.contains('d-none')) initSchedTimepickers(editor);
      });
    }
    if (editor) {
      editor.addEventListener('click', function (ev) {
        var addBtn = ev.target.closest ? ev.target.closest('.pg-sched-add') : null;
        if (addBtn) {
          var day = addBtn.getAttribute('data-day');
          var list = editor.querySelector('.pg-chat__sched-ranges[data-day="' + day + '"]');
          if (list) { list.insertAdjacentHTML('beforeend', schedRangeRow('', '')); initSchedTimepickers(list); }
          return;
        }
        var rmBtn = ev.target.closest ? ev.target.closest('.pg-sched-remove') : null;
        if (rmBtn) {
          var row = rmBtn.closest('.pg-chat__sched-range');
          if (row) row.remove();
        }
      });
    }
    var saveBtn = box.querySelector('#pgSchedSave');
    var errBox = box.querySelector('#pgSchedErr');
    if (saveBtn && editor) {
      saveBtn.addEventListener('click', function () {
        var windows = [];
        var valid = true;
        editor.querySelectorAll('.pg-chat__sched-day').forEach(function (dayEl) {
          var day = parseInt(dayEl.getAttribute('data-day'), 10);
          dayEl.querySelectorAll('.pg-chat__sched-range').forEach(function (r) {
            var start = (r.querySelector('.pg-sched-start') || {}).value || '';
            var end = (r.querySelector('.pg-sched-end') || {}).value || '';
            if (!start && !end) return;
            if (!start || !end || start >= end) { valid = false; return; }
            windows.push({ day: day, start: start, end: end });
          });
        });
        if (errBox) { errBox.classList.add('d-none'); errBox.textContent = ''; }
        if (!valid) {
          if (errBox) { errBox.textContent = _pgTc('יש להזין טווח שעות תקין (התחלה לפני סיום).'); errBox.classList.remove('d-none'); }
          return;
        }
        saveBtn.disabled = true;
        apiFetchJson('set_group_schedule', { threadId: state.activeThreadId, schedule: JSON.stringify(windows) }).then(function (data) {
          saveBtn.disabled = false;
          if (data && data.ok) {
            state.activeThreadSchedule = Array.isArray(data.schedule) ? data.schedule : [];
            notifyUser(_pgTc('השעות נשמרו'), 'success');
            if (elGroupMembersPanel && elGroupMembersPanel.classList.contains('open')) renderGroupMembersPanel();
          } else if (errBox) {
            errBox.textContent = _pgTc('שמירת השעות נכשלה'); errBox.classList.remove('d-none');
          }
        }).catch(function (e) {
          saveBtn.disabled = false;
          var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('שגיאה בשמירת השעות');
          if (errBox) { errBox.textContent = msg; errBox.classList.remove('d-none'); }
        });
      });
    }
  }

  function renderGroupMembersPanel() {
    if (!elGroupMembersCount || !elGroupMembersList) return;

    var addBtn = elGroupMembersPanel ? elGroupMembersPanel.querySelector('#pgChatMembersAdd') : null;
    if (addBtn) {
      addBtn.classList.toggle('d-none', !state.activeThreadCanManageMembers);
      if (state.activeThreadCanManageMembers) {
        addBtn.onclick = function () {
          hideGroupMembersPanel();
          openAddMembersView();
        };
      } else {
        addBtn.onclick = null;
      }
    }

    var renameBtn = elGroupMembersPanel ? elGroupMembersPanel.querySelector('#pgChatMembersRename') : null;
    if (renameBtn) {
      renameBtn.classList.toggle('d-none', !state.activeThreadCanManageMembers);
      if (state.activeThreadCanManageMembers) {
        renameBtn.onclick = function () {
          var activeThread = state.threads.find(function (t) { return String(t.id) === String(state.activeThreadId); });
          var currentName = (activeThread && activeThread.title) ? activeThread.title : '';
          var panelHeader = elGroupMembersPanel.querySelector('.pg-chat__members-panel-header');
          if (!panelHeader) return;
          var existingForm = panelHeader.querySelector('.pg-chat__rename-form');
          if (existingForm) { existingForm.remove(); return; }
          var form = document.createElement('div');
          form.className = 'pg-chat__rename-form d-flex gap-1 mt-2';
          form.innerHTML = '<input type="text" class="form-control form-control-sm" maxlength="100" value="' + escapeHtml(currentName) + '">' +
            '<button type="button" class="btn btn-sm btn-primary min-w-auto">' + _pgTc('שמור') + '</button>';
          panelHeader.appendChild(form);
          var input = form.querySelector('input');
          var saveBtn = form.querySelector('button');
          input.focus();
          input.select();
          saveBtn.addEventListener('click', function () {
            var newName = input.value.trim();
            if (!newName || newName === currentName) { form.remove(); return; }
            saveBtn.disabled = true;
            apiFetchJson('rename_group', { threadId: state.activeThreadId, name: newName }).then(function (data) {
              form.remove();
              if (data && data.ok) {
                if (activeThread) activeThread.title = data.name;
                if (elTitle) elTitle.textContent = data.name;
                renderList();
              }
            }).catch(function (e) {
              saveBtn.disabled = false;
              var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('שגיאה בשינוי שם הקבוצה');
              notifyUser(msg, 'error');
            });
          });
          input.addEventListener('keydown', function (ev) {
            if (ev.key === 'Enter') { ev.preventDefault(); saveBtn.click(); }
            if (ev.key === 'Escape') { form.remove(); }
          });
        };
      } else {
        renameBtn.onclick = null;
      }
    }

    var canMsgBox = elGroupMembersPanel ? elGroupMembersPanel.querySelector('#pgChatMembersCanMsg') : null;
    if (canMsgBox) {
      var canMsgMode = state.activeThreadCanMessageMode || 'all';
      if (state.activeThreadCanManageMembers) {
        canMsgBox.innerHTML = '<div class="form-check form-switch d-flex align-items-center justify-content-between ps-0 mb-0">' +
          '<label class="form-check-label small mb-0" for="pgChatMembersCanMsgSwitch">' + _pgTc('רק מנהל הקבוצה יכול לכתוב') + '</label>' +
          '<input class="form-check-input ms-0 mt-0" type="checkbox" role="switch" id="pgChatMembersCanMsgSwitch"' + (canMsgMode === 'teacher_only' ? ' checked' : '') + '>' +
          '</div>';
        var canMsgSwitch = canMsgBox.querySelector('#pgChatMembersCanMsgSwitch');
        if (canMsgSwitch) {
          canMsgSwitch.addEventListener('change', function () {
            var newMode = canMsgSwitch.checked ? 'teacher_only' : 'all';
            canMsgSwitch.disabled = true;
            apiFetchJson('set_group_can_message', { threadId: state.activeThreadId, can_message: newMode }).then(function (data) {
              canMsgSwitch.disabled = false;
              if (data && data.ok) {
                state.activeThreadCanMessageMode = data.can_message || newMode;
              } else {
                canMsgSwitch.checked = (state.activeThreadCanMessageMode === 'teacher_only');
              }
            }).catch(function (e) {
              canMsgSwitch.disabled = false;
              canMsgSwitch.checked = (state.activeThreadCanMessageMode === 'teacher_only');
              var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('שגיאה בעדכון ההגדרה');
              notifyUser(msg, 'error');
            });
          });
        }
        renderGroupScheduleEditor(canMsgBox);
      } else {
        var noteHtml = '';
        if (canMsgMode === 'teacher_only') {
          noteHtml += '<div class="small text-muted"><i class="bi bi-lock-fill me-1"></i>' + _pgTc('רק מנהל הקבוצה יכול לכתוב בקבוצה זו') + '</div>';
        }
        if (Array.isArray(state.activeThreadSchedule) && state.activeThreadSchedule.length) {
          noteHtml += '<div class="small text-muted"><i class="bi bi-clock me-1"></i>' + _pgTc('שליחת הודעות חסומה בשעות מסוימות') + '</div>';
        }
        canMsgBox.innerHTML = noteHtml;
      }
    }

    var members = Array.isArray(state.activeGroupMembers) ? state.activeGroupMembers : [];
    elGroupMembersCount.textContent = _pgTn('{n} משתתפים', '{n} משתתפים', state.activeGroupMemberCount || 0);

    // The list is the managers' — they add and remove people; the server sends it to no one else.
    if (!state.activeThreadCanManageMembers) {
      elGroupMembersList.innerHTML = '';
      return;
    }

    if (members.length === 0) {
      elGroupMembersList.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('לא נמצאו משתתפים בקבוצה') + '</div>';
      return;
    }

    var rows = members.map(function (member) {
      var memberName = member && member.name ? member.name : _pgTc('משתמש #{id}', { id: (member && member.id ? member.id : '') });
      var memberRole = roleLabel(member && member.type ? member.type : '');
      var isOwnerMember = !!(member && member.is_owner);
      var isAdminMember = !!(member && member.is_admin);
      // A clear admin marker: crown for the owner, star for a promoted admin.
      var adminBadge = isOwnerMember
        ? '<span class="pg-chat__members-admin-badge" title="' + _pgTc('מנהל הקבוצה') + '"><i class="bi bi-star-fill"></i> ' + _pgTc('מנהל', null, 'group') + '</span>'
        : (isAdminMember ? '<span class="pg-chat__members-admin-badge" title="' + _pgTc('מנהל', null, 'group') + '"><i class="bi bi-star-fill"></i> ' + _pgTc('מנהל', null, 'group') + '</span>' : '');
      var actionsBtns = '';
      if (state.activeThreadCanManageMembers) {
        // Only the owner may promote/demote admins; the owner itself can't be changed.
        if (state.activeThreadIsOwner && !isOwnerMember) {
          actionsBtns += '<button type="button" class="btn btn-sm btn-link p-0 min-w-auto pg-chat__members-role-toggle" ' +
            'data-member-type="' + escapeHtml(member.type) + '" data-member-id="' + escapeHtml(String(member.id)) + '" ' +
            'data-next-role="' + (isAdminMember ? 'member' : 'admin') + '" ' +
            'title="' + (isAdminMember ? _pgTc('הסרת ניהול') : _pgTc('מינוי כמנהל')) + '"><i class="bi ' + (isAdminMember ? 'bi-star' : 'bi-star-fill') + '"></i></button>';
        }
        if (!isOwnerMember) {
          actionsBtns += '<button type="button" class="btn btn-sm btn-link text-danger p-0 min-w-auto pg-chat__members-remove" ' +
            'data-member-type="' + escapeHtml(member.type) + '" data-member-id="' + escapeHtml(String(member.id)) + '" ' +
            'title="' + _pgTc('הסר מהקבוצה') + '"><i class="bi bi-person-dash"></i></button>';
        }
      }
      var actionsWrap = actionsBtns ? '<div class="d-flex align-items-center gap-2 ms-auto">' + actionsBtns + '</div>' : '';
      return '' +
        '<div class="pg-chat__members-item">' +
        '<div class="avatar avatar-sm pg-chat__members-avatar">' +
        buildMemberAvatarHtml(member) +
        '</div>' +
        '<div class="pg-chat__members-meta">' +
        '<div class="pg-chat__members-name">' + escapeHtml(memberName) + (adminBadge ? ' ' + adminBadge : '') + '</div>' +
        '<div class="pg-chat__members-role">' + escapeHtml(memberRole) + '</div>' +
        ((member && member.type === 'parent' && member.children) ? '<div class="pg-chat__members-children small text-muted text-truncate">' + escapeHtml(member.children) + '</div>' : '') +
        '</div>' +
        actionsWrap +
        '</div>';
    });

    // Re-rendering keeps the list where it was scrolled — after "טען עוד" the new rows sit below.
    var listScrollTop = elGroupMembersList.scrollTop;
    elGroupMembersList.innerHTML = rows.join('') +
      (state.activeGroupMembersHasMore
        ? '<div class="p-2"><button type="button" class="btn btn-sm btn-outline-primary w-100" id="pgChatMembersMore">' + _pgTc('טען עוד') + '</button></div>'
        : '');
    elGroupMembersList.scrollTop = listScrollTop;

    var moreBtn = elGroupMembersList.querySelector('#pgChatMembersMore');
    if (moreBtn) {
      moreBtn.addEventListener('click', function () {
        var threadId = state.activeThreadId;
        moreBtn.disabled = true;
        moreBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + _pgTc('טוען...');
        // The offset is what is on screen: a member removed meanwhile left the server's list too.
        apiFetchJson('group_members', { threadId: threadId, offset: state.activeGroupMembers.length }).then(function (data) {
          if (state.activeThreadId !== threadId) return;
          var page = (data && Array.isArray(data.members)) ? data.members : [];
          state.activeGroupMembers = state.activeGroupMembers.concat(page);
          state.activeGroupMembersHasMore = !!(data && data.has_more);
          renderGroupMembersPanel();
        }).catch(function () {
          moreBtn.disabled = false;
          moreBtn.textContent = _pgTc('טען עוד');
          notifyUser(_pgTc('שגיאה בטעינה'), 'error');
        });
      });
    }

    if (state.activeThreadCanManageMembers) {
      elGroupMembersList.querySelectorAll('.pg-chat__members-remove').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mType = btn.dataset.memberType;
          var mId   = parseInt(btn.dataset.memberId, 10);
          if (!mType || !mId) return;
          btn.disabled = true;
          apiFetchJson('remove_group_member', { threadId: state.activeThreadId, memberType: mType, memberId: mId })
            .then(function (data) {
              if (!data || !data.ok) { btn.disabled = false; return; }
              state.activeGroupMembers = state.activeGroupMembers.filter(function (m) {
                return !(m.type === mType && m.id === mId);
              });
              state.activeGroupMemberCount = Math.max(0, (state.activeGroupMemberCount || 0) - 1);
              renderGroupMembersPanel();
              if (state.serverConnected) socket.emit('threads:list');
              fetchThreadsFromPHP(true);
            })
            .catch(function () { btn.disabled = false; });
        });
      });

      elGroupMembersList.querySelectorAll('.pg-chat__members-role-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mType = btn.dataset.memberType;
          var mId = parseInt(btn.dataset.memberId, 10);
          var nextRole = btn.dataset.nextRole === 'admin' ? 'admin' : 'member';
          if (!mType || !mId) return;
          btn.disabled = true;
          apiFetchJson('set_member_role', { threadId: state.activeThreadId, memberType: mType, memberId: mId, role: nextRole })
            .then(function (data) {
              btn.disabled = false;
              if (!data || !data.ok) return;
              state.activeGroupMembers = state.activeGroupMembers.map(function (m) {
                if (m.type === mType && m.id === mId) {
                  return Object.assign({}, m, { is_admin: nextRole === 'admin' });
                }
                return m;
              });
              renderGroupMembersPanel();
            })
            .catch(function (e) {
              btn.disabled = false;
              var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('לא ניתן לעדכן את ההרשאה');
              notifyUser(msg, 'error');
            });
        });
      });
    }
  }

  function showGroupMembersPanel() {
    var panel = ensureGroupMembersPanel();
    if (!panel) return;

    renderGroupMembersPanel();
    panel.classList.add('open');
    if (elMessages) elMessages.scrollTop = 0;
  }

  function toggleGroupMembersPanel() {
    var panel = ensureGroupMembersPanel();
    if (!panel) return;

    if (panel.classList.contains('open')) {
      hideGroupMembersPanel();
    } else {
      showGroupMembersPanel();
    }
  }

  function getGroupMembersLabel() {
    var count = state.activeGroupMemberCount || 0;
    return _pgTn('קבוצה - {n} משתתף', 'קבוצה - {n} משתתפים', count);
  }

  function getGroupSubtitleLabel() {
    return getGroupMembersLabel();
  }

  function isSystemAlertsThread(thread) {
    if (!thread || !thread.is_group) return false;
    var threadTitle = String(thread.title || '').trim();
    return threadTitle === 'התראות מערכת';
  }

  function isBroadcastThread(thread) {
    return !!(thread && thread.is_broadcast);
  }

  // The system's own thread names ("התראות מערכת", and each person's "הודעות בית הספר") speak the viewer's language
  function isSystemNamedThread(thread) {
    return isSystemAlertsThread(thread) || (isBroadcastThread(thread) && String(thread.title || '').trim() === 'הודעות בית הספר');
  }

  function getGroupAvatarBadgeHtml(thread) {
    var isSystemThread = isSystemAlertsThread(thread);
    var isBroadcast = isBroadcastThread(thread);
    var bgClass = isSystemThread ? 'bg-primary' : (isBroadcast ? 'bg-info' : 'bg-success');
    var iconClass = isSystemThread ? 'bi-bell-fill' : (isBroadcast ? 'bi-megaphone-fill' : 'bi-people-fill');
    return '<span class="avatar-initials rounded-circle ' + bgClass + ' text-white" style="font-size: 0.8rem;"><i class="bi ' + iconClass + '"></i></span>';
  }

  function updateActiveGroupSubtitle() {
    if (!elSubtitle || !state.activeThreadId) return;
    var active = state.threads.find(function (t) { return t.id === state.activeThreadId; });
    if (!active || !active.is_group) return;
    elSubtitle.textContent = getGroupSubtitleLabel();
  }

  function setThreadMutedInState(threadId, isMuted) {
    var muted = !!isMuted;
    state.threads.forEach(function (threadItem) {
      if (String(threadItem.id) === String(threadId)) {
        threadItem.is_muted = muted;
      }
    });
    if (String(state.activeThreadId || '') === String(threadId)) {
      state.activeThreadMuted = muted;
      updateActiveGroupSubtitle();
      renderHeaderThreadActions();
    }
  }

  function ensureHeaderActionsHost() {
    if (elHeaderActions) return elHeaderActions;
    var host = document.getElementById('pgChatMainHeaderActions');
    if (host) return host;
    if (!elMain) return null;
    var headerRow = elMain.querySelector('.card-header .d-flex.justify-content-between.align-items-center');
    if (!headerRow) return null;
    host = headerRow.querySelector('.pg-chat__header-actions');
    if (!host) {
      host = document.createElement('div');
      host.className = 'd-flex align-items-center gap-1 pg-chat__header-actions';
      headerRow.appendChild(host);
    }
    return host;
  }

  function ensureHeaderMuteButton() {
    if (elHeaderMuteBtn && elHeaderMuteBtn.isConnected) return elHeaderMuteBtn;
    var host = ensureHeaderActionsHost();
    if (!host) return null;

    var btn = host.querySelector('.pg-chat__header-mute-btn');
    if (!btn) {
      btn = document.createElement('a');
      btn.className = 'btn btn-icon btn-ghost btn-sm rounded-circle pg-chat__header-mute-btn';
      btn.setAttribute('role', 'button');
      btn.setAttribute('href', 'javascript:;');
      btn.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        var activeThread = state.threads.find(function (t) { return String(t.id) === String(state.activeThreadId); });
        if (!activeThread || !activeThread.is_group) return;
        toggleGroupThreadMute(activeThread);
      });
      var closeMain = host.querySelector('#pgChatCloseMain');
      if (closeMain) {
        host.insertBefore(btn, closeMain);
      } else {
        host.appendChild(btn);
      }
    }

    elHeaderMuteBtn = btn;
    return elHeaderMuteBtn;
  }

  // Per-group settings gear in the active-conversation header — opens the same
  // members/settings panel as clicking the group subtitle.
  var elHeaderSettingsBtn = null;
  function ensureHeaderSettingsButton() {
    if (elHeaderSettingsBtn && elHeaderSettingsBtn.isConnected) return elHeaderSettingsBtn;
    var host = ensureHeaderActionsHost();
    if (!host) return null;
    var btn = host.querySelector('.pg-chat__header-settings-btn');
    if (!btn) {
      btn = document.createElement('a');
      btn.className = 'btn btn-icon btn-ghost btn-sm rounded-circle pg-chat__header-settings-btn';
      btn.setAttribute('role', 'button');
      btn.setAttribute('href', 'javascript:;');
      btn.innerHTML = '<i class="bi bi-gear text-muted"></i>';
      btn.addEventListener('click', function (ev) {
        ev.preventDefault();
        ev.stopPropagation();
        var activeThread = state.threads.find(function (t) { return String(t.id) === String(state.activeThreadId); });
        if (!activeThread || !activeThread.is_group) return;
        toggleGroupMembersPanel();
      });
      var muteBtn = host.querySelector('.pg-chat__header-mute-btn');
      if (muteBtn) host.insertBefore(btn, muteBtn);
      else {
        var closeMain = host.querySelector('#pgChatCloseMain');
        if (closeMain) host.insertBefore(btn, closeMain); else host.appendChild(btn);
      }
    }
    elHeaderSettingsBtn = btn;
    return elHeaderSettingsBtn;
  }

  // (Re)attach a Bootstrap tooltip to an element, replacing any prior instance.
  function initBsTooltip(el, title) {
    if (!el || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
    try {
      var inst = bootstrap.Tooltip.getInstance(el);
      if (inst) inst.dispose();
      el.setAttribute('data-bs-toggle', 'tooltip');
      el.setAttribute('title', title);
      new bootstrap.Tooltip(el);
    } catch (e) { /* tooltip is a nicety — ignore failures */ }
  }

  function renderHeaderThreadActions() {
    var btn = ensureHeaderMuteButton();
    var settingsBtn = ensureHeaderSettingsButton();
    if (!btn) return;

    var activeThread = state.threads.find(function (t) { return String(t.id) === String(state.activeThreadId); });
    var showGroupActions = !!(activeThread && activeThread.is_group && !state.supportOpen && !isSystemAlertsThread(activeThread));
    if (!showGroupActions) {
      btn.classList.add('d-none');
      if (settingsBtn) settingsBtn.classList.add('d-none');
      return;
    }

    if (settingsBtn) {
      settingsBtn.classList.remove('d-none');
      settingsBtn.setAttribute('aria-label', _pgTc('הגדרות הקבוצה'));
      initBsTooltip(settingsBtn, _pgTc('הגדרות הקבוצה'));
    }

    var isMuted = !!activeThread.is_muted;
    var muteLabel = isMuted ? _pgTc('בטל השתקת התראות') : _pgTc('השתק התראות');
    btn.classList.remove('d-none');
    btn.setAttribute('aria-label', muteLabel);
    initBsTooltip(btn, muteLabel);
    btn.innerHTML = '<i class="bi ' + (isMuted ? 'bi-bell-slash-fill text-warning' : 'bi-bell-fill text-muted') + '"></i>';
  }

  function toggleGroupThreadMute(thread) {
    if (!thread || !thread.id || !thread.is_group) return;
    var nextMuted = !thread.is_muted;
    setStatus(nextMuted ? _pgTc('משתיק התראות לקבוצה...') : _pgTc('מבטל השתקה לקבוצה...'));

    apiFetchJson('thread_notifications', {
      threadId: thread.id,
      muted: nextMuted ? 1 : 0
    }).then(function (data) {
      setStatus('');
      var isMuted = !!(data && data.is_muted);
      setThreadMutedInState(thread.id, isMuted);
      renderList();

      if (state.serverConnected) {
        socket.emit('threads:list');
      } else {
        fetchThreadsFromPHP(false);
      }
    }).catch(function (e) {
      setStatus('');
      var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('לא ניתן לעדכן את מצב ההתראות לקבוצה');
      notifyUser(msg, 'error');
    });
  }

  function setGroupTitleAction(isGroup) {
    if (!elSubtitle) return;
    if (isGroup) {
      elSubtitle.style.cursor = 'pointer';
      elSubtitle.style.textDecoration = 'underline';
      elSubtitle.title = _pgTc('לחץ לצפייה במשתתפי הקבוצה');
      elSubtitle.onclick = toggleGroupMembersPanel;
    } else {
      elSubtitle.style.cursor = '';
      elSubtitle.style.textDecoration = '';
      elSubtitle.title = '';
      elSubtitle.onclick = null;
      state.activeGroupMembers = [];
      state.activeGroupMemberCount = 0;
      state.activeGroupMembersHasMore = false;
      state.activeThreadMuted = false;
      state.activeThreadCanManageMembers = false;
      state.activeThreadIsOwner = false;
      state.activeThreadCanMessageMode = 'all';
      hideGroupMembersPanel();
    }
  }

  function collectGroupAddCandidates(existingMembers) {
    var existingMap = new Map();
    (existingMembers || []).forEach(function (member) {
      var type = normalizeMemberType(member && member.type ? member.type : '');
      var id = parseInt(member && member.id ? member.id : 0, 10);
      if (!type || !id) return;
      existingMap.set(type + ':' + id, true);
    });

    var candidates = [];
    var map = [
      { key: 'teachers', type: 'teacher', label: _pgTc('מורה') },
      { key: 'parents', type: 'parent', label: _pgTc('הורה') },
      { key: 'students', type: 'student', label: _pgTc('תלמיד') },
      { key: 'users', type: 'user', label: _pgTc('צוות') }
    ];

    map.forEach(function (entry) {
      var list = (cfg.contacts && Array.isArray(cfg.contacts[entry.key])) ? cfg.contacts[entry.key] : [];
      list.forEach(function (person) {
        var personId = parseInt(person.id, 10);
        if (!personId) return;
        var key = entry.type + ':' + personId;
        if (existingMap.has(key)) return;
        if (entry.type === cfg.current.type && personId === parseInt(cfg.current.id, 10)) return;
        candidates.push({
          value: key,
          name: String(person.name || _pgTc('משתמש #{id}', { id: personId })),
          label: entry.label,
          classId: person.class_id || '',
          children: person.children || ''
        });
      });
    });

    candidates.sort(function (a, b) {
      return a.name.localeCompare(b.name, 'he');
    });

    return candidates;
  }

  // Inline "student - class" suffix for a candidate <option> (parents show
  // their children; students show their own class).
  function candidateExtraLabel(c) {
    if (c.classId) return ' · ' + _pgTc('כיתה {class}', { class: c.classId });
    if (c.children) return ' — ' + c.children;
    return '';
  }

  function openAddMembersView(existingMembers) {
    var threadId = state.activeThreadId;
    if (!threadId || !state.activeThreadCanManageMembers) return;

    // The panel loads the list in pages; the picker must still hide everyone already in the group,
    // so it asks for all of them first — as "type:id", without names.
    if (!existingMembers && state.activeGroupMembersHasMore) {
      apiFetchJson('group_members', { threadId: threadId, keys_only: 1 }).then(function (data) {
        if (state.activeThreadId !== threadId) return;
        var keys = (data && Array.isArray(data.keys)) ? data.keys : [];
        openAddMembersView(keys.map(function (key) {
          var sep = String(key).indexOf(':');
          return { type: String(key).slice(0, sep), id: String(key).slice(sep + 1) };
        }));
      }).catch(function () {
        openAddMembersView(state.activeGroupMembers);
      });
      return;
    }

    var title = (elTitle && elTitle.textContent) ? String(elTitle.textContent) : _pgTc('קבוצה');
    setStatus('');
    showMain();
    setComposerVisible(false);

    if (elTitle) elTitle.textContent = _pgTc('הוספת משתתפים');
    if (elSubtitle) elSubtitle.textContent = title;

    var candidates = collectGroupAddCandidates(existingMembers || state.activeGroupMembers);
    var addIconSpacingClass = (cfg && cfg.current && cfg.current.type === 'user') ? 'ms-1' : 'me-1';
    var optionsHtml = candidates.map(function (c) {
      return '<option value="' + escapeHtml(c.value) + '">' + escapeHtml(c.name + ' (' + c.label + ')' + candidateExtraLabel(c)) + '</option>';
    }).join('');

    if (elMessages) {
      elMessages.innerHTML = '' +
        '<div class="p-2">' +
        '<div class="mb-2">' +
        '<label class="form-label small fw-bold mb-1">' + _pgTc('בחר משתתפים להוספה') + '</label>' +
        '<div class="w-100">' +
        '<select id="pgAddMembersSelect" class="form-select form-select-sm dselect w-100 dselect-w-100" multiple style="height: 220px;">' +
        '<option value="" disabled>' + _pgTc('בחר משתתפים') + '</option>' +
        optionsHtml +
        '</select>' +
        '</div>' +
        '<div class="form-text">' + _pgTc('יוצגו רק משתמשים שעדיין לא חברים בקבוצה.') + '</div>' +
        '</div>' +
        '<div class="d-flex gap-2">' +
        '<button type="button" class="btn btn-primary btn-sm" id="pgAddMembersSubmit"><i class="bi bi-person-plus ' + addIconSpacingClass + '"></i>' + _pgTc('הוסף לקבוצה') + '</button>' +
        '<button type="button" class="btn btn-outline-secondary btn-sm" id="pgAddMembersCancel">' + _pgTc('ביטול') + '</button>' +
        '</div>' +
        '<div class="small text-muted mt-2" id="pgAddMembersError"></div>' +
        '</div>';

      initWidgetMultiSelects(elMessages);
      var memberKeys = new Set((existingMembers || state.activeGroupMembers || []).map(function (m) {
        return normalizeMemberType(m && m.type ? m.type : '') + ':' + parseInt(m && m.id ? m.id : 0, 10);
      }));
      addServerSearchToPicker(document.getElementById('pgAddMembersSelect'), function (value) {
        return memberKeys.has(value) || isCurrentViewer(value);
      });
    }

    var submitBtn = document.getElementById('pgAddMembersSubmit');
    var cancelBtn = document.getElementById('pgAddMembersCancel');
    var errBox = document.getElementById('pgAddMembersError');

    if (cancelBtn) {
      cancelBtn.addEventListener('click', function () {
        setComposerVisible(true);
        openThread(threadId, title || _pgTc('קבוצה'));
      });
    }

    if (submitBtn) {
      submitBtn.addEventListener('click', function () {
        var selectEl = document.getElementById('pgAddMembersSelect');
        var selectedMembers = selectEl
          ? Array.from(selectEl.selectedOptions)
            .map(function (o) { return o.value; })
            .filter(function (v) { return !!String(v || '').trim(); })
          : [];

        if (errBox) errBox.textContent = '';

        if (!selectedMembers.length) {
          if (errBox) errBox.textContent = _pgTc('יש לבחור לפחות משתתף אחד');
          return;
        }

        submitBtn.disabled = true;
        apiFetchJson('add_group_members', {
          threadId: threadId,
          members: selectedMembers.join(',')
        }).then(function (data) {
          submitBtn.disabled = false;
          if (!data || !data.ok) {
            if (errBox) errBox.textContent = _pgTc('לא ניתן להוסיף משתתפים כרגע');
            return;
          }

          setComposerVisible(true);
          if (state.serverConnected) {
            socket.emit('threads:list');
          }
          fetchThreadsFromPHP(true);
          openThread(threadId, title || _pgTc('קבוצה'));
        }).catch(function (e) {
          submitBtn.disabled = false;
          var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('אירעה שגיאה בהוספת המשתתפים');
          if (errBox) errBox.textContent = msg;
        });
      });
    }
  }

  function toggleWidget(forceState) {
    state.isOpen = typeof forceState === "boolean" ? forceState : !state.isOpen;
    if (elWidget) {
      if (state.isOpen) {
        if (!cfg.standaloneSupport) {
          connectSocketIfNeeded();
        }
        if (!state.initialDbBootstrapDone) {
          state.initialDbBootstrapDone = true;
          if (!cfg.standaloneSupport) {
            fetchThreadsFromPHP(true);
          }
        }
        elWidget.classList.add("open");
        if (cfg.standaloneSupport && !state.supportOpen) {
          openSupportWidget();
        }
        state.unreadCount = 0;
        cfg.initialUnread = 0;
        state.supportUnseen = 0;
        if (window.pgSupportNotice) window.pgSupportNotice.hide();
        updateBadge();
      } else {
        if (state.activeThreadId && socket) socket.emit('thread:close');
        elWidget.classList.remove("open");
        elWidget.style.height = '';
        elWidget.style.top = '';
        elWidget.style.bottom = '';
      }
    }
    saveWidgetState();
    syncMobilePageScrollLock();
  }

  function syncMobilePageScrollLock() {
    var isMobile = (typeof window !== 'undefined') && window.matchMedia && window.matchMedia('(max-width: 950px)').matches;
    var shouldLock = !!(state.isOpen && isMobile);
    if (document && document.documentElement) {
      document.documentElement.classList.toggle('pg-chat-mobile-lock', shouldLock);
    }
    if (document && document.body) {
      document.body.classList.toggle('pg-chat-mobile-lock', shouldLock);
    }
  }

  function updateBadge() {
    if (!elBadge) return;
    // Before the threads load (they load when the chat first opens) the count is the one the page came with.
    const threadsUnread = state.threadsLoaded || state.threads.length
      ? state.threads.reduce((sum, t) => sum + (isSystemAlertsThread(t) ? 0 : (t.unread_count || 0)), 0)
      : (Number(cfg.initialUnread) || 0);
    // …and the support team's answers waiting while the chat is closed (support_notice.js).
    const totalUnread = threadsUnread + (state.supportUnseen || 0);

    if (totalUnread > 0 && !state.isOpen) {
      elBadge.textContent = totalUnread > 99 ? "99+" : totalUnread;
      elBadge.classList.add("visible");
    } else {
      elBadge.classList.remove("visible");
    }

    // The chat's menu item counts the chat's own conversations only, as before.
    const rubricBadge = document.getElementById('pgChatRubricBadge');
    const rubricUnread = state.threads.reduce((sum, t) => sum + (isSystemAlertsThread(t) ? 0 : (t.unread_count || 0)), 0);
    if (rubricBadge) {
      if (rubricUnread > 0) {
        rubricBadge.textContent = rubricUnread > 99 ? '99+' : rubricUnread;
        rubricBadge.classList.remove('d-none');
      } else {
        rubricBadge.classList.add('d-none');
      }
    }
  }

  // Desktop "maximized" mode keeps BOTH panes visible via CSS !important
  // overrides, so the d-none/d-flex pane toggles are visual no-ops there.
  // Anything that tears down the open conversation (nulling activeThreadId)
  // would leave the main pane on screen but dead — the composer/upload guards
  // refuse to act without an active thread. Detect that mode so the
  // "return to list" paths can keep the conversation alive.
  function isMaximized() {
    return !!(elWidget && elWidget.classList.contains("pg-chat-maximized") &&
      typeof window !== "undefined" && window.matchMedia &&
      window.matchMedia("(min-width: 951px)").matches);
  }

  function showSidebar() {
    cancelEditMessage();
    var maximized = isMaximized();
    if (!maximized && state.activeThreadId && socket) socket.emit('thread:close');
    removeOfflineNotice();
    if (elSidebar) { elSidebar.classList.remove("d-none"); elSidebar.classList.add("d-flex"); }
    if (elMain) { elMain.classList.add("d-none"); elMain.classList.remove("d-flex"); }
    if (!maximized) {
      state.activeThreadId = null;
      state.supportOpen = false;
      state.aiChatBotType = null;
      setComposerVisible(true);
    }
    if (state.tabBeforeThread) {
      switchTab(state.tabBeforeThread);
      state.tabBeforeThread = null;
    } else {
      renderList();
    }
    saveWidgetState();
  }

  function showMain() {
    if (elSidebar) { elSidebar.classList.add("d-none"); elSidebar.classList.remove("d-flex"); }
    if (elMain) { elMain.classList.remove("d-none"); elMain.classList.add("d-flex"); }
  }

  function decodeMsg(str) {
    try { return decodeURIComponent(String(str ?? "")); } catch (e) { return String(str ?? ""); }
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = String(str ?? "");
    // innerHTML escapes &, < and > only; the result also goes into attribute values (alt="…",
    // data-lightbox-name="…" carry the uploader's file name), so quotes are escaped too.
    return div.innerHTML.replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  // Dates in the viewer's language — Latin digits and a 24-hour clock, as the Hebrew shows them.
  function chatDateLocale() {
    const locale = (typeof window.pgLocale === 'function') ? window.pgLocale() : 'he';
    if (locale === 'ar') return 'ar-u-nu-latn-hc-h23';
    // Without an English branch an English list printed its short dates with Hebrew month names.
    return locale === 'en' ? 'en-GB-u-hc-h23' : 'he-IL';
  }

  function formatDateTime(iso) {
    try {
      const d = new Date(iso);
      const now = new Date();
      const isToday = d.toDateString() === now.toDateString();

      if (isToday) {
        return d.toLocaleTimeString(chatDateLocale(), { hour: "2-digit", minute: "2-digit" });
      }

      return d.toLocaleDateString(chatDateLocale(), {
        month: "short",
        day: "numeric",
      });
    } catch {
      return "";
    }
  }

  // A message bubble's time: today the hour alone, an earlier day its date and hour (another year adds the year).
  // The thread list and "last seen" keep formatDateTime — no room for the hour there.
  function formatMessageTime(iso) {
    try {
      const d = new Date(iso);
      const now = new Date();
      if (d.toDateString() === now.toDateString()) {
        return d.toLocaleTimeString(chatDateLocale(), { hour: "2-digit", minute: "2-digit" });
      }
      const opts = { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" };
      if (d.getFullYear() !== now.getFullYear()) opts.year = "numeric";
      return d.toLocaleString(chatDateLocale(), opts);
    } catch {
      return "";
    }
  }

  function switchTab(tab) {
    state.tab = tab;

    // Update active tab button
    document.querySelectorAll("[data-tab]").forEach((btn) => {
      if (btn.getAttribute("data-tab") === tab) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });

    renderList();
    saveWidgetState();
  }

  function isOnline(type, id) {
    var normalizedType = normalizeMemberType(type) || String(type || '').trim().toLowerCase();
    var normalizedId = String(id == null ? '' : id).trim();
    if (!normalizedType || !normalizedId) return false;
    return state.onlineUsers.has(`${normalizedType}:${normalizedId}`) || state.onlineUsers.has(`${String(type || '').trim().toLowerCase()}:${normalizedId}`);
  }

  function getOnlineStatusClass(type, id) {
    if (!isOnline(type, id)) return '';
    return getOnlineSource(type, id) === 'presence' ? 'avatar-insystem' : 'avatar-online';
  }

  function getOnlineSource(type, id) {
    var normalizedType = normalizeMemberType(type) || String(type || '').trim().toLowerCase();
    var normalizedId = String(id == null ? '' : id).trim();
    if (!normalizedType || !normalizedId) return null;
    var key = `${normalizedType}:${normalizedId}`;
    var u = state.onlineUsers.get(key);
    if (!u) u = state.onlineUsers.get(`${String(type || '').trim().toLowerCase()}:${normalizedId}`);
    return u ? (u.source || 'socket') : null;
  }

  function getThreadOtherMember(thread) {
    if (!thread || thread.is_group) return null;
    var rawType = thread.other_type || thread.otherType || thread.member_type || thread.memberType || null;
    var rawId = thread.other_id || thread.otherId || thread.member_id || thread.memberId || null;
    var normalizedType = normalizeMemberType(rawType) || String(rawType || '').trim().toLowerCase();
    if (!normalizedType || rawId == null || rawId === '') return null;
    return { type: normalizedType, id: String(rawId) };
  }

  // A parent's children beside the parent's name in the conversation list and header — a teacher with
  // hundreds of parents could not tell who wrote (413732, 09/10). Teachers and staff only, as in the
  // parents tab. The contact list stops at 800 parents; the rest come from loadParentChildren().
  function parentChildrenLabel(thread) {
    if (cfg.current.type !== 'teacher' && cfg.current.type !== 'user') return '';
    var other = getThreadOtherMember(thread);
    if (!other || other.type !== 'parent') return '';
    if (state.parentChildren.has(other.id)) return state.parentChildren.get(other.id);
    var parents = (cfg.contacts && Array.isArray(cfg.contacts.parents)) ? cfg.contacts.parents : [];
    var c = parents.find(function (x) { return String(x.id) === other.id; });
    return (c && c.children) ? String(c.children) : '';
  }

  // <bdi>: a Latin-named child beside a Hebrew name otherwise scatters the brackets across the line.
  function setThreadTitle(title, thread) {
    if (!elTitle) return;
    var children = thread ? parentChildrenLabel(thread) : '';
    elTitle.textContent = title;
    if (children) {
      var bdi = document.createElement('bdi');
      bdi.textContent = '(' + children + ')';
      elTitle.appendChild(document.createTextNode(' '));
      elTitle.appendChild(bdi);
    }
  }

  var parentChildrenRequested = new Set();
  function loadParentChildren() {
    if (cfg.current.type !== 'teacher' && cfg.current.type !== 'user') return;
    var parents = (cfg.contacts && Array.isArray(cfg.contacts.parents)) ? cfg.contacts.parents : [];
    var inContacts = new Set(parents.map(function (c) { return String(c.id); }));
    var ids = [];
    state.threads.forEach(function (t) {
      var other = getThreadOtherMember(t);
      if (other && other.type === 'parent' && !inContacts.has(other.id) && !parentChildrenRequested.has(other.id)) ids.push(other.id);
    });
    ids = ids.slice(0, 200);
    if (!ids.length) return;
    ids.forEach(function (id) { parentChildrenRequested.add(id); });
    apiFetchJson('parent_children', { parentIds: ids.join(',') })
      .then(function (data) {
        var map = (data && data.children) || {};
        var keys = Object.keys(map);
        if (!keys.length) return;
        keys.forEach(function (id) { state.parentChildren.set(String(id), String(map[id])); });
        if (!state.supportOpen) renderList();
        var active = state.activeThreadId ? state.threads.find(function (t) { return t.id === state.activeThreadId; }) : null;
        if (active && !active.is_group && !state.supportOpen) setThreadTitle(resolveThreadDisplay(active).title, active);
      })
      .catch(function () {});
  }

  function getPresenceSubtitle(threadLike, isUserOnline) {
    if (isUserOnline) {
      var other = getThreadOtherMember(threadLike);
      return _pgTc("מחובר");
    }
    // Check lastSeenAt map first (tracked from online:users events)
    var other = getThreadOtherMember(threadLike);
    if (other) {
      var key = (normalizeMemberType(other.type) || other.type) + ':' + other.id;
      var lastSeenDate = state.lastSeenAt.get(key);
      if (lastSeenDate) {
        var formatted = formatDateTime(lastSeenDate);
        if (formatted) return _pgTc("נראה לאחרונה {time}", { time: formatted });
      }
    }
    // Fallback to server-provided last_seen field
    var lastSeenRaw = (threadLike && (threadLike.last_seen || threadLike.lastSeen)) || null;
    if (lastSeenRaw) {
      var formatted = formatDateTime(lastSeenRaw);
      if (formatted) return _pgTc("נראה לאחרונה {time}", { time: formatted });
    }
    return _pgTc("לא מחובר");
  }

  function openSupportWidget() {
    // Regular panel (teacher/parent/student): open AI chat first
    if (cfg.current.type !== 'user') {
      state.supportOpen = true;
      state.activeThreadId = null;
      setGroupTitleAction(false);
      setStatus('');
      showMain();
      setComposerVisible(false);
      if (elTitle) elTitle.textContent = _pgTc('תמיכה טכנית');
      if (elSubtitle) elSubtitle.textContent = _pgTc('פגישונים');
      if (elActiveAvatar) {
        elActiveAvatar.classList.remove('d-none');
        elActiveAvatar.className = 'avatar avatar-sm ms-2';
        elActiveAvatar.innerHTML = '<img src="/M/assets/images/logo_p.png" alt="' + _pgTc('תמיכה טכנית') + '" class="rounded-circle">';
      }
      renderHeaderThreadActions();
      renderList();
      loadSupportAIChat('users');
      saveWidgetState();
      return;
    }

    // Admin panel: show support options screen
    state.supportOpen = true;
    state.activeThreadId = null;
    setGroupTitleAction(false);
    setStatus('');
    showMain();
    setComposerVisible(false);

    if (elTitle) elTitle.textContent = _pgTc('תמיכה טכנית');
    if (elSubtitle) elSubtitle.textContent = _pgTc('פגישונים');

    if (elActiveAvatar) {
      elActiveAvatar.classList.remove('d-none');
      elActiveAvatar.className = 'avatar avatar-sm ms-2';
      elActiveAvatar.innerHTML = '<img src="/M/assets/images/logo_p.png" alt="' + _pgTc('תמיכה טכנית') + '" class="rounded-circle">';
    }

    if (elMessages) {
      elMessages.innerHTML = '';

      var container = document.createElement('div');
      container.className = 'd-flex flex-column align-items-center justify-content-center h-100 px-3';
      container.style.direction = 'rtl';
      container.innerHTML =
        '<div style="max-width:340px;width:100%;text-align:center;">' +
          '<div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#4231bc,#2d1f8f);display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">' +
            '<i class="bi bi-headset" style="font-size:1.6rem;color:#fff;"></i>' +
          '</div>' +
          '<h5 style="font-weight:700;color:var(--pg-chat-text, #1a1a2e);margin-bottom:6px;">' + _pgTc('איך נוכל לעזור?') + '</h5>' +
          '<p style="font-size:0.85rem;color:var(--pg-chat-text-muted, #64748b);line-height:1.6;margin-bottom:24px;">' +
            (cfg.isAdminPanel
              ? _pgTc('במרכז ההדרכה שלנו תוכלו למצוא סרטוני הדרכה מפורטים עבור כל הפעולות במערכת. מומלץ לחפש שם תשובה לפני פנייה לצוות התמיכה.')
              : _pgTc('צוות התמיכה שלנו כאן לעזור לכם בכל שאלה על המערכת.')) +
          '</p>' +
          '<div class="pg-support-option" id="pgSupportTraining" style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:12px;border:2px solid var(--pg-chat-border, #e2e8f0);background:var(--bs-body-bg, #fff);cursor:pointer;transition:all .2s ease;margin-bottom:10px;">' +
            '<div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#6366f1,#4f46e5);display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
              '<i class="bi bi-play-circle" style="font-size:1.2rem;color:#fff;"></i>' +
            '</div>' +
            '<div style="text-align:start;flex:1;">' +
              '<div style="font-weight:600;font-size:0.92rem;color:var(--pg-chat-text, #1e293b);">' + _pgTc('מרכז ההדרכה') + '</div>' +
              '<div style="font-size:0.78rem;color:var(--pg-chat-text-muted, #94a3b8);">' + _pgTc('סרטוני הדרכה, מדריכים ועוד') + '</div>' +
            '</div>' +
            '<i class="bi bi-arrow-left" style="font-size:1rem;color:var(--pg-chat-text-muted, #94a3b8);flex-shrink:0;"></i>' +
          '</div>' +
          '<div class="pg-support-option" id="pgSupportChat" style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:12px;border:2px solid var(--pg-chat-border, #e2e8f0);background:var(--bs-body-bg, #fff);cursor:pointer;transition:all .2s ease;">' +
            '<div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#14b8a6,#0d9488);display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
              '<i class="bi bi-chat-dots" style="font-size:1.2rem;color:#fff;"></i>' +
            '</div>' +
            '<div style="text-align:start;flex:1;">' +
              '<div style="font-weight:600;font-size:0.92rem;color:var(--pg-chat-text, #1e293b);">' + _pgTc('צ\'אט תמיכה') + '</div>' +
              '<div style="font-size:0.78rem;color:var(--pg-chat-text-muted, #94a3b8);">' + _pgTc('שוחחו עם צוות התמיכה שלנו') + '</div>' +
            '</div>' +
            '<i class="bi bi-arrow-left" style="font-size:1rem;color:var(--pg-chat-text-muted, #94a3b8);flex-shrink:0;"></i>' +
          '</div>' +
        '</div>';

      elMessages.appendChild(container);

      // Hide admin-only options in regular panel
      if (!cfg.isAdminPanel) {
        var trainingOpt = container.querySelector('#pgSupportTraining');
        if (trainingOpt) trainingOpt.style.display = 'none';
      }

      // Hover effects
      container.querySelectorAll('.pg-support-option').forEach(function (el) {
        el.addEventListener('mouseenter', function () {
          el.style.borderColor = '#4231bc';
          el.style.boxShadow = '0 2px 12px rgba(66,49,188,0.1)';
          el.style.transform = 'translateY(-1px)';
        });
        el.addEventListener('mouseleave', function () {
          el.style.borderColor = '#e2e8f0';
          el.style.boxShadow = 'none';
          el.style.transform = 'translateY(0)';
        });
      });

      // Open help center in fullscreen modal and close chat widget
      container.querySelector('#pgSupportTraining').addEventListener('click', function () {
        // Our own training centre (M/help/index.php), not an outside help site in an
        // iframe - its own docblock says so -
        // and it carries the full admin chrome, so it is a navigation, not an iframe.
        toggleWidget(false);
        window.location.href = '/M/help/';
      });

      // Open AI chat
      container.querySelector('#pgSupportChat').addEventListener('click', function () {
        loadSupportAIChat(cfg.isAdminPanel ? 'admin' : 'users');
      });
    }

    state.aiChatBotType = null;
    renderHeaderThreadActions();
    renderList();
    saveWidgetState();
  }

  // `prefill` writes a question into the composer WITHOUT sending it: the admin search
  // palette hands over the words that found nothing, and the user still presses send.
  // See pgSupportAskAI() below and M/assets/js/global_search.js.
  function loadSupportAIChat(botType, prefill) {
    var apiUrl = cfg.aiChatApiUrl || '/M/chat/support/chat_api.php';
    state.aiChatBotType = botType;
    state.supportOpen = true;
    state.activeThreadId = null;
    state.isOpen = true;
    showMain();
    setComposerVisible(false);
    saveWidgetState();
    if (elTitle) elTitle.textContent = _pgTc('צ\'אט תמיכה');
    if (elSubtitle) elSubtitle.textContent = _pgTc('פגישונים');
    if (elActiveAvatar) {
      elActiveAvatar.classList.remove('d-none');
      elActiveAvatar.className = 'avatar avatar-sm ms-2';
      elActiveAvatar.innerHTML = '<img src="/M/assets/images/logo_p.png" alt="' + _pgTc('צ\'אט תמיכה') + '" class="rounded-circle">';
    }

    // Add new-conversation button to header
    var existingNewBtn = document.getElementById('pgAiChatNewBtn');
    if (!existingNewBtn) {
      var headerActions = ensureHeaderActionsHost();
      if (headerActions) {
        var newChatBtn = document.createElement('a');
        newChatBtn.id = 'pgAiChatNewBtn';
        newChatBtn.className = 'btn btn-icon btn-ghost btn-sm rounded-circle';
        newChatBtn.setAttribute('role', 'button');
        newChatBtn.setAttribute('href', 'javascript:;');
        newChatBtn.setAttribute('title', _pgTc('שיחה חדשה'));
        newChatBtn.innerHTML = '<i class="bi bi-plus-circle text-primary"></i>';
        newChatBtn.addEventListener('click', function() {
          fetch(apiUrl, {method:'POST', body: new URLSearchParams({action:'reset', bot_type: botType})})
          .then(function() { loadSupportAIChat(botType); });
        });
        var closeMainBtn = headerActions.querySelector('#pgChatCloseMain');
        if (closeMainBtn) {
          headerActions.insertBefore(newChatBtn, closeMainBtn);
        } else {
          headerActions.prepend(newChatBtn);
        }
      }
    }

    if (!elMessages) return;
    elMessages.innerHTML = '';
    elMessages.style.display = 'flex';
    elMessages.style.flexDirection = 'column';
    elMessages.style.overflow = 'hidden';
    elMessages.style.padding = '0';
    elMessages.style.direction = 'rtl';

    var messagesArea = document.createElement('div');
    messagesArea.className = 'pg-ai-chat-messages';

    var escalateWrap = document.createElement('div');
    escalateWrap.style.cssText = 'padding:0 0.5rem;display:none;';
    var escalateBtn = document.createElement('button');
    escalateBtn.className = 'pg-ai-chat-escalate-btn';
    escalateBtn.textContent = _pgTc('דבר עם נציג אנושי');
    // Hands the conversation to the support team's screen (startHandoff below) — the only way to a person.
    escalateBtn.addEventListener('click', function() { startHandoff(); });
    escalateWrap.appendChild(escalateBtn);

    // While the request is with the team, the person can take it back and go on with the bot (cancelHandoff; PG-309).
    const cancelWrap = document.createElement('div');
    cancelWrap.className = 'pg-ai-chat-cancel-wrap';
    cancelWrap.hidden = true;
    const cancelBtn = document.createElement('button');
    cancelBtn.type = 'button';
    cancelBtn.className = 'pg-ai-chat-escalate-btn';
    cancelBtn.textContent = _pgTc('ביטול ההעברה לנציג');
    cancelBtn.addEventListener('click', function() { cancelHandoff(); });
    cancelWrap.appendChild(cancelBtn);

    var inputWrap = document.createElement('div');
    inputWrap.className = 'pg-ai-chat-input-wrap';

    var input = document.createElement('input');
    input.type = 'text';
    input.placeholder = _pgTc('כתבו הודעה...');
    input.maxLength = 1000;

    var sendBtn = document.createElement('button');
    sendBtn.className = 'pg-ai-chat-send-btn';
    sendBtn.innerHTML = '<i class="bi bi-send"></i>';

    // A screenshot to the support team — only while a person handles the conversation (startHuman / stopHuman).
    const imageBtn = document.createElement('button');
    imageBtn.type = 'button';
    imageBtn.className = 'pg-ai-chat-image-btn';
    imageBtn.hidden = true;
    imageBtn.title = _pgTc('שליחת תמונה, למשל צילום מסך');
    imageBtn.setAttribute('aria-label', imageBtn.title);
    imageBtn.innerHTML = '<i class="bi bi-image"></i>';

    inputWrap.appendChild(input);
    inputWrap.appendChild(imageBtn);
    inputWrap.appendChild(sendBtn);

    elMessages.appendChild(messagesArea);
    elMessages.appendChild(escalateWrap);
    elMessages.appendChild(cancelWrap);
    elMessages.appendChild(inputWrap);

    var sending = false;
    var greeting = '';
    // A person from the support team on this conversation (chat_api.php handoff / human_poll,
    // inc/functions/support_inbox.php): the bot is quiet, their replies arrive by polling, and the person goes on
    // writing here as before. ready = the server hands over to the support screen.
    const human = { ready: false, push: false, active: false, lastAgentId: 0, label: _pgTc('נציג תמיכה'), timer: null, busy: false,
                    cancelling: false };

    function addBubble(text, type) {
      let div = document.createElement('div');
      div.className = 'pg-ai-chat-bubble pg-ai-chat-bubble-' + type;
      div.textContent = text;
      messagesArea.appendChild(div);
      messagesArea.scrollTop = messagesArea.scrollHeight;
      return div;
    }

    function addTyping() {
      let div = document.createElement('div');
      div.className = 'pg-ai-chat-bubble pg-ai-chat-bubble-ai';
      div.id = 'pgWidgetAiTyping';
      div.innerHTML = '<div class="pg-ai-chat-typing"><span></span><span></span><span></span></div>';
      messagesArea.appendChild(div);
      messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    function removeTyping() {
      var el = document.getElementById('pgWidgetAiTyping');
      if (el) el.remove();
    }

    // While an answer is being worked on, the typing bubble stays last and, after a while, says so. A task can take
    // minutes (Roi, 04/10: the dots went as soon as the server answered and an empty bubble stayed — "מנהל שזה קורה לו
    // יחשוב שיש באג או פשוט יסגור את הדף"). chat_api.php finishes and saves the answer even when the page is closed.
    function setTypingStatus(text) {
      const el = document.getElementById('pgWidgetAiTyping');
      if (!el) return;
      let status = el.querySelector('.pg-ai-chat-typing-status');
      if (!status) {
        status = document.createElement('div');
        status.className = 'pg-ai-chat-typing-status small text-secondary mt-1';
        el.appendChild(status);
      }
      status.textContent = text;
    }

    function keepTypingLast() {
      const el = document.getElementById('pgWidgetAiTyping');
      if (el && el !== messagesArea.lastElementChild) {
        messagesArea.appendChild(el);
        messagesArea.scrollTop = messagesArea.scrollHeight;
      }
    }

    function renderMd(raw) {
      return raw
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')   // a quote must not leave the link's href
        .replace(/(https?:\/\/(?:(?!&quot;)[^\s<])+)/g, '<br><a href="$1" target="_blank" rel="noopener">$1</a>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/^#{1,3}\s+(.+)$/gm, '<strong>$1</strong>')
        .replace(/^---+$/gm, '')
        .replace(/\n/g, '<br>');
    }

    function processNavigateLinks(bubble) {
      if (bubble.dataset.processed) return;
      bubble.dataset.processed = '1';
      var rawText = bubble.textContent;
      // Strip [ESCALATE] tag and replace with a hint to use the button below
      var hasEscalate = rawText.indexOf('[ESCALATE]') !== -1;
      rawText = rawText.replace(/\[ESCALATE\]/g, '').trim();
      // History rows saved while interactive guides existed still end in [GUIDE:key].
      rawText = rawText.replace(/\[GUIDE:[a-z0-9_]+\]/g, '').trim();
      // Captured before the [CONFIDENCE:] strip below, whose second pattern runs to the end
      // of the text and would swallow a NAVIGATE tag the model put after the marker.
      // A page of this site only: "//host", "/\host" (and a tab between them, which the browser drops) are another site.
      var match = rawText.match(/\[NAVIGATE:(\/(?![\/\\])[^\]\\\s]+)\]/);
      // An internal self-report the model appends last. chat_api.php strips it on the way out,
      // but history rows saved before that fix still carry it — and the model closes it with
      // "}" or leaves it unterminated often enough that no "]"-anchored pattern catches it.
      rawText = rawText
        .replace(/\[CONFIDENCE:\d+\|[^\]]*\]/g, '')
        .replace(/\[CONFIDENCE:[\s\S]*$/, '')
        .trim();
      if (match) {
        var url = match[1];
        var clean = rawText.replace(/\[NAVIGATE:\/[^\]]+\]/g, '').trim();
        bubble.innerHTML = renderMd(clean);
        var btn = document.createElement('a');
        btn.href = url;
        btn.className = 'pg-ai-chat-navigate-btn';
        btn.innerHTML = _pgTc('עבור לעמוד') + ' <i class="bi bi-arrow-left-circle"></i>';
        bubble.appendChild(document.createElement('br'));
        bubble.appendChild(btn);
      } else {
        bubble.innerHTML = renderMd(rawText);
      }
      if (hasEscalate) {
        var hint = document.createElement('div');
        hint.style.cssText = 'font-size:0.8rem;color:#64748b;margin-top:6px;';
        hint.textContent = _pgTc('לחצו על "דבר עם נציג אנושי" למטה כדי לעבור לשיחה עם נציג.');
        bubble.appendChild(hint);
        escalateWrap.style.display = 'block';
      }
      messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    // ── A person from the support team ──────────────────────────────────────────
    // imageId: the reply is a picture (support_image.js), its words — maybe none — under it. label / avatar: who
    // answered and their drawn face (support_inbox.php sibAgentShown()).
    function addAgentBubble(text, label, imageId, avatar) {
      let div = document.createElement('div');
      div.className = 'pg-ai-chat-bubble pg-ai-chat-bubble-ai pg-ai-chat-bubble-agent';
      const who = document.createElement('span');
      who.className = 'pg-ai-chat-agent-label';
      const face = document.createElement('img');
      face.className = 'pg-ai-chat-agent-avatar';
      face.alt = '';
      face.src = avatar || '/chat/assets/agents/support.webp';
      who.appendChild(face);
      who.appendChild(document.createTextNode(label || human.label));
      let body = document.createElement('span');
      body.innerHTML = renderMd(String(text || ''));
      div.appendChild(who);
      div.appendChild(body);
      if (imageId) showImage(body, imageId, !text);
      messagesArea.appendChild(div);
      messagesArea.scrollTop = messagesArea.scrollHeight;
      return div;
    }

    // A picture of this conversation, into a bubble; alone = it came with no words, so a failed load says so.
    function showImage(where, id, alone) {
      if (!window.pgSupportImage) return;
      window.pgSupportImage.show(where, apiUrl, new URLSearchParams({ bot_type: botType }), id, _pgTc('תמונה'),
        alone ? _pgTc('התמונה לא זמינה כרגע.') : '', messagesArea);
    }

    // The person's screenshot to the team: drawn at once, sent, and taken back with the reason if it did not go.
    function sendImage() {
      if (!window.pgSupportImage || !human.active) return;
      window.pgSupportImage.choose().then(function (file) {
        if (!file) return;
        const why = window.pgSupportImage.problem(file);
        if (why) {
          addNote(why === 'size' ? _pgTc('התמונה גדולה מדי. אפשר עד 10MB.') : _pgTc('אפשר לשלוח רק תמונה: JPG, PNG או WEBP.'));
          return;
        }
        const bubble = addBubble('', 'user');
        bubble.classList.add('is-sending');
        const local = window.pgSupportImage.showFile(bubble, file, _pgTc('תמונה'));
        messagesArea.scrollTop = messagesArea.scrollHeight;
        imageBtn.disabled = true;
        window.pgSupportImage.send(apiUrl, new URLSearchParams({ bot_type: botType }), file)
          .then(function (data) {
            if (data && data.status === 'ok') {
              bubble.classList.remove('is-sending');
              return;
            }
            bubble.remove();
            URL.revokeObjectURL(local);
            addNote((data && data.message) || _pgTc('לא הצלחתי לשלוח את התמונה. נסו שוב.'));
          })
          .catch(function () {
            bubble.remove();
            URL.revokeObjectURL(local);
            addNote(_pgTc('לא הצלחתי לשלוח את התמונה. נסו שוב.'));
          })
          .finally(function () { imageBtn.disabled = false; });
      });
    }
    imageBtn.addEventListener('click', sendImage);

    function addNote(text) {
      if (!text) return;
      let div = document.createElement('div');
      div.className = 'pg-ai-chat-note';
      div.textContent = text;
      messagesArea.appendChild(div);
      messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    function pollHuman() {
      if (!messagesArea.isConnected) {
        // The chat was opened anew ("שיחה חדשה", another conversation) while a request is with the team: the page's
        // lighter watch takes over, so their answer still shows by the button (support_notice.js).
        const wasWithTeam = human.active;
        stopHuman();
        if (wasWithTeam) startSupportWatch();
        return;
      }
      if (human.busy || document.hidden) return;
      human.busy = true;
      // seen=1 only while the chat is open on the screen — a closed chat has not seen the answer (support_inbox.php).
      fetch(apiUrl + '?action=human_poll&bot_type=' + botType + '&after_id=' + human.lastAgentId + '&seen=' + (state.isOpen ? 1 : 0),
            { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        (Array.isArray(data.messages) ? data.messages : []).forEach(function (m) {
          if (Number(m.id) > human.lastAgentId) {
            human.lastAgentId = Number(m.id);
            addAgentBubble(m.content, m.agent, m.image ? m.id : 0, m.avatar);
            // The team answered and the chat is closed: a card by the button, a count on it — nothing opens by itself
            // (Amit, 14/10). A tap opens the chat here.
            if (!state.isOpen && window.pgSupportNotice) {
              state.supportUnseen += 1;
              window.pgSupportNotice.show({
                launcher: elToggle,
                name: m.agent || human.label,
                avatar: m.avatar,
                text: m.content || '📷',
                count: state.supportUnseen,
                messageId: Number(m.id),
                // Back on the support chat — the widget may have been left on the list of conversations.
                onOpen: function () {
                  if (!state.supportOpen) loadSupportAIChat(botType);
                  toggleWidget(true);
                },
                closeLabel: _pgTc('סגירה'),
                setCount: function (n) { state.supportUnseen = n; updateBadge(); }
              });
            }
          }
        });
        if (data.status === 'ok' && !data.human && human.active) {
          stopHuman();
          // left = "שיחה חדשה" in another tab: no closing note. cancelling = this tab is taking it back (cancelHandoff says
          // so); cancelled = they took it back in another tab or device (PG-309).
          if (!data.left && !human.cancelling) addNote(data.cancelled
            ? _pgTc('ביטלתם את ההעברה לנציג. אפשר להמשיך לשאול אותי כאן, ולבקש שוב נציג אם צריך.')
            : _pgTc('הנציג סיים את הפנייה. אפשר להמשיך לשאול אותי כאן, ולבקש שוב נציג אם צריך.'));
        }
      })
      .catch(function () {})   // offline for a moment — the next round asks again
      .finally(function () { human.busy = false; });
    }

    function onHumanVisible() {
      if (!document.hidden) pollHuman();
    }

    function startHuman() {
      human.active = true;
      escalateWrap.style.display = 'none';
      cancelWrap.hidden = false;
      imageBtn.hidden = !window.pgSupportImage;
      // This chat's own poll takes over from the page's lighter watch (support_notice.js).
      state.supportPolling = true;
      if (window.pgSupportNotice) window.pgSupportNotice.stopWatch();
      if (human.timer) return;
      human.timer = setInterval(pollHuman, 6000);
      document.addEventListener('visibilitychange', onHumanVisible);
    }

    function stopHuman() {
      human.active = false;
      state.supportPolling = false;
      imageBtn.hidden = true;
      cancelWrap.hidden = true;
      if (human.timer) {
        clearInterval(human.timer);
        human.timer = null;
      }
      document.removeEventListener('visibilitychange', onHumanVisible);
      // The closing note says a person can be asked for again — so the button is back.
      escalateBtn.disabled = false;
      escalateWrap.style.display = 'block';
    }

    // A school system admin is asked once where to hear that we answered, if they are not here by then
    // (Amit, 09/10). A parent is never asked — the app's push is how they hear.
    function showContactChoice(data) {
      if (!data.has_phone && !data.has_email) return;   // nothing to choose from: the answer waits here
      let box = document.createElement('div');
      box.className = 'pg-ai-chat-contact';
      let question = document.createElement('div');
      question.textContent = _pgTc('אם לא תהיו כאן כשנענה — איפה לעדכן אתכם?');
      box.appendChild(question);
      let actions = document.createElement('div');
      actions.className = 'pg-ai-chat-contact-actions';
      function choice(pref, text) {
        let btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pg-ai-chat-contact-btn';
        btn.textContent = text;
        btn.addEventListener('click', function () {
          actions.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
          fetch(apiUrl, { method: 'POST', credentials: 'same-origin',
                          body: new URLSearchParams({ action: 'contact_pref', bot_type: botType, pref: pref }) })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            box.remove();
            addNote(res && res.message ? res.message : '');
          })
          .catch(function () { actions.querySelectorAll('button').forEach(function (b) { b.disabled = false; }); });
        });
        actions.appendChild(btn);
      }
      if (data.has_phone) choice('whatsapp', _pgTc('בווצאפ') + (data.phone_hint ? ' ' + data.phone_hint : ''));
      if (data.has_email) choice('email', _pgTc('במייל') + (data.email_hint ? ' ' + data.email_hint : ''));
      box.appendChild(actions);
      messagesArea.appendChild(box);
      messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    // "להודיע לי במחשב" — on a computer only, while a person handles the conversation (chat/assets/support_push.js).
    // A browser that already allows notifications is kept without asking again. In the panel there is no question of
    // ours at all (Amit, 13/10: "אל תשאל אם להודיע במחשב, פשוט תודיע שם"): the browser's own permission question came
    // with the "דברו עם נציג" click ($permission, startHandoff), and a browser that allows it is kept.
    let pushOffered = false;
    function offerPush(key, permission) {
        if (!key || pushOffered || !window.pgSupportPush || !window.pgSupportPush.supported()) return;
        function save(endpoint) {
            return fetch(apiUrl, { method: 'POST', credentials: 'same-origin',
                body: new URLSearchParams({ action: 'web_push', bot_type: botType, endpoint: endpoint, open_path: window.location.pathname }) })
            .then(function(r) { return r.json(); });
        }
        if (botType === 'admin') {
            (permission || Promise.resolve(Notification.permission)).then(function(answer) {
                if (answer !== 'granted' || pushOffered) return;
                pushOffered = true;
                window.pgSupportPush.subscribe(key).then(function(sub) { if (sub) save(sub.endpoint); });
            }).catch(function() {});
            return;
        }
        pushOffered = true;
        if (window.pgSupportPush.granted()) {
            window.pgSupportPush.subscribe(key).then(function(sub) { if (sub) save(sub.endpoint); });
            return;
        }
        let box = document.createElement('div');
        box.className = 'pg-ai-chat-contact';
        const question = document.createElement('div');
        question.textContent = _pgTc('רוצים שנודיע לכם כאן במחשב כשנענה, גם אם תסגרו את האתר?');
        box.appendChild(question);
        const actions = document.createElement('div');
        actions.className = 'pg-ai-chat-contact-actions';
        let btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pg-ai-chat-contact-btn';
        btn.textContent = _pgTc('כן, להודיע לי במחשב');
        btn.addEventListener('click', function() {
            btn.disabled = true;
            window.pgSupportPush.enable(key, save).then(function(res) {
                box.remove();
                if (res && res.message) addNote(res.message);
            }).catch(function() { box.remove(); });
        });
        actions.appendChild(btn);
        box.appendChild(actions);
        messagesArea.appendChild(box);
        messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    function startHandoff() {
      // The support screen is the only way to a person (Roi, 15/10).
      if (!human.ready) { addNote(_pgTc('לא הצלחתי להעביר לנציג כרגע. נסו שוב בעוד רגע.')); return; }
      escalateBtn.disabled = true;
      // The panel asks the browser here, in the click — the only moment a browser lets a page ask (offerPush).
      const permission = botType === 'admin' && human.push && window.pgSupportPush && window.pgSupportPush.supported()
        ? window.pgSupportPush.ask() : null;
      fetch(apiUrl, { method: 'POST', credentials: 'same-origin',
                      body: new URLSearchParams({ action: 'handoff', bot_type: botType, current_page: window.location.pathname,
                                                  // the last error messages they saw (support_seen.js) — the team sees them at once
                                                  seen_errors: JSON.stringify(window.pgSupportSeen ? window.pgSupportSeen.recent() : []) }) })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        // A limit, a failure — told, not hidden.
        if (!data || data.status !== 'ok') {
          escalateBtn.disabled = false;
          addNote((data && data.message) || _pgTc('לא הצלחתי להעביר לנציג כרגע. נסו שוב בעוד רגע.'));
          return;
        }
        if (data.label) human.label = data.label;
        if (window.pgSupportSeen) window.pgSupportSeen.clear();   // sent with this request — never again with the next
        addNote(data.message || '');
        startHuman();
        if (data.ask_contact) showContactChoice(data);
        offerPush(data.push_key, permission);
      })
      .catch(function () {
        escalateBtn.disabled = false;
        addNote(_pgTc('לא הצלחתי להעביר לנציג כרגע. נסו שוב בעוד רגע.'));
      });
    }

    // "ביטול ההעברה לנציג" (PG-309; Roi: "התחרט או רק בדק את זה"): the request goes back, and the bot answers here again
    // (chat_api.php handoff_cancel). Nothing is sent to anyone.
    function cancelHandoff() {
      cancelBtn.disabled = true;
      human.cancelling = true;
      fetch(apiUrl, { method: 'POST', credentials: 'same-origin',
                      body: new URLSearchParams({ action: 'handoff_cancel', bot_type: botType }) })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || data.status !== 'ok') throw new Error('not cancelled');
        if (!data.cancelled) {
          // Nothing of this session was with the team any more (closed, or left with "שיחה חדשה" in another tab):
          // the poll says what happened, as it would have a moment later.
          human.cancelling = false;
          pollHuman();
          return;
        }
        stopHuman();
        // "איפה לעדכן אתכם?" and "להודיע לי במחשב" belonged to the request.
        messagesArea.querySelectorAll('.pg-ai-chat-contact').forEach(function (box) { box.remove(); });
        addNote(_pgTc('ביטלתם את ההעברה לנציג. אפשר להמשיך לשאול אותי כאן, ולבקש שוב נציג אם צריך.'));
      })
      .catch(function () {
        addNote(_pgTc('לא הצלחתי לבטל את ההעברה כרגע. נסו שוב בעוד רגע.'));
      })
      .finally(function () {
        cancelBtn.disabled = false;
        human.cancelling = false;
      });
    }

    function runDiagnostic(conversationId, originalMessage) {
      var diagBubble = addBubble('', 'ai');
      diagBubble.innerHTML = '<div class="pg-ai-chat-typing"><span></span><span></span><span></span></div>';
      messagesArea.scrollTop = messagesArea.scrollHeight;

      var fd = new URLSearchParams();
      fd.append('action', 'diagnose');
      fd.append('conversation_id', conversationId);
      fd.append('message', originalMessage);
      fd.append('bot_type', botType);

      fetch(apiUrl, {method: 'POST', body: fd})
      .then(function(res) {
        if (!res.ok) throw new Error('Network error');
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var dbuf = '';
        var diagDone = false;

        function finishDiag() {
          if (diagDone) return;
          diagDone = true;
          processNavigateLinks(diagBubble);
          sending = false;
        }

        function processDiagLines(text) {
          dbuf += text;
          var lines = dbuf.split('\n');
          dbuf = lines.pop();
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line.startsWith('event: escalate')) {
              escalateWrap.style.display = 'block';
              continue;
            }
            if (!line.startsWith('data: ')) continue;
            var jsonStr = line.substring(6);
            if (jsonStr === '[DONE]') { finishDiag(); continue; }
            try {
              var evt = JSON.parse(jsonStr);
              if (evt.text) {
                if (diagBubble.querySelector('.pg-ai-chat-typing')) {
                  diagBubble.innerHTML = '';
                  diagBubble.textContent = '';
                }
                diagBubble.textContent += evt.text;
                messagesArea.scrollTop = messagesArea.scrollHeight;
              }
              if (evt.error) {
                diagBubble.textContent = evt.error;
                sending = false;
              }
            } catch(e) {}
          }
        }

        function readDiag() {
          reader.read().then(function(result) {
            if (result.done) { processDiagLines('\n'); finishDiag(); return; }
            processDiagLines(decoder.decode(result.value, {stream: true}));
            readDiag();
          }).catch(function() { sending = false; });
        }
        readDiag();
      })
      .catch(function() {
        diagBubble.textContent = _pgTc('שגיאה באבחון. נסו שוב.');
        sending = false;
      });
    }

    // The line can drop while an answer is on its way — on a phone it does whenever the app goes to the background (Roi,
    // 04/10: "ברגע שאני יוצא רגע מהאפליקציה… שגיאה בחיבור", and after a reload the answer was there). The turn goes on on
    // the server (chat_api.php ignores a closed connection) and saves its answer, so the chat waits for it — asking the
    // server, as opening the chat does — and then draws the conversation again, as a reload would.
    function recoverAnswer(text, sentAt) {
      if (!document.getElementById('pgWidgetAiTyping')) addTyping();
      keepTypingLast();
      setTypingStatus(_pgTc('החיבור נקטע לרגע — אני ממשיך לעבוד על זה, והתשובה תופיע כאן.'));
      const sent = text.trim();
      const began = Date.now();
      let busy = false;
      let timer = null;
      function stop() {
        clearInterval(timer);
        document.removeEventListener('visibilitychange', check);
      }
      function giveUp(message) {
        stop();
        removeTyping();
        addBubble(message, 'ai');
        sending = false;
      }
      function check() {
        if (!messagesArea.isConnected) { stop(); return; }   // the chat was closed or opened anew
        if (busy || document.hidden) return;
        busy = true;
        fetch(apiUrl + '?action=greeting&bot_type=' + botType, { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          const history = Array.isArray(data.history) ? data.history : [];
          // This message — the last one with these words, sent now (a few minutes' room for the two clocks).
          let mine = -1;
          for (let i = history.length - 1; i >= 0; i--) {
            if (history[i].role === 'user' && String(history[i].content || '').trim() === sent && (Number(history[i].at) || 0) >= sentAt - 180) {
              mine = i;
              break;
            }
          }
          if (mine >= 0 && history.slice(mine + 1).some(function (m) { return m.role === 'assistant'; })) {
            stop();
            sending = false;
            loadSupportAIChat(botType);
          } else if (mine < 0 && Date.now() - began > 30000) {
            giveUp(_pgTc('ההודעה לא נשלחה. נסו שוב.'));
          } else if (Date.now() - began > 10 * 60 * 1000) {
            giveUp(_pgTc('לא הצלחתי לקבל את התשובה. רעננו את הדף כדי לראות אותה.'));
          }
        })
        .catch(function () {})   // still offline — the next round tries again
        .finally(function () { busy = false; });
      }
      document.addEventListener('visibilitychange', check);
      timer = setInterval(check, 4000);
      check();
    }

    function sendMessage() {
      var text = input.value.trim();
      if (!text || sending) return;
      sending = true;
      input.value = '';
      addBubble(text, 'user');
      // With a person from the team on it the bot does not answer, so no typing dots.
      if (!human.active) addTyping();
      const startedAt = Date.now();
      const sentAt = startedAt / 1000;
      // A stream that went quiet is cut: the server's heartbeat comes every 10 seconds (console_engine.php), and a phone
      // back from the background may hold a connection that will never answer again.
      const controller = typeof AbortController === 'function' ? new AbortController() : null;
      let lastByteAt = Date.now();
      const workTimer = setInterval(function () {
        const secs = (Date.now() - startedAt) / 1000;
        if (secs >= 60) {
          setTypingStatus(_pgTc('זו משימה ארוכה, אני עדיין עובד עליה. גם אם תסגרו את החלון, התשובה תחכה לכם כאן.'));
        } else if (secs >= 15) {
          setTypingStatus(_pgTc('עובד על זה…'));
        }
        if (controller && Date.now() - lastByteAt > 60000) controller.abort();
      }, 1000);
      function onBack() {
        if (!document.hidden && controller && Date.now() - lastByteAt > 20000) controller.abort();
      }
      document.addEventListener('visibilitychange', onBack);
      function stopTimers() {
        clearInterval(workTimer);
        document.removeEventListener('visibilitychange', onBack);
      }
      function stopWorking() {
        stopTimers();
        removeTyping();
      }

      var fd = new URLSearchParams();
      fd.append('action', 'send');
      fd.append('message', text);
      fd.append('bot_type', botType);
      fd.append('current_page', window.location.pathname);

      fetch(apiUrl, controller ? {method: 'POST', body: fd, signal: controller.signal} : {method: 'POST', body: fd})
      .then(function(res) {
        if (!res.ok) {
          const refused = new Error('http ' + res.status);
          refused.refused = true;   // the server answered and did not take the message
          throw refused;
        }
        lastByteAt = Date.now();
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        // Shown with its first word; until then the typing bubble after it is the answer.
        var aiBubble = addBubble('', 'ai');
        aiBubble.hidden = true;
        keepTypingLast();
        let answered = false;
        let sawDone = false;
        var buffer = '';
        var streamDone = false;

        function finishStream() {
          if (streamDone) return;
          streamDone = true;
          stopWorking();
          processNavigateLinks(aiBubble);
          if (!answered) {
            aiBubble.hidden = false;
            aiBubble.textContent = _pgTc('לא התקבלה תשובה. נסו לשלוח שוב.');
          }
          sending = false;
        }

        // Cut before the end ([DONE] is the server's last line): what came stays, and the rest is waited for.
        function cutOff() {
          if (streamDone) return;
          streamDone = true;
          stopTimers();
          aiBubble.hidden = !answered;
          recoverAnswer(text, sentAt);
        }

        function processLines(text) {
          buffer += text;
          var lines = buffer.split('\n');
          buffer = lines.pop();
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line.startsWith('event: escalate')) {
              escalateWrap.style.display = 'block';
              continue;
            }
            if (!line.startsWith('data: ')) continue;
            var jsonStr = line.substring(6);
            if (jsonStr === '[DONE]') { sawDone = true; finishStream(); continue; }
            try {
              var evt = JSON.parse(jsonStr);
              if (evt.human) {
                // The message went to the support team (chat_api.php 'send', human mode): nothing to draw now,
                // their reply comes through pollHuman().
                answered = true;
                if (!human.active) startHuman();
              }
              if (evt.action_proposal) {
                answered = true;
                // A write the model proposed: render the confirm/cancel card (action_cards.js).
                // The card, not a text bubble, is what carries the consent token to the POST.
                if (window.pgAppendActionCard) {
                  window.pgAppendActionCard(messagesArea, evt.action_proposal);
                } else {
                  // The helper failed to load — surface the summary as text so the proposal is
                  // never invisible; the user can still answer in the chat itself.
                  var fallbackCard = addBubble('', 'ai');
                  fallbackCard.textContent = _pgTc('בקשה לביצוע פעולה (ממתינה לאישור):') + '\n' + (evt.action_proposal.summary || '');
                }
                keepTypingLast();
              }
              if (evt.diagnose && evt.conversation_id) {
                processNavigateLinks(aiBubble);
                runDiagnostic(evt.conversation_id, text);
              }
              if (evt.new_bubble) {
                processNavigateLinks(aiBubble);
                aiBubble = addBubble('', 'ai');
                if (evt.typing) {
                  aiBubble.textContent = '...';
                  aiBubble.classList.add('pg-ai-typing');
                }
                keepTypingLast();
                messagesArea.scrollTop = messagesArea.scrollHeight;
              }
              if (evt.text) {
                answered = true;
                aiBubble.hidden = false;
                if (aiBubble.classList.contains('pg-ai-typing')) {
                  aiBubble.textContent = '';
                  aiBubble.classList.remove('pg-ai-typing');
                }
                aiBubble.textContent += evt.text;
                keepTypingLast();
                messagesArea.scrollTop = messagesArea.scrollHeight;
              }
              if (evt.error) {
                answered = true;
                aiBubble.hidden = false;
                aiBubble.textContent = evt.error;
                sending = false;
              }
            } catch(e) {}
          }
        }

        function read() {
          reader.read().then(function(result) {
            lastByteAt = Date.now();
            if (result.done) {
              processLines('\n');
              if (sawDone) finishStream(); else cutOff();
              return;
            }
            processLines(decoder.decode(result.value, {stream: true}));
            read();
          }).catch(cutOff);
        }
        read();
      })
      .catch(function(err) {
        if (err && err.refused) {
          stopWorking();
          addBubble(_pgTc('שגיאה בחיבור. נסו שוב.'), 'ai');
          sending = false;
          return;
        }
        // No answer at all — the request may still have reached the server.
        stopTimers();
        recoverAnswer(text, sentAt);
      });
    }

    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') sendMessage();
    });

    fetch(apiUrl + '?action=greeting&bot_type=' + botType)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.human) {
        human.ready = !!data.human.ready;
        human.push = !!data.human.push;
        human.lastAgentId = Number(data.human.last_agent_id) || 0;
        if (data.human.label) human.label = data.human.label;
      }
      // The team answers even when the bot is switched off — only the bot is unavailable then.
      if (!data.enabled && !(data.human && data.human.active)) {
        addBubble(_pgTc('השירות אינו זמין כרגע. ניתן לפנות לנציג אנושי.'), 'ai');
        input.disabled = !human.ready;
        sendBtn.disabled = !human.ready;
        escalateWrap.style.display = 'block';
        return;
      }
      greeting = data.greeting || _pgTc('שלום! איך אפשר לעזור?');
      // Every card of the conversation comes back in its place (chat_api.php 'actions'): the open one live, a settled
      // one as the record of what happened (Roi, 04/10: after leaving the page the card was gone without a trace).
      const historyCards = Array.isArray(data.actions) && window.pgActionCardsUpTo ? data.actions.slice() : null;
      if (data.history && data.history.length > 0) {
        data.history.forEach(function(msg) {
          if (msg.role === 'assistant' && msg.sender === 'agent') {
            addAgentBubble(msg.content, msg.agent || '', msg.image ? msg.id : 0, msg.avatar);
            return;
          }
          var bubble = addBubble('', msg.role === 'assistant' ? 'ai' : 'user');
          bubble.textContent = msg.content;
          // A screenshot they sent the team (support_image.js).
          if (msg.image && msg.role === 'user') showImage(bubble, msg.id, !msg.content);
          if (msg.role === 'assistant') {
            processNavigateLinks(bubble);
            if (historyCards) window.pgActionCardsUpTo(messagesArea, historyCards, Number(msg.at) || 0);
          }
        });
      } else {
        addBubble(greeting, 'ai');
      }
      if (data.human && data.human.active) {
        startHuman();
        addNote(_pgTc('הפנייה אצל צוות התמיכה. אפשר להמשיך לכתוב כאן.'));
        offerPush(data.human.push_key);
      }
      if (historyCards) {
        window.pgActionCardsUpTo(messagesArea, historyCards, Infinity);
      } else if (data.open_proposal && window.pgAppendActionCard) {
        // An older server: only a proposal that is still open (page was reloaded mid-decision) comes back as a card,
        // so there is always something to click — never a dead end.
        window.pgAppendActionCard(messagesArea, data.open_proposal);
      }
    })
    .catch(function() {
      addBubble(_pgTc('שלום! איך אפשר לעזור?'), 'ai');
    });

    // Set after the composer exists but before focus, so the caret lands at the end of the
    // handed-over text and the user only has to press send.
    if (prefill) input.value = prefill;
    input.focus();
  }


  function collectGroupCreateCandidates() {
    var candidates = [];
    var map = [
      { key: 'teachers', type: 'teacher', label: _pgTc('מורה') },
      { key: 'parents', type: 'parent', label: _pgTc('הורה') },
      { key: 'students', type: 'student', label: _pgTc('תלמיד') },
      { key: 'users', type: 'user', label: _pgTc('צוות') }
    ];

    map.forEach(function (entry) {
      var list = (cfg.contacts && Array.isArray(cfg.contacts[entry.key])) ? cfg.contacts[entry.key] : [];
      list.forEach(function (person) {
        var personId = parseInt(person.id, 10);
        if (!personId) return;
        if (entry.type === cfg.current.type && personId === parseInt(cfg.current.id, 10)) return;
        candidates.push({
          value: entry.type + ':' + personId,
          name: String(person.name || _pgTc('משתמש #{id}', { id: personId })),
          label: entry.label,
          classId: person.class_id || '',
          children: person.children || ''
        });
      });
    });

    candidates.sort(function (a, b) {
      return a.name.localeCompare(b.name, 'he');
    });

    return candidates;
  }

  function prepareGroupViewShell() {
    state.activeThreadId = null;
    state.supportOpen = false;
    setGroupTitleAction(false);
    showMain();
    setComposerVisible(false);
    setStatus('');
    if (elTitle) elTitle.textContent = _pgTc('יצירת קבוצה חדשה');
    if (elSubtitle) elSubtitle.textContent = '';
    if (elActiveAvatar) {
      elActiveAvatar.classList.remove('d-none');
      elActiveAvatar.className = 'avatar avatar-sm ms-2';
      elActiveAvatar.innerHTML = '<span class="avatar-initials rounded-circle bg-success text-white" style="font-size: 0.8rem;"><i class="bi bi-people-fill"></i></span>';
    }
  }

  function submitGroupCreate(groupName, selectedMembers, submitBtn, errBox, canMessage, audiences) {
    submitBtn.disabled = true;
    apiFetchJson('create_group', {
      group_name: groupName,
      group_members: selectedMembers.join(','),
      group_audiences: (audiences && audiences.length) ? audiences.join(',') : null,
      group_can_message: canMessage || 'all'
    }).then(function (data) {
      submitBtn.disabled = false;
      if (!data || !data.ok || !data.thread || !data.thread.id) {
        if (errBox) errBox.textContent = _pgTc('לא ניתן ליצור קבוצה כרגע');
        return;
      }
      setComposerVisible(true);
      if (state.serverConnected) {
        socket.emit('threads:list');
      }
      fetchThreadsFromPHP(true);
      openThread(parseInt(data.thread.id, 10), data.thread.title || _pgTc('קבוצה חדשה'));
    }).catch(function (e) {
      submitBtn.disabled = false;
      var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('אירעה שגיאה ביצירת הקבוצה');
      if (errBox) errBox.textContent = msg;
    });
  }

  function openCreateGroupView() {
    if (!canCreateGroups()) return;
    prepareGroupViewShell();
    if (elSubtitle) elSubtitle.textContent = _pgTc('בחר סוג קבוצה');

    const isTeacherOrUser = (cfg.current.type === 'teacher' || cfg.current.type === 'user');

    if (!isTeacherOrUser) {
      openFreeGroupView();
      return;
    }

    if (elMessages) {
      elMessages.innerHTML =
        '<div class="p-3 d-flex flex-column gap-2">' +
        '<button type="button" class="btn btn-primary btn-sm" id="pgGroupByClass"><i class="bi bi-mortarboard me-2"></i>' + _pgTc('קבוצה לפי קבוצת לימוד') + '</button>' +
        '<button type="button" class="btn btn-outline-primary btn-sm" id="pgGroupFree"><i class="bi bi-people me-2"></i>' + _pgTc('קבוצה חופשית') + '</button>' +
        '<button type="button" class="btn btn-outline-secondary btn-sm" id="pgGroupCancelMode">' + _pgTc('ביטול') + '</button>' +
        '</div>';
    }

    const byClassBtn = document.getElementById('pgGroupByClass');
    const freeBtn = document.getElementById('pgGroupFree');
    const cancelBtn = document.getElementById('pgGroupCancelMode');

    if (byClassBtn) byClassBtn.addEventListener('click', function () { openClassGroupWizardStep2(); });
    if (freeBtn) freeBtn.addEventListener('click', function () { openFreeGroupView(); });
    if (cancelBtn) cancelBtn.addEventListener('click', function () { setComposerVisible(true); showSidebar(); });
  }

  function openClassGroupWizardStep2() {
    prepareGroupViewShell();
    if (elSubtitle) elSubtitle.textContent = _pgTc('בחר קבוצת לימוד וסוג משתתפים');
    if (elMessages) {
      elMessages.innerHTML = '<div class="p-3 text-center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> ' + _pgTc('טוען קבוצות לימוד...') + '</div>';
    }

    apiFetchJson('teacher_classes', {}).then(function (data) {
      const classes = (data && Array.isArray(data.classes)) ? data.classes : [];
      if (classes.length === 0) {
        if (elMessages) elMessages.innerHTML = '<div class="p-3 text-center text-muted small">' + _pgTc('לא נמצאו קבוצות לימוד.') + ' <button type="button" class="btn btn-link btn-sm p-0" id="pgClassWizardBack">' + _pgTc('חזרה') + '</button></div>';
        const backBtn = document.getElementById('pgClassWizardBack');
        if (backBtn) backBtn.addEventListener('click', function () { openCreateGroupView(); });
        return;
      }

      const classOptions = classes.map(function (c) {
        return '<option value="' + escapeHtml(c.class_id) + '">' + escapeHtml(c.class_name) + '</option>';
      }).join('');

      if (elMessages) {
        elMessages.innerHTML =
          '<div class="p-2">' +
          '<div class="mb-2">' +
          '<label class="form-label small fw-bold mb-1">' + _pgTc('קבוצת לימוד') + '</label>' +
          '<select class="form-select form-select-sm" id="pgClassWizardClass">' + classOptions + '</select>' +
          '</div>' +
          '<div class="mb-2">' +
          '<label class="form-label small fw-bold mb-1">' + _pgTc('סוג משתתפים') + '</label>' +
          '<div class="d-flex flex-wrap gap-2">' +
          '<div class="form-check"><input class="form-check-input" type="checkbox" id="pgClassWizardStudents" value="students" checked><label class="form-check-label small" for="pgClassWizardStudents">' + _pgTc('תלמידים') + '</label></div>' +
          '<div class="form-check"><input class="form-check-input" type="checkbox" id="pgClassWizardParents" value="parents"><label class="form-check-label small" for="pgClassWizardParents">' + _pgTc('הורים') + '</label></div>' +
          '<div class="form-check"><input class="form-check-input" type="checkbox" id="pgClassWizardTeachers" value="teachers"><label class="form-check-label small" for="pgClassWizardTeachers">' + _pgTc('מורים') + '</label></div>' +
          '</div>' +
          '</div>' +
          '<div class="d-flex gap-2">' +
          '<button type="button" class="btn btn-primary btn-sm" id="pgClassWizardNext">' + _pgTc('המשך') + ' <i class="bi bi-arrow-left ms-1"></i></button>' +
          '<button type="button" class="btn btn-outline-secondary btn-sm" id="pgClassWizardBack">' + _pgTc('חזרה') + '</button>' +
          '</div>' +
          '<div class="small text-danger mt-2" id="pgClassWizardError"></div>' +
          '</div>';
      }

      const nextBtn = document.getElementById('pgClassWizardNext');
      const backBtn = document.getElementById('pgClassWizardBack');
      const errBox = document.getElementById('pgClassWizardError');

      if (backBtn) backBtn.addEventListener('click', function () { openCreateGroupView(); });
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          const classSelect = document.getElementById('pgClassWizardClass');
          const classId = classSelect ? classSelect.value : '';
          const className = classSelect ? classSelect.options[classSelect.selectedIndex].text : '';
          const types = [];
          if (document.getElementById('pgClassWizardStudents') && document.getElementById('pgClassWizardStudents').checked) types.push('students');
          if (document.getElementById('pgClassWizardParents') && document.getElementById('pgClassWizardParents').checked) types.push('parents');
          if (document.getElementById('pgClassWizardTeachers') && document.getElementById('pgClassWizardTeachers').checked) types.push('teachers');

          if (!classId) { if (errBox) errBox.textContent = _pgTc('יש לבחור קבוצת לימוד'); return; }
          if (types.length === 0) { if (errBox) errBox.textContent = _pgTc('יש לבחור לפחות סוג משתתפים אחד'); return; }

          openClassGroupWizardStep3(classId, className, types);
        });
      }
    }).catch(function () {
      if (elMessages) elMessages.innerHTML = '<div class="p-3 text-center text-danger small">' + _pgTc('שגיאה בטעינת כיתות.') + ' <button type="button" class="btn btn-link btn-sm p-0" id="pgClassWizardBack">' + _pgTc('חזרה') + '</button></div>';
      const backBtn = document.getElementById('pgClassWizardBack');
      if (backBtn) backBtn.addEventListener('click', function () { openCreateGroupView(); });
    });
  }

  function openClassGroupWizardStep3(classId, className, memberTypes) {
    prepareGroupViewShell();
    if (elSubtitle) elSubtitle.textContent = _pgTc('בדיקת משתתפים ויצירת קבוצה');
    if (elMessages) {
      elMessages.innerHTML = '<div class="p-3 text-center"><div class="spinner-border spinner-border-sm text-primary" role="status"></div> ' + _pgTc('טוען משתתפים...') + '</div>';
    }

    apiFetchJson('class_members', { classId: classId, memberTypes: memberTypes.join(',') }).then(function (data) {
      const members = (data && Array.isArray(data.members)) ? data.members : [];
      if (members.length === 0) {
        if (elMessages) elMessages.innerHTML = '<div class="p-3 text-center text-muted small">' + _pgTc('לא נמצאו משתתפים.') + ' <button type="button" class="btn btn-link btn-sm p-0" id="pgClassStep3Back">' + _pgTc('חזרה') + '</button></div>';
        const backBtn = document.getElementById('pgClassStep3Back');
        if (backBtn) backBtn.addEventListener('click', function () { openClassGroupWizardStep2(); });
        return;
      }

      const typeLabels = { student: _pgTc('תלמיד'), parent: _pgTc('הורה'), teacher: _pgTc('מורה') };
      const selected = new Set(members.map(function (m) { return m.type + ':' + m.id; }));

      if (elMessages) {
        elMessages.innerHTML =
          '<div class="p-2 pg-chat__class-wizard">' +
          '<div class="mb-2">' +
          '<label class="form-label small fw-bold mb-1">' + _pgTc('שם קבוצה') + '</label>' +
          '<input type="text" class="form-control form-control-sm" id="pgClassGroupName" maxlength="100" value="' + escapeHtml(className) + '" />' +
          '</div>' +
          '<div class="mb-2 pg-chat__class-wizard-members">' +
          '<label class="form-label small fw-bold mb-1" id="pgClassMembersLabel">' + _pgTc('משתתפים ({n})', { n: members.length }) + '</label>' +
          '<input type="search" class="form-control form-control-sm mb-1" id="pgClassMemberSearch" placeholder="' + _pgTc('חיפוש משתתפים...') + '" autocomplete="off">' +
          '<div class="pg-chat__class-members-list" id="pgClassMembersList"></div>' +
          '</div>' +
          '<div class="mb-2">' +
          '<label class="form-label small fw-bold mb-1">' + _pgTc('מי יכול לכתוב בקבוצה?') + '</label>' +
          '<div class="form-check">' +
          '<input class="form-check-input" type="radio" name="pgGroupCanMsg" id="pgGroupCanMsgAll" value="all" checked>' +
          '<label class="form-check-label small" for="pgGroupCanMsgAll">' + _pgTc('כל המשתתפים יכולים לכתוב') + '</label>' +
          '</div>' +
          '<div class="form-check">' +
          '<input class="form-check-input" type="radio" name="pgGroupCanMsg" id="pgGroupCanMsgOwner" value="teacher_only">' +
          '<label class="form-check-label small" for="pgGroupCanMsgOwner">' + _pgTc('רק מנהל הקבוצה יכול לכתוב') + '</label>' +
          '</div>' +
          '</div>' +
          '<div class="d-flex gap-2">' +
          '<button type="button" class="btn btn-success btn-sm" id="pgClassGroupSubmit"><i class="bi bi-plus-circle me-1"></i>' + _pgTc('צור קבוצה') + '</button>' +
          '<button type="button" class="btn btn-outline-secondary btn-sm" id="pgClassStep3Back">' + _pgTc('חזרה') + '</button>' +
          '</div>' +
          '<div class="small text-danger mt-2" id="pgClassGroupError"></div>' +
          '</div>';
      }

      const listEl = document.getElementById('pgClassMembersList');
      const searchEl = document.getElementById('pgClassMemberSearch');
      const countLabel = document.getElementById('pgClassMembersLabel');

      function renderMemberRow(m) {
        const key = m.type + ':' + m.id;
        const domId = 'pgClassMember-' + m.type + '-' + m.id;
        const sub = (m.type === 'parent' && m.children)
          ? '<span class="d-block small text-muted text-truncate">' + escapeHtml(m.children) + '</span>'
          : '';
        return '<div class="form-check py-1 border-bottom">' +
          '<input class="form-check-input" type="checkbox" id="' + domId + '" value="' + escapeHtml(key) + '"' + (selected.has(key) ? ' checked' : '') + '>' +
          '<label class="form-check-label small" for="' + domId + '">' + escapeHtml(m.name) +
          ' <span class="text-muted">(' + (typeLabels[m.type] || m.type) + ')</span>' + sub + '</label>' +
          '</div>';
      }

      function updateCountLabel() {
        if (countLabel) countLabel.textContent = _pgTc('משתתפים ({selected}/{total})', { selected: selected.size, total: members.length });
      }

      function renderMembersList() {
        if (!listEl) return;
        const q = ((searchEl && searchEl.value) || '').trim().toLowerCase();
        const visible = q
          ? members.filter(function (m) {
              const hay = ((m.name || '') + ' ' + (m.children || '') + ' ' + (typeLabels[m.type] || '')).toLowerCase();
              return hay.indexOf(q) !== -1;
            })
          : members;
        listEl.innerHTML = visible.length
          ? visible.map(renderMemberRow).join('')
          : '<div class="p-2 text-center text-muted small">' + _pgTc('לא נמצאו תוצאות.') + '</div>';
      }

      if (listEl) {
        listEl.addEventListener('change', function (ev) {
          const cb = ev.target;
          if (!cb || cb.type !== 'checkbox') return;
          if (cb.checked) selected.add(cb.value); else selected.delete(cb.value);
          updateCountLabel();
        });
      }
      if (searchEl) {
        let memberSearchTimer = null;
        searchEl.addEventListener('input', function () {
          if (memberSearchTimer) clearTimeout(memberSearchTimer);
          memberSearchTimer = setTimeout(renderMembersList, 200);
        });
      }
      renderMembersList();
      updateCountLabel();

      const submitBtn = document.getElementById('pgClassGroupSubmit');
      const backBtn = document.getElementById('pgClassStep3Back');
      const errBox = document.getElementById('pgClassGroupError');

      if (backBtn) backBtn.addEventListener('click', function () { openClassGroupWizardStep2(); });
      if (submitBtn) {
        submitBtn.addEventListener('click', function () {
          const nameEl = document.getElementById('pgClassGroupName');
          const groupName = (nameEl ? nameEl.value : '').trim();
          const selectedMembers = Array.from(selected);

          if (errBox) errBox.textContent = '';
          if (!groupName) { if (errBox) errBox.textContent = _pgTc('יש להזין שם קבוצה'); return; }
          if (!selectedMembers.length) { if (errBox) errBox.textContent = _pgTc('יש לבחור לפחות משתתף אחד'); return; }

          const canMsgOwnerEl = document.getElementById('pgGroupCanMsgOwner');
          const canMessage = (canMsgOwnerEl && canMsgOwnerEl.checked) ? 'teacher_only' : 'all';
          submitGroupCreate(groupName, selectedMembers, submitBtn, errBox, canMessage);
        });
      }
    }).catch(function () {
      if (elMessages) elMessages.innerHTML = '<div class="p-3 text-center text-danger small">' + _pgTc('שגיאה בטעינת משתתפים.') + ' <button type="button" class="btn btn-link btn-sm p-0" id="pgClassStep3Back">' + _pgTc('חזרה') + '</button></div>';
      const backBtn = document.getElementById('pgClassStep3Back');
      if (backBtn) backBtn.addEventListener('click', function () { openClassGroupWizardStep2(); });
    });
  }

  function openFreeGroupView() {
    if (!canCreateGroups()) return;
    prepareGroupViewShell();
    if (elSubtitle) elSubtitle.textContent = _pgTc('בחר משתתפים ושם קבוצה');

    var candidates = collectGroupCreateCandidates();
    var optionsHtml = candidates.map(function (c) {
      return '<option value="' + escapeHtml(c.value) + '">' + escapeHtml(c.name + ' (' + c.label + ')' + candidateExtraLabel(c)) + '</option>';
    }).join('');
    // Whole audiences are for staff and teachers, like the class-group wizard.
    const canPickAudiences = (cfg.current.type === 'teacher' || cfg.current.type === 'user');
    const membersHeadHtml = canPickAudiences
      ? '<div class="d-flex align-items-center justify-content-between gap-2 mb-1">' +
        '<label class="form-label small fw-bold mb-0">' + _pgTc('משתתפים') + '</label>' +
        '<button type="button" class="btn btn-outline-primary btn-sm" id="pgGroupAudienceToggle" aria-expanded="false" aria-controls="pgGroupAudiencePanel"><i class="bi bi-check2-all me-2"></i>' + _pgTc('בחר הכל') + '</button>' +
        '</div>' +
        '<div class="pg-chat__audience d-none" id="pgGroupAudiencePanel" role="group" aria-labelledby="pgGroupAudienceTitle">' +
        '<div class="pg-chat__audience-title" id="pgGroupAudienceTitle">' + _pgTc('את מי לסמן? אפשר לבחור יותר מאחד') + '</div>' +
        '<div class="pg-chat__audience-grid" id="pgGroupAudienceGrid"></div>' +
        '</div>' +
        '<div class="pg-chat__audience-summary small d-none" id="pgGroupAudienceSummary" aria-live="polite"></div>'
      : '<label class="form-label small fw-bold mb-1">' + _pgTc('משתתפים') + '</label>';

    if (elMessages) {
      elMessages.innerHTML = '' +
        '<div class="p-2">' +
        '<div class="mb-2">' +
        '<label class="form-label small fw-bold mb-1">' + _pgTc('שם קבוצה') + '</label>' +
        '<input type="text" class="form-control form-control-sm" id="pgCreateGroupName" maxlength="100" placeholder="' + _pgTc('למשל: קבוצת תגבור') + '" />' +
        '</div>' +
        '<div class="mb-2">' +
        membersHeadHtml +
        '<div class="w-100">' +
        '<select id="pgCreateGroupMembers" class="form-select form-select-sm dselect w-100 dselect-w-100" multiple style="height: 220px;">' +
        '<option value="" disabled>' + _pgTc('בחר משתתפים') + '</option>' +
        optionsHtml +
        '</select>' +
        '</div>' +
        '<div class="form-text">' + _pgTc('בחר לפחות משתתף אחד (חוץ ממך).') + '</div>' +
        '</div>' +
        '<div class="mb-2">' +
        '<label class="form-label small fw-bold mb-1">' + _pgTc('מי יכול לכתוב בקבוצה?') + '</label>' +
        '<div class="form-check">' +
        '<input class="form-check-input" type="radio" name="pgGroupCanMsg" id="pgGroupCanMsgAll" value="all" checked>' +
        '<label class="form-check-label small" for="pgGroupCanMsgAll">' + _pgTc('כל המשתתפים יכולים לכתוב') + '</label>' +
        '</div>' +
        '<div class="form-check">' +
        '<input class="form-check-input" type="radio" name="pgGroupCanMsg" id="pgGroupCanMsgOwner" value="teacher_only">' +
        '<label class="form-check-label small" for="pgGroupCanMsgOwner">' + _pgTc('רק מנהל הקבוצה יכול לכתוב') + '</label>' +
        '</div>' +
        '</div>' +
        '<div class="d-flex gap-2">' +
        '<button type="button" class="btn btn-success btn-sm" id="pgCreateGroupSubmit"><i class="bi bi-plus-circle me-1"></i>' + _pgTc('צור קבוצה') + '</button>' +
        '<button type="button" class="btn btn-outline-secondary btn-sm" id="pgCreateGroupCancel">' + _pgTc('ביטול') + '</button>' +
        '</div>' +
        '<div class="small text-muted mt-2" id="pgCreateGroupError"></div>' +
        '</div>';

      initWidgetMultiSelects(elMessages);
      addServerSearchToPicker(document.getElementById('pgCreateGroupMembers'), isCurrentViewer);
    }

    const audiencePicker = canPickAudiences ? setupGroupAudiencePicker() : null;
    var submitBtn = document.getElementById('pgCreateGroupSubmit');
    var cancelBtn = document.getElementById('pgCreateGroupCancel');
    var errBox = document.getElementById('pgCreateGroupError');

    if (cancelBtn) {
      cancelBtn.addEventListener('click', function () {
        setComposerVisible(true);
        showSidebar();
      });
    }

    if (submitBtn) {
      submitBtn.addEventListener('click', function () {
        var nameEl = document.getElementById('pgCreateGroupName');
        var membersEl = document.getElementById('pgCreateGroupMembers');
        var groupName = (nameEl && nameEl.value ? nameEl.value : '').trim();
        var selectedMembers = membersEl
          ? Array.from(membersEl.selectedOptions)
            .map(function (o) { return o.value; })
            .filter(function (v) { return !!String(v || '').trim(); })
          : [];

        const audienceKeys = audiencePicker ? audiencePicker.keys() : [];

        if (errBox) errBox.textContent = '';
        if (!groupName) { if (errBox) errBox.textContent = _pgTc('יש להזין שם קבוצה'); return; }
        if (!selectedMembers.length && !audienceKeys.length) { if (errBox) errBox.textContent = _pgTc('יש לבחור לפחות משתתף אחד'); return; }

        var canMsgOwnerEl = document.getElementById('pgGroupCanMsgOwner');
        var canMessage = (canMsgOwnerEl && canMsgOwnerEl.checked) ? 'teacher_only' : 'all';
        submitGroupCreate(groupName, selectedMembers, submitBtn, errBox, canMessage, audienceKeys);
      });
    }
  }

  // "בחר הכל" in the free group view: a panel of whole audiences — staff, teachers, educators,
  // students, parents, or the whole school at once — ticked together. Only the keys go to the
  // server, which counts them (group_audiences) and expands them (create_group): the contact lists
  // in cfg are capped, so the browser cannot build "all parents" of a big school by itself.
  function groupAudienceTiles() {
    return [
      { key: 'school', icon: 'bi-building', label: _pgTc('כל בית הספר') },
      { key: 'users', contacts: 'users', icon: 'bi-person-badge', label: _pgTc('כל הצוות') },
      { key: 'teachers', contacts: 'teachers', icon: 'bi-person-video3', label: _pgTc('כל המורים') },
      { key: 'educators', contacts: 'teachers', icon: 'bi-person-check', label: _pgTc('כל המחנכים') },
      { key: 'students', contacts: 'students', icon: 'bi-backpack', label: _pgTc('כל התלמידים') },
      { key: 'parents', contacts: 'parents', icon: 'bi-people', label: _pgTc('כל ההורים') }
    ];
  }

  function setupGroupAudiencePicker() {
    const picker = { selected: new Set(), counts: {} };
    picker.keys = function () { return Array.from(picker.selected); };

    const toggleBtn = document.getElementById('pgGroupAudienceToggle');
    const panel = document.getElementById('pgGroupAudiencePanel');
    const grid = document.getElementById('pgGroupAudienceGrid');
    const summary = document.getElementById('pgGroupAudienceSummary');
    if (!toggleBtn || !panel || !grid) return picker;

    let loadState = 'idle';
    const tiles = groupAudienceTiles();

    function formatCount(n) {
      return _pgTn('משתתף אחד', '{n} משתתפים', n, { n: Number(n).toLocaleString('en-US') });
    }

    // The educators are teachers: with both ticked they are counted once.
    function countOf(keys) {
      let total = 0;
      keys.forEach(function (key) {
        if (key === 'educators' && keys.indexOf('teachers') !== -1) return;
        total += picker.counts[key] || 0;
      });
      return total;
    }

    function wholeSchoolKeys() {
      return Object.keys(picker.counts);
    }

    function sync() {
      const all = wholeSchoolKeys();
      grid.querySelectorAll('.pg-chat__audience-input').forEach(function (input) {
        const checked = input.value === 'school'
          ? all.length > 0 && all.every(function (k) { return picker.selected.has(k); })
          : picker.selected.has(input.value);
        input.checked = checked;
        input.closest('.pg-chat__audience-tile').classList.toggle('is-checked', checked);
      });

      if (!summary) return;
      const keys = picker.keys();
      if (!keys.length) {
        summary.classList.add('d-none');
        summary.textContent = '';
        return;
      }
      const wholeSchool = all.length > 1 && all.every(function (k) { return picker.selected.has(k); });
      const names = tiles
        .filter(function (t) { return wholeSchool ? t.key === 'school' : (t.key !== 'school' && picker.selected.has(t.key)); })
        .map(function (t) { return t.label; });
      summary.innerHTML = '<i class="bi bi-people-fill me-2" aria-hidden="true"></i><span>' +
        escapeHtml(_pgTc('נבחרו: {list}', { list: names.join(', ') }) + ' · ' + formatCount(countOf(keys))) + '</span>';
      summary.classList.remove('d-none');
    }

    function render(audiences) {
      picker.counts = {};
      (audiences || []).forEach(function (a) {
        const tile = tiles.find(function (t) { return t.key === a.key; });
        // Only what this person may write to: the contact lists in cfg are already filtered by the
        // school's chat permissions (filter_chat_contacts), so an empty list means the matrix says no.
        if (!tile || !(cfg.contacts && Array.isArray(cfg.contacts[tile.contacts]) && cfg.contacts[tile.contacts].length)) return;
        picker.counts[a.key] = parseInt(a.count, 10) || 0;
      });

      const shown = tiles.filter(function (t) {
        return t.key === 'school' ? wholeSchoolKeys().length > 1 : picker.counts[t.key] !== undefined;
      });
      if (!shown.length) {
        grid.innerHTML = '<div class="pg-chat__audience-note">' + escapeHtml(_pgTc('אין כאן קבוצות לסימון')) + '</div>';
        return;
      }

      grid.innerHTML = shown.map(function (t) {
        const count = t.key === 'school' ? countOf(wholeSchoolKeys()) : picker.counts[t.key];
        return '<label class="pg-chat__audience-tile' + (t.key === 'school' ? ' pg-chat__audience-tile--wide' : '') + '">' +
          '<input type="checkbox" class="pg-chat__audience-input visually-hidden" value="' + t.key + '">' +
          '<span class="pg-chat__audience-icon" aria-hidden="true"><i class="bi ' + t.icon + '"></i></span>' +
          '<span class="pg-chat__audience-text">' +
          '<span class="pg-chat__audience-name">' + escapeHtml(t.label) + '</span>' +
          '<span class="pg-chat__audience-count">' + escapeHtml(formatCount(count)) + '</span>' +
          '</span>' +
          '<i class="bi bi-check-circle-fill pg-chat__audience-check" aria-hidden="true"></i>' +
          '</label>';
      }).join('');
      sync();
    }

    function load() {
      loadState = 'loading';
      grid.innerHTML = '<div class="pg-chat__audience-note"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + escapeHtml(_pgTc('טוען...')) + '</div>';
      apiFetchJson('group_audiences', {}).then(function (data) {
        loadState = 'loaded';
        render(data && data.audiences);
      }).catch(function () {
        loadState = 'idle';
        grid.innerHTML = '<div class="pg-chat__audience-note text-danger">' + escapeHtml(_pgTc('לא ניתן לטעון את הרשימה כרגע')) + '</div>';
      });
    }

    toggleBtn.addEventListener('click', function () {
      const opening = panel.classList.contains('d-none');
      panel.classList.toggle('d-none', !opening);
      toggleBtn.setAttribute('aria-expanded', opening ? 'true' : 'false');
      if (opening && loadState === 'idle') load();
    });

    grid.addEventListener('change', function (ev) {
      const input = ev.target;
      if (!input || !input.classList.contains('pg-chat__audience-input')) return;
      if (input.value === 'school') {
        wholeSchoolKeys().forEach(function (k) {
          if (input.checked) picker.selected.add(k); else picker.selected.delete(k);
        });
      } else if (input.checked) {
        picker.selected.add(input.value);
      } else {
        picker.selected.delete(input.value);
      }
      sync();
    });

    return picker;
  }

  function renderSupportThreadItem() {
    if (!elList) return;
    const div = document.createElement("div");
    div.className = "pg-chat__item" + (state.supportOpen ? " active" : "");
    div.setAttribute("data-thread-id", "support");
    div.innerHTML = `
      <div class="d-flex align-items-center w-100">
        <div class="avatar avatar-sm" style="margin-inline-end: 1rem;">
          <img src="/M/assets/images/logo_p.png" alt="Pgishonim Support" style="width:100%;height:100%;object-fit:contain;">
        </div>
        <div class="flex-grow-1 overflow-hidden">
          <div class="d-flex justify-content-between align-items-center">
            <h6 class="pg-chat__item-title mb-0 text-truncate" style="font-size: 0.9rem;">${_pgTc('תמיכה טכנית')}</h6>
          </div>
          <div class="d-flex justify-content-between align-items-center">
            <p class="pg-chat__item-subtitle mb-0 text-truncate" style="font-size: 0.75rem;">${_pgTc("פתחו צ'אט עם התמיכה של פגישונים")}</p>
          </div>
        </div>
      </div>
    `;
    div.addEventListener("click", function () {
      openSupportWidget();
    });
    elList.appendChild(div);
  }

  function _avatarImgError(img) {
    var parent = img.parentElement;
    if (!parent) return;
    var name = img.getAttribute('alt') || '?';
    var sm = parent.classList.contains('avatar-sm');
    var fs = sm ? '0.8rem' : '1rem';
    var initial = (typeof getInitials === 'function') ? getInitials(name) : name.substring(0, 1).toUpperCase();
    img.outerHTML = '<span class="avatar-initials rounded-circle bg-primary text-white" style="font-size:' + fs + ';">' + escapeHtml(initial) + '</span>';
  }

  function renderAvatar(name, avatar, isOnline, sizeClass = "avatar-sm", onlineSource) {
    const initials = getInitials(name);
    const statusClass = isOnline ? (onlineSource === 'presence' ? "avatar-insystem" : "avatar-online") : "";

    const bgClass = "bg-primary text-white";
    const fontSize = sizeClass === "avatar-sm" ? "0.8rem" : "1rem";
    const fallback = `<span class="avatar-initials rounded-circle ${bgClass}" style="font-size: ${fontSize};">${escapeHtml(initials)}</span>`;

    if (avatar && avatar !== "") {
      return `
          <div class="avatar ${sizeClass} ${statusClass}" style="margin-inline-end: 1rem;">
            <img src="/assets/compiled/jpg/${escapeHtml(avatar)}" alt="${escapeHtml(name)}" class="rounded-circle"
                 onerror="_avatarImgError(this)">
          </div>
        `;
    } else {
      return `
          <div class="avatar ${sizeClass} ${statusClass}" style="margin-inline-end: 1rem;">
            ${fallback}
          </div>
        `;
    }
  }

  function fetchThreadsFromPHP(retry) {
    const url = buildApiUrl('list');
    fetch(url, { credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
      .then(function (data) {
        // Always extract last_seen from PHP response into lastSeenAt map
        (data.threads || []).forEach(function (t) {
          if (t.last_seen && t.other_type && t.other_id) {
            var key = (normalizeMemberType(t.other_type) || t.other_type) + ':' + String(t.other_id);
            if (!state.lastSeenAt.has(key)) {
              state.lastSeenAt.set(key, new Date(t.last_seen));
            }
          }
        });
        if (state.serverConnected) {
          // Merge last_seen into existing socket-loaded threads
          (data.threads || []).forEach(function (phpThread) {
            if (phpThread.last_seen) {
              var st = state.threads.find(function (t) { return t.id === phpThread.id; });
              if (st && !st.last_seen) st.last_seen = phpThread.last_seen;
            }
          });
          return;
        }
        var _phpThreads = data.threads || [];
        if (_phpThreads.length === 0 && state.threads.length > 0) return;
        state.threads = _phpThreads;
        if (state.activeThreadId) {
          var active = state.threads.find(function (t) { return String(t.id) === String(state.activeThreadId); });
          if (active && active.is_group) {
            state.activeThreadMuted = !!active.is_muted;
            updateActiveGroupSubtitle();
          }
        }
        state.threadsLoaded = true;
        updateBadge();
        if (!state.supportOpen) renderList();
        loadParentChildren();
      })
      .catch(function () {
        state.threadsLoaded = true;
        if (!state.supportOpen) renderList();
      });
  }

  function fetchMessagesFromPHP(threadId, beforeId) {
    var params = { threadId: threadId };
    if (beforeId) params.before = beforeId;
    const url = buildApiUrl('messages', params);
    if (!beforeId) setStatus(_pgTc('טוען הודעות...'));
    fetch(url, { credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
      .then(function (data) {
        if (state.activeThreadId !== threadId) return;
        var th = data.thread || {};
        var msgs = data.messages || [];
        state.hasMoreMessages = !!(data.has_more);
        if (msgs.length > 0) {
          state.oldestMessageId = msgs[0].id;
        }
        // Read-receipt state must be in place before bubbles render (✓/✓✓).
        state.activeThreadReads = new Map();
        (Array.isArray(data.group_members) ? data.group_members : []).forEach(function (gm) {
          if (gm && gm.type && gm.id !== undefined && gm.id !== null) {
            state.activeThreadReads.set(gm.type + ':' + gm.id, parseInt(gm.last_read_id, 10) || 0);
          }
        });
        // Delivery state (3-state ticks). other_last_delivered_id === -1 means the
        // delivered column isn't present → fall back to 2-state ticks.
        state.activeThreadDelivered = new Map();
        state.activeThreadDeliveredSupported = !(th && th.other_last_delivered_id === -1);
        if (th && Object.prototype.hasOwnProperty.call(th, 'other_last_read_id')) {
          var readsThread = state.threads.find(function (z) { return z.id === threadId; }) || th;
          var readsOther = getThreadOtherMember(readsThread);
          if (readsOther) {
            state.activeThreadReads.set(readsOther.type + ':' + readsOther.id, parseInt(th.other_last_read_id, 10) || 0);
            if (state.activeThreadDeliveredSupported && th.other_last_delivered_id >= 0) {
              state.activeThreadDelivered.set(readsOther.type + ':' + readsOther.id, parseInt(th.other_last_delivered_id, 10) || 0);
            }
          }
        }
        if (beforeId) {
          // Prepend older messages (pagination)
          prependMessages(msgs, !!(th.is_group));
          state.loadingMoreMessages = false;
          return;
        }
        renderMessages(msgs, !!th.is_group);
        var titleToSet = (th.title && th.title !== 'שיחה') ? (isSystemNamedThread(th) ? _pgTc(th.title, null, 'chat_thread') : th.title) : (function () {
          var x = state.threads.find(function (z) { return z.id === threadId; });
          return (x && x.title && x.title !== 'שיחה') ? x.title : _pgTc('שיחה', null, 'chat');
        })();
        var stateThread = state.threads.find(function (z) { return z.id === threadId; }) || null;
        if (th && Object.prototype.hasOwnProperty.call(th, 'is_muted') && stateThread) {
          stateThread.is_muted = !!th.is_muted;
        }
        var stateOrApiThread = stateThread || th;
        var other = getThreadOtherMember(stateOrApiThread);
        var isGroupThread = !!(th && th.is_group) || !!(stateThread && stateThread.is_group);
        var hasMutedFromApi = !!(th && Object.prototype.hasOwnProperty.call(th, 'is_muted'));
        var canManageFromApi = !!(th && Object.prototype.hasOwnProperty.call(th, 'can_manage_members'));
        var isMutedThread = hasMutedFromApi ? !!th.is_muted : !!(stateThread && stateThread.is_muted);
        state.activeThreadMuted = isGroupThread ? isMutedThread : false;
        state.activeThreadCanManageMembers = isGroupThread ? (canManageFromApi ? !!th.can_manage_members : false) : false;
        state.activeThreadIsOwner = isGroupThread ? !!(th && th.is_owner) : false;
        if (th && Object.prototype.hasOwnProperty.call(th, 'is_broadcast') && stateThread) {
          stateThread.is_broadcast = !!th.is_broadcast;
        }
        var canSendFromApi = (th && Object.prototype.hasOwnProperty.call(th, 'can_send')) ? !!th.can_send : true;
        if (!canSendFromApi) {
          setComposerVisible(false);
        }
        state.activeThreadCanMessageMode = isGroupThread ? ((th && th.group_can_message) || 'all') : 'all';
        state.activeThreadSchedule = (isGroupThread && th && Array.isArray(th.group_schedule)) ? th.group_schedule : [];
        renderHeaderThreadActions();
        state.activeGroupMembers = Array.isArray(data.group_members) ? data.group_members : [];
        state.activeGroupMemberCount = (typeof data.group_member_count === 'number') ? data.group_member_count : state.activeGroupMembers.length;
        state.activeGroupMembersHasMore = !!data.group_members_has_more;
        setGroupTitleAction(isGroupThread);
        if (isGroupThread && elGroupMembersPanel && elGroupMembersPanel.classList.contains('open')) {
          renderGroupMembersPanel();
        }
        var isUserOnline = !!(other && isOnline(other.type, other.id));
        var activeStatusClass = (!isGroupThread && other) ? getOnlineStatusClass(other.type, other.id) : '';
        var headerAvatar = ((th && th.avatar) || (stateThread && stateThread.avatar) || '');
        setThreadTitle(titleToSet, isGroupThread ? null : stateOrApiThread);
        if (elSubtitle) elSubtitle.textContent = isGroupThread ? getGroupSubtitleLabel() : (other ? getPresenceSubtitle(stateOrApiThread, isUserOnline) : '');
        if (elActiveAvatar) {
          elActiveAvatar.classList.remove('d-none');
          elActiveAvatar.className = 'avatar avatar-sm ms-2' + (activeStatusClass ? ' ' + activeStatusClass : '');
          if (isGroupThread) {
            elActiveAvatar.innerHTML = getGroupAvatarBadgeHtml(stateOrApiThread);
          } else {
            var av = (headerAvatar && headerAvatar !== '') ? '<img src="/assets/compiled/jpg/' + escapeHtml(headerAvatar) + '" alt="" class="rounded-circle">' : '<span class="avatar-initials rounded-circle bg-primary text-white" style="font-size: 0.8rem;">' + escapeHtml((titleToSet || '?').substring(0, 1).toUpperCase()) + '</span>';
            elActiveAvatar.innerHTML = av;
          }
        }
        if (!isGroupThread && other) {
          checkRecipientAvailability(other.type, other.id);
        } else {
          removeOfflineNotice();
        }
        setStatus('');
      })
      .catch(function (err) {
        // If thread not found or forbidden, go back to list silently
        if (err && typeof err.status === 'number' && (err.status === 404 || err.status === 403)) {
          if (err.status === 403) notifyUser(_pgTc('אין לך גישה לשיחה זו'), 'error');
          if (isMaximized()) {
            // Two-pane desktop: the list stays visible, so don't tear the
            // conversation down (that would leave a dead main pane). Show the
            // error inline and keep the list usable.
            setComposerVisible(false);
            if (elMessages) elMessages.innerHTML = '<div class="alert alert-warning m-3">' + (err.status === 403 ? _pgTc('אין לך גישה לשיחה זו') : _pgTc('השיחה לא נמצאה')) + '</div>';
            setStatus('');
            return;
          }
          state.activeThreadId = null;
          setComposerVisible(false);
          showSidebar();
          setStatus('');
          return;
        }
        if (state.serverConnected) {
          socket.emit('thread:open', { threadId: threadId });
          var fallbackDone = false;
          var tid = setTimeout(function () {
            if (fallbackDone) return;
            fallbackDone = true;
            socket.off('thread:open:result', onResult);
            if (elMessages && state.activeThreadId === threadId) {
              elMessages.innerHTML = '<div class="alert alert-warning m-3">' + _pgTc('לא ניתן לטעון הודעות כרגע.') + '</div>';
            }
            setStatus('');
          }, 4000);
          function onResult(payload) {
            if (fallbackDone) return;
            if (!payload || state.activeThreadId !== (payload.thread && payload.thread.id || threadId)) return;
            fallbackDone = true;
            clearTimeout(tid);
            socket.off('thread:open:result', onResult);
            var msgs = payload.messages || [];
            var th = payload.thread || {};
            renderMessages(msgs, !!th.is_group);
            var titleToSet = (th.title && th.title !== 'שיחה') ? (isSystemNamedThread(th) ? _pgTc(th.title, null, 'chat_thread') : th.title) : (function () {
              var x = state.threads.find(function (z) { return z.id === threadId; });
              return (x && x.title && x.title !== 'שיחה') ? x.title : _pgTc('שיחה', null, 'chat');
            })();
            var stateThread = state.threads.find(function (z) { return z.id === threadId; }) || null;
            var stateOrApiThread = stateThread || th;
            var other = getThreadOtherMember(stateOrApiThread);
            var isGroupThread = !!(th && th.is_group) || !!(stateThread && stateThread.is_group);
            var isMutedThread = !!(stateThread && stateThread.is_muted);
            state.activeThreadMuted = isGroupThread ? isMutedThread : false;
            state.activeThreadCanManageMembers = false;
      state.activeThreadIsOwner = false;
            state.activeThreadCanMessageMode = 'all';
            state.activeThreadSchedule = [];
            renderHeaderThreadActions();
            state.activeGroupMembers = Array.isArray(payload.group_members) ? payload.group_members : [];
            state.activeGroupMemberCount = (typeof payload.group_member_count === 'number') ? payload.group_member_count : state.activeGroupMembers.length;
            state.activeGroupMembersHasMore = !!payload.group_members_has_more;
            setGroupTitleAction(isGroupThread);
            if (isGroupThread && elGroupMembersPanel && elGroupMembersPanel.classList.contains('open')) {
              renderGroupMembersPanel();
            }
            var isUserOnline = !!(other && isOnline(other.type, other.id));
            var activeStatusClass2 = (!isGroupThread && other) ? getOnlineStatusClass(other.type, other.id) : '';
            var headerAvatar = ((th && th.avatar) || (stateThread && stateThread.avatar) || '');
            setThreadTitle(titleToSet, isGroupThread ? null : stateOrApiThread);
            if (elSubtitle) elSubtitle.textContent = isGroupThread ? getGroupSubtitleLabel() : (other ? getPresenceSubtitle(stateOrApiThread, isUserOnline) : '');
            if (elActiveAvatar) {
              elActiveAvatar.classList.remove('d-none');
              elActiveAvatar.className = 'avatar avatar-sm ms-2' + (activeStatusClass2 ? ' ' + activeStatusClass2 : '');
              if (isGroupThread) {
                elActiveAvatar.innerHTML = getGroupAvatarBadgeHtml(stateOrApiThread);
              } else {
                var av = (headerAvatar && headerAvatar !== '') ? '<img src="/assets/compiled/jpg/' + escapeHtml(headerAvatar) + '" alt="" class="rounded-circle">' : '<span class="avatar-initials rounded-circle bg-primary text-white" style="font-size: 0.8rem;">' + escapeHtml((titleToSet || '?').substring(0, 1).toUpperCase()) + '</span>';
                elActiveAvatar.innerHTML = av;
              }
            }
            setStatus('');
          }
          socket.once('thread:open:result', onResult);
        } else {
          if (state.activeThreadId === threadId && elMessages) elMessages.innerHTML = '<div class="alert alert-warning m-3">' + _pgTc('לא ניתן לטעון הודעות כרגע.') + '</div>';
          setStatus('');
        }
      });
  }

  function removeOfflineNotice() {
    const existing = document.getElementById('pgChatOfflineNotice');
    if (existing) existing.remove();
  }

  function checkRecipientAvailability(memberType, memberId) {
    removeOfflineNotice();
    if (!memberType || !memberId) return;
    apiFetchJson('recipient_availability', { memberType: memberType, memberId: memberId })
      .then(function (data) {
        if (!data || data.available !== false) return;
        const nw = data.next_window;
        if (!nw) return;
        const firstName = data.first_name || '';
        let dayDesc = '';
        if (nw.is_today) dayDesc = _pgTc('היום');
        else if (nw.is_tomorrow) dayDesc = _pgTc('מחר');
        else dayDesc = _pgTc('ביום {day}', { day: _pgTc(nw.day_name, null, 'weekday') });
        const noticeText = firstName
          ? _pgTc('ההודעה תתקבל אצל {name} {day} בשעה {time}', { name: firstName, day: dayDesc, time: nw.time_start })
          : _pgTc('ההודעה תתקבל {day} בשעה {time}', { day: dayDesc, time: nw.time_start });
        const notice = document.createElement('div');
        notice.id = 'pgChatOfflineNotice';
        notice.className = 'pg-chat__offline-notice';
        notice.textContent = noticeText;
        if (elForm && elForm.parentNode) {
          elForm.parentNode.insertBefore(notice, elForm);
        }
      })
      .catch(function () {});
  }

  function _dmOpenViaPhp(memberType, memberId, fallbackTitle) {
    setStatus(_pgTc("פותח שיחה..."));
    apiFetchJson('dm_open', { memberType: memberType, memberId: memberId })
      .then(function (data) {
        if (!data || !data.thread || !data.thread.id) {
          throw new Error('dm_open_failed');
        }
        state.threads = [data.thread].concat(state.threads.filter(function (t) { return String(t.id) !== String(data.thread.id); }));
        updateBadge();
        renderList();
        openThread(parseInt(data.thread.id, 10), data.thread.title || fallbackTitle || _pgTc('שיחה', null, 'chat'));
        setStatus('');
      })
      .catch(function (err) {
        console.error('Fallback dm_open failed', err);
        setStatus('');
        notifyUser(_pgTc('לא ניתן לפתוח שיחה כרגע'), 'error');
      });
  }

  function openDirectConversation(memberType, memberId, fallbackTitle) {
    memberType = normalizeMemberType(memberType);
    if (state.serverConnected) {
      setStatus(_pgTc("פותח שיחה..."));
      socket.emit("dm:open", { memberType: memberType, memberId: memberId });
      openFallbackTimeout = setTimeout(function () {
        openFallbackTimeout = null;
        _dmOpenViaPhp(memberType, memberId, fallbackTitle);
      }, 3000);
      return;
    }

    _dmOpenViaPhp(memberType, memberId, fallbackTitle);
  }

  function sendMessageViaPHP(threadId, txt) {
    return apiFetchJson('send', { threadId: threadId, message: txt }).then(function (data) {
      if (!data || !data.ok || !data.message) {
        throw new Error('send_failed');
      }

      const thread = state.threads.find(function (t) { return t.id === threadId; });
      if (thread) {
        thread.last_text = txt;
        thread.last_at = data.message.created_at || thread.last_at;
      }
      renderList();

      const isGroup = thread ? !!thread.is_group : false;
      appendMessage(data.message, true, isGroup);
      return data;
    });
  }

  function resolveThreadDisplay(t) {
    if (t.title && t.title !== "שיחה") return { title: isSystemNamedThread(t) ? _pgTc(t.title, null, 'chat_thread') : t.title, avatar: t.avatar };
    var other = getThreadOtherMember(t);
    if (other && cfg.contacts) {
      var key = String(other.type) + "s";
      var arr = cfg.contacts[key];
      if (Array.isArray(arr)) {
        var c = arr.find(function (x) { return String(x.id) === String(other.id); });
        if (c) return { title: String(c.name || _pgTc("שיחה", null, 'chat')), avatar: c.avatar || t.avatar };
      }
    }
    return { title: _pgTc("שיחה", null, 'chat'), avatar: t.avatar };
  }

  function renderList() {
    if (!elList) return;

    var existingNewBtn3 = document.getElementById('pgAiChatNewBtn');
    if (existingNewBtn3 && !state.supportOpen) existingNewBtn3.remove();

    const q = (elSearch?.value || "").trim().toLowerCase();
    elList.innerHTML = "";

    if (state.tab === "threads" || state.tab === "groups") {
      if (state.tab === "groups" && canCreateGroups()) {
        const addGroupItem = document.createElement("div");
        addGroupItem.className = "pg-chat__item";
        addGroupItem.innerHTML = `
          <div class="d-flex align-items-center">
            <div class="avatar avatar-sm" style="margin-inline-end: 1rem;"><span class="avatar-initials rounded-circle bg-success text-white" style="font-size: 0.8rem;"><i class="bi bi-plus-lg"></i></span></div>
            <div class="flex-grow-1 overflow-hidden">
              <h6 class="pg-chat__item-title mb-0 text-truncate" style="font-size: 0.9rem;">${_pgTc('הוספת קבוצה')}</h6>
              <p class="pg-chat__item-subtitle mb-0 text-truncate" style="font-size: 0.75rem;">${_pgTc('יצירת קבוצה חדשה')}</p>
            </div>
          </div>
        `;
        addGroupItem.addEventListener("click", function () {
          openCreateGroupView();
        });
        elList.appendChild(addGroupItem);
      }

      if (state.tab === "threads") {
        renderSupportThreadItem();
      }

      const filtered = state.threads.filter((t) => {
        var d = resolveThreadDisplay(t);
        const matchesQuery = (d.title || "").toLowerCase().includes(q);
        if (state.tab === "groups") return t.is_group && !isSystemAlertsThread(t) && matchesQuery;
        return matchesQuery;
      });

      const sortedThreads = filtered.slice().sort(function (a, b) {
        var aTime = a && a.last_at ? new Date(a.last_at).getTime() : 0;
        var bTime = b && b.last_at ? new Date(b.last_at).getTime() : 0;
        if (isNaN(aTime)) aTime = 0;
        if (isNaN(bTime)) bTime = 0;
        if (bTime !== aTime) return bTime - aTime;
        return (b && b.id ? b.id : 0) - (a && a.id ? a.id : 0);
      });

      // Searching from the conversations tab also finds people there is no conversation with
      // yet, so a teacher is found without switching to the teachers tab first.
      const searchContacts = (state.tab === "threads" && q) ? findContactsForSearch(q) : [];

      if (sortedThreads.length === 0 && searchContacts.length === 0) {
        if (state.tab === "groups") {
          if (!state.threadsLoaded) {
            elList.innerHTML = `<div class="p-4 text-center text-muted">${_pgTc('טוען קבוצות...')}</div>`;
          } else {
            // With a search typed, an empty list means nothing matched, not that there are no groups.
            const groupsEmpty = q ? _pgTc("לא נמצאו תוצאות.") : _pgTc("אין קבוצות עדיין");
            if (canCreateGroups()) {
              const empty = document.createElement("div");
              empty.className = "p-4 text-center text-muted";
              empty.textContent = groupsEmpty;
              elList.appendChild(empty);
            } else {
              elList.innerHTML = `<div class="p-4 text-center text-muted">${groupsEmpty}</div>`;
            }
          }
        } else if (!state.threadsLoaded) {
          const loading = document.createElement("div");
          loading.className = "p-4 text-center text-muted";
          loading.textContent = _pgTc("טוען שיחות...");
          elList.appendChild(loading);
        } else if (q) {
          // A search that matched no conversation and no contact says so, as the contact tabs do.
          const none = document.createElement("div");
          none.className = "p-4 text-center text-muted";
          none.textContent = _pgTc("לא נמצאו תוצאות.");
          elList.appendChild(none);
        }
        return;
      }
      sortedThreads.forEach((t) => {
        var d = resolveThreadDisplay(t);
        const div = document.createElement("div");
        div.className = "pg-chat__item" + (t.id === state.activeThreadId ? " active" : "");

        var other = getThreadOtherMember(t);
        const isUserOnline = !!(other && isOnline(other.type, other.id));
        const userOnlineSource = other ? getOnlineSource(other.type, other.id) : null;
        const avatarHtml = t.is_group
          ? `<div class="avatar avatar-sm" style="margin-inline-end: 1rem;">${getGroupAvatarBadgeHtml(t)}</div>`
          : renderAvatar(d.title, d.avatar, isUserOnline, "avatar-sm", userOnlineSource);

        div.setAttribute("data-thread-id", String(t.id));
        div.setAttribute("data-thread-title", String(d.title || ""));
        const parentChildren = t.is_group ? '' : parentChildrenLabel(t);
        const childrenHtml = parentChildren ? ` <bdi class="text-muted fw-normal">(${escapeHtml(parentChildren)})</bdi>` : '';
        // 'הודעה נמחקה' is the placeholder threads_api.php and the socket server store on delete-for-everyone, so a
        // reloaded list shows it in the viewer's language, as the live delete already does.
        div.innerHTML = `
          <div class="d-flex align-items-center w-100">
            ${avatarHtml}
            <div class="flex-grow-1 overflow-hidden">
              <div class="d-flex justify-content-between align-items-center">
                <h6 class="pg-chat__item-title mb-0 text-truncate" style="font-size: 0.9rem;">${escapeHtml(d.title)}${childrenHtml}</h6>
                <small class="text-muted ms-2" style="font-size: 0.7rem;">${escapeHtml(t.last_at ? formatDateTime(t.last_at) : "")}</small>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <p class="pg-chat__item-subtitle mb-0 text-truncate" style="font-size: 0.75rem;">${escapeHtml(listPreviewText(decodeMsg(t.last_text === 'הודעה נמחקה' ? _pgTc('הודעה נמחקה') : (t.last_text || (t.is_group ? _pgTc("קבוצה חדשה") : _pgTc("לחץ להתחלת שיחה"))))))}</p>
                <span class="d-flex align-items-center flex-shrink-0">
                  ${t.unread_count > 0 ? `<span class="badge rounded-pill bg-danger ms-2 min-w-auto text-nowrap" style="font-size: 0.6rem;">${t.unread_count}</span>` : ""}
                </span>
              </div>
            </div>
          </div>
        `;
        div.addEventListener("click", function (ev) {
          var id = parseInt(ev.currentTarget.getAttribute("data-thread-id"), 10);
          var title = ev.currentTarget.getAttribute("data-thread-title") || _pgTc("שיחה", null, 'chat');
          openThread(id, title);
        });
        elList.appendChild(div);
      });
      searchContacts.forEach(function (hit) {
        elList.appendChild(buildContactItem(hit.contact, hit.tab));
      });
      return;
    }

    const filtered = contactsMatching(state.tab, q);
    if (filtered.length === 0) {
      elList.innerHTML = '<div class="p-4 text-center text-muted">' + _pgTc('לא נמצאו תוצאות.') + '</div>';
      return;
    }

    filtered.forEach((c) => {
      elList.appendChild(buildContactItem(c, state.tab));
    });
  }

  function contactMatchesQuery(c, q) {
    return ((c.name || "") + " " + (c.children || "")).toLowerCase().includes(q);
  }

  // The contact lists the page carries stop at 300 users / 600 teachers / 800 students / 800 parents
  // (chat_widget.php), so a big school's parent after "ד" was never found (PG-526). The search also asks
  // the server (threads_api.php search_contacts) and adds the hits the page did not have.
  var serverSearch = { q: "", contacts: null };
  var serverSearchSeq = 0;
  function fetchContactSearch(q) {
    if (q.length < 2) return Promise.resolve(null);
    if (q === serverSearch.q) return Promise.resolve(serverSearch.contacts);
    var seq = ++serverSearchSeq;
    return apiFetchJson('search_contacts', { q: q })
      .then(function (data) {
        var contacts = (data && data.contacts) || null;
        if (seq === serverSearchSeq) serverSearch = { q: q, contacts: contacts };
        return contacts;
      })
      .catch(function () { return null; });
  }

  function searchContactsOnServer(q) {
    if (q.length < 2 || q === serverSearch.q) return;
    fetchContactSearch(q).then(function (contacts) {
      if (contacts && serverSearch.q === q && !state.supportOpen && (elSearch?.value || "").trim().toLowerCase() === q) renderList();
    });
  }

  // The group pickers list cfg.contacts too: typing in their dselect search adds the server's hits the
  // list did not have as options, then re-runs dselect's own filter. isExcluded(value) drops the viewer
  // and anyone already in the group.
  function addServerSearchToPicker(selectEl, isExcluded) {
    var wrapper = selectEl ? selectEl.nextElementSibling : null;
    var input = (wrapper && wrapper.classList.contains('dselect-wrapper')) ? wrapper.querySelector('input.form-control') : null;
    if (!input) return;
    var sources = [
      { key: 'teachers', type: 'teacher', label: _pgTc('מורה') },
      { key: 'parents', type: 'parent', label: _pgTc('הורה') },
      { key: 'students', type: 'student', label: _pgTc('תלמיד') },
      { key: 'users', type: 'user', label: _pgTc('צוות') }
    ];
    var timer = null;
    input.addEventListener('input', function () {
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () {
        var q = (input.value || '').trim().toLowerCase();
        fetchContactSearch(q).then(function (contacts) {
          if (!contacts || !input.isConnected || (input.value || '').trim().toLowerCase() !== q) return;
          var have = new Set(Array.from(selectEl.options).map(function (o) { return o.value; }));
          var added = 0;
          sources.forEach(function (entry) {
            (Array.isArray(contacts[entry.key]) ? contacts[entry.key] : []).forEach(function (person) {
              var personId = parseInt(person.id, 10);
              var value = entry.type + ':' + personId;
              if (!personId || have.has(value) || isExcluded(value)) return;
              var opt = document.createElement('option');
              opt.value = value;
              opt.textContent = String(person.name || '') + ' (' + entry.label + ')' + candidateExtraLabel({ classId: person.class_id || '', children: person.children || '' });
              selectEl.appendChild(opt);
              have.add(value);
              added++;
            });
          });
          if (!added) return;
          selectEl.dispatchEvent(new Event('change'));
          if (typeof dselectSearch === 'function') dselectSearch({ key: '' }, input, 'dselect-wrapper', '', false);
        });
      }, 250);
    });
  }

  function isCurrentViewer(value) {
    return value === cfg.current.type + ':' + parseInt(cfg.current.id, 10);
  }

  function contactsMatching(tab, q) {
    const local = (cfg.contacts[tab] || []).filter((c) => contactMatchesQuery(c, q));
    const fromServer = (q && serverSearch.q === q && serverSearch.contacts && Array.isArray(serverSearch.contacts[tab])) ? serverSearch.contacts[tab] : [];
    if (!fromServer.length) return local;
    const seen = new Set(local.map((c) => String(c.id)));
    return local.concat(fromServer.filter((c) => !seen.has(String(c.id))));
  }

  // Contacts matching the search, from every contacts tab this viewer is shown (in tab order),
  // minus anyone who already has a conversation — that conversation is listed above them.
  function findContactsForSearch(q) {
    const withThread = new Set();
    state.threads.forEach(function (t) {
      const other = getThreadOtherMember(t);
      if (other) withThread.add(other.type + ':' + other.id);
    });
    const hits = [];
    ["teachers", "parents", "students", "users"].forEach(function (tab) {
      if (!document.querySelector('[data-tab="' + tab + '"]')) return;
      const memberType = tab.slice(0, -1);
      contactsMatching(tab, q).forEach(function (c) {
        if (!withThread.has(memberType + ':' + String(c.id))) {
          hits.push({ contact: c, tab: tab });
        }
      });
    });
    return hits;
  }

  function buildContactItem(c, tab) {
    const div = document.createElement("div");
    div.className = "pg-chat__item";
    const memberType = tab.slice(0, -1); // "users" -> "user"
    const isUserOnline = isOnline(memberType, c.id);
    const contactSource = getOnlineSource(memberType, c.id);
    const avatarHtml = renderAvatar(c.name, c.avatar, isUserOnline, "avatar-sm", contactSource);

    const subtitle = tab === "users" && c.role ? _pgTc('תפקיד: {role}', { role: c.role }) : tab === "students" && c.class_id ? _pgTc('כיתה: {class}', { class: c.class_id }) : tab === "parents" && c.children ? c.children : _pgTc("לחץ לשליחת הודעה");

    div.innerHTML = `
      <div class="d-flex align-items-center">
        ${avatarHtml}
        <div class="flex-grow-1 overflow-hidden">
          <h6 class="pg-chat__item-title mb-0 text-truncate" style="font-size: 0.9rem;">${escapeHtml(c.name)}</h6>
          <p class="pg-chat__item-subtitle mb-0 text-truncate" style="font-size: 0.75rem;">${escapeHtml(subtitle)}</p>
        </div>
      </div>
    `;
    div.addEventListener("click", () => {
      openDirectConversation(memberType, c.id, c.name || _pgTc('שיחה', null, 'chat'));
    });
    return div;
  }

  function openThread(threadId, title) {
    cancelEditMessage();
    if (!state.activeThreadId) {
      state.tabBeforeThread = state.tab;
    }
    state.supportOpen = false;
    state.activeThreadId = threadId;
    state.oldestMessageId = null;
    state.hasMoreMessages = false;
    state.loadingMoreMessages = false;
    state.activeThreadReads = new Map();
    state.activeThreadDelivered = new Map();
    state.reactionsByMsg = new Map();
    if (typeof closeMessageReadersPanel === 'function') closeMessageReadersPanel();
    if (typeof closeReactionPicker === 'function') closeReactionPicker();
    if (typeof closeReactionsPanel === 'function') closeReactionsPanel();
    // 'שיחה' is also the fallback title the servers send for a member without a name
    // (thread:opened, dm_open), so it is shown in the viewer's language like the list does.
    const thread = state.threads.find(function (t) { return t.id === threadId; });
    setThreadTitle((title && title !== 'שיחה') ? title : _pgTc("שיחה", null, 'chat'), (thread && !thread.is_group) ? thread : null);
    saveWidgetState();

    setComposerVisible(!(thread && isBroadcastThread(thread)));
    if (thread) {
      thread.unread_count = 0;
      updateBadge();
      var other = getThreadOtherMember(thread);
      if (!thread.is_group && other) {
        setGroupTitleAction(false);
        var isUserOnline = isOnline(other.type, other.id);
        if (elSubtitle) elSubtitle.textContent = getPresenceSubtitle(thread, isUserOnline);
        if (elActiveAvatar) {
          elActiveAvatar.classList.remove("d-none");
          elActiveAvatar.className = "avatar avatar-sm ms-2 " + getOnlineStatusClass(other.type, other.id);
          if (thread.avatar && thread.avatar !== "") {
            elActiveAvatar.innerHTML = '<img src="/assets/compiled/jpg/' + escapeHtml(thread.avatar) + '" alt="" class="rounded-circle">';
          } else {
            elActiveAvatar.innerHTML = '<span class="avatar-initials rounded-circle bg-primary text-white" style="font-size: 0.8rem;">' + escapeHtml((title || "?").substring(0, 1).toUpperCase()) + '</span>';
          }
        }
      } else {
        state.activeGroupMembers = [];
        state.activeGroupMemberCount = 0;
        state.activeGroupMembersHasMore = false;
        state.activeThreadMuted = !!thread.is_muted;
        state.activeThreadCanManageMembers = false;
      state.activeThreadIsOwner = false;
        setGroupTitleAction(!!thread.is_group);
        if (elSubtitle) elSubtitle.textContent = thread.is_group ? getGroupSubtitleLabel() : "";
        renderHeaderThreadActions();
        if (elActiveAvatar) {
          elActiveAvatar.classList.remove("d-none");
          elActiveAvatar.className = "avatar avatar-sm ms-2";
          elActiveAvatar.innerHTML = getGroupAvatarBadgeHtml(thread);
        }
      }
    }

    setStatus(_pgTc("טוען הודעות..."));
    showMain();
    if (elMessages) {
      resetElMessagesStyles();
      elMessages.innerHTML = '';
    }
    fetchMessagesFromPHP(threadId);
    if (state.serverConnected) {
      socket.emit("thread:open", { threadId: threadId });
    }
    renderHeaderThreadActions();
    renderList();
  }

  function resetElMessagesStyles() {
    if (!elMessages) return;
    elMessages.style.display = '';
    elMessages.style.flexDirection = '';
    elMessages.style.overflow = '';
    elMessages.style.padding = '';
    elMessages.style.direction = '';
  }

  function renderMessages(messages, isGroup = false) {
    if (!elMessages) return;
    if (typeof closeMsgMenu === 'function') closeMsgMenu();
    if (typeof closeReactionPicker === 'function') closeReactionPicker();
    resetElMessagesStyles();
    renderedMessages.clear();
    state.reactionsByMsg = new Map();
    attachmentBlobUrls.forEach(function (url) { URL.revokeObjectURL(url); });
    attachmentBlobUrls.clear();
    elMessages.innerHTML = "";
    if (!messages || messages.length === 0) {
      elMessages.innerHTML = '<div class="text-muted text-center mt-4">' + _pgTc('אין הודעות עדיין. שלחו הודעה ראשונה!') + '</div>';
      setStatus("");
      return;
    }

    if (!isGroup) {
      const thread = state.threads.find(t => t.id === state.activeThreadId);
      isGroup = thread ? !!thread.is_group : false;
    }

    messages.forEach((m) => appendMessage(m, false, isGroup));
    elMessages.scrollTop = elMessages.scrollHeight;
    setStatus("");
  }

  function prependMessages(messages, isGroup) {
    if (!elMessages) return;
    // Remove "load more" spinner if present
    var spinner = elMessages.querySelector('.pg-chat__load-more');
    if (spinner) spinner.remove();
    if (!messages || messages.length === 0) return;
    if (!isGroup) {
      const thread = state.threads.find(t => t.id === state.activeThreadId);
      isGroup = thread ? !!thread.is_group : false;
    }
    // Save scroll position
    var prevScrollHeight = elMessages.scrollHeight;
    var prevScrollTop = elMessages.scrollTop;
    // Get first child to insert before
    var firstChild = elMessages.firstChild;
    messages.forEach(function (m) {
      var div = buildMessageEl(m, isGroup);
      if (div) elMessages.insertBefore(div, firstChild);
    });
    // Restore scroll position so user doesn't jump
    elMessages.scrollTop = prevScrollTop + (elMessages.scrollHeight - prevScrollHeight);
  }

  function loadOlderMessages() {
    if (!state.activeThreadId || !state.hasMoreMessages || state.loadingMoreMessages || !state.oldestMessageId) return;
    state.loadingMoreMessages = true;
    // Show loading spinner at top
    if (elMessages) {
      var spinner = elMessages.querySelector('.pg-chat__load-more');
      if (!spinner) {
        spinner = document.createElement('div');
        spinner.className = 'pg-chat__load-more text-center py-2';
        spinner.innerHTML = '<div class="spinner-border spinner-border-sm text-muted" role="status"></div>';
        elMessages.insertBefore(spinner, elMessages.firstChild);
      }
    }
    fetchMessagesFromPHP(state.activeThreadId, state.oldestMessageId);
  }

  /**
   * Pull a leading `*Title*` line out of a message body so the renderer can
   * style it as a heading instead of dumping literal asterisks. This is the
   * convention M/messages/cron/chat_worker.php uses when an admin sends a
   * broadcast with a title — see the `*{$title}*\n\n{$message}` template
   * there. Returns `{ title, body }`. If the message doesn't open with the
   * pattern, `title` is null and `body` is the original text.
   */
  function parseTitleAndBody(raw) {
    const text = String(raw || '');
    // Anchor at start; allow any title text up to the first `*` on the same line;
    // require either end-of-string or a newline immediately after the closing `*`.
    const m = text.match(/^\*([^\n*][^\n*]*)\*(?:\n+([\s\S]*))?$/);
    if (!m) return { title: null, body: text };
    const title = m[1].trim();
    const body = (m[2] || '').replace(/^\n+/, '');
    if (!title) return { title: null, body: text };
    return { title, body };
  }

  function linkifyUrls(html) {
    return html.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
      return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
    });
  }

  /** Format a single bubble's text content with title heading + body lines. */
  // A school message's "*title*" heading, in the list's one-line preview, without its asterisks
  function listPreviewText(raw) {
    const { title, body } = parseTitleAndBody(raw);
    return title ? title + (body ? ' · ' + body : '') : raw;
  }

  function renderBubbleBody(rawText) {
    const { title, body } = parseTitleAndBody(decodeMsg(rawText || ''));
    const bodyHtml = linkifyUrls(escapeHtml(body).replace(/\n/g, '<br>'));
    if (title) {
      return `<div class="pg-chat__bubble-title">${escapeHtml(title)}</div>`
           + (bodyHtml ? `<div class="pg-chat__bubble-text">${bodyHtml}</div>` : '');
    }
    return bodyHtml;
  }

  function getFileFromMessage(m) {
    const fileName = m.file_name || m.chat_message_file_name || null;
    const filePath = m.file_path || m.chat_message_file_path || null;
    const fileType = m.file_type || m.chat_message_file_type || '';
    const fileSize = m.file_size || m.chat_message_file_size || 0;
    if (!fileName || !filePath) return null;
    return { name: fileName, path: filePath, type: fileType, size: fileSize };
  }

  function isImageType(mimeType) {
    return /^image\/(jpeg|jpg|png|gif|webp)$/i.test(mimeType || '');
  }

  function formatFileSize(bytes) {
    if (!bytes || bytes <= 0) return '';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function renderFileAttachment(fileInfo, messageId) {
    const downloadUrl = '/chat/download.php?id=' + messageId;
    if (isImageType(fileInfo.type)) {
      // A placeholder with a progress line until loadAttachmentImages() has the whole file.
      return '<div class="pg-chat__img-loading">' +
          '<div class="pg-chat__upload-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="pg-chat__upload-fill"></div></div>' +
          '<div class="pg-chat__upload-status"><span class="spinner-border"></span></div>' +
        '</div>' +
        '<img alt="' + escapeHtml(fileInfo.name) + '" class="pg-chat__attachment-img d-none" ' +
        'data-message-file="' + escapeHtml(String(messageId)) + '" ' +
        'data-lightbox-src="' + escapeHtml(downloadUrl) + '" ' +
        'data-lightbox-dl="' + escapeHtml(downloadUrl) + '&dl=1" ' +
        'data-lightbox-name="' + escapeHtml(fileInfo.name) + '">';
    }
    const ext = (fileInfo.name.split('.').pop() || '').toLowerCase();
    const iconMap = { pdf: 'bi-file-earmark-pdf', doc: 'bi-file-earmark-word', docx: 'bi-file-earmark-word', xls: 'bi-file-earmark-excel', xlsx: 'bi-file-earmark-excel', pptx: 'bi-file-earmark-ppt' };
    const icon = iconMap[ext] || 'bi-file-earmark';
    return '<a href="' + escapeHtml(downloadUrl) + '" target="_blank" rel="noopener noreferrer" class="pg-chat__attachment-file">' +
      '<i class="bi ' + icon + ' me-1"></i>' +
      '<span>' + escapeHtml(fileInfo.name) + '</span>' +
      '</a>';
  }

  // ── Image lightbox: view attachment images in an overlay with zoom + download
  var elLightbox = null;
  var lightboxZoom = 1;
  var lightboxPinch = { active: false, startDist: 0, startZoom: 1 };

  function applyLightboxZoom() {
    if (!elLightbox) return;
    var img = elLightbox.querySelector('.pg-chat__lightbox-img');
    if (img) img.style.transform = 'scale(' + lightboxZoom + ')';
  }

  function setLightboxZoom(z) {
    lightboxZoom = Math.min(Math.max(z, 0.5), 4);
    applyLightboxZoom();
  }

  function lightboxTouchDist(touches) {
    var dx = touches[0].clientX - touches[1].clientX;
    var dy = touches[0].clientY - touches[1].clientY;
    return Math.sqrt(dx * dx + dy * dy);
  }

  // Saves the attachment to the device. On mobile the HTML `download` attribute
  // is ignored (more so after download.php's cross-origin S3 redirect), so the
  // file just opens instead of saving. Fetch it as a blob and hand it to the OS:
  // native share sheet on mobile (Save to Photos/Files), blob download on
  // desktop. Falls back to the endpoint if the file can't be fetched (S3 CORS).
  function lightboxBlobDownload(blob, name) {
    var objUrl = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = objUrl;
    a.download = name || 'download';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(objUrl); }, 1000);
  }

  function lightboxDownload() {
    if (!elLightbox) return;
    var a = elLightbox.querySelector('.pg-chat__lightbox-download');
    var url = a.getAttribute('href');
    var name = a.getAttribute('download') || 'download';
    if (!url) return;
    fetch(url, { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.blob(); })
      .then(function (blob) {
        var file = new File([blob], name, { type: blob.type || 'application/octet-stream' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          return navigator.share({ files: [file], title: name }).catch(function (err) {
            if (err && err.name === 'AbortError') return;
            lightboxBlobDownload(blob, name);
          });
        }
        lightboxBlobDownload(blob, name);
      })
      .catch(function () { window.location.href = url; });
  }

  function closeLightbox() {
    if (elLightbox) elLightbox.classList.remove('open');
  }

  function buildLightbox() {
    elLightbox = document.createElement('div');
    elLightbox.className = 'pg-chat__lightbox';
    elLightbox.innerHTML =
      '<div class="pg-chat__lightbox-toolbar">' +
        '<button type="button" class="pg-chat__lightbox-btn" data-lb-action="zoom-out" title="' + _pgTc('הקטנה') + '"><i class="bi bi-zoom-out"></i></button>' +
        '<button type="button" class="pg-chat__lightbox-btn" data-lb-action="zoom-in" title="' + _pgTc('הגדלה') + '"><i class="bi bi-zoom-in"></i></button>' +
        '<a class="pg-chat__lightbox-btn pg-chat__lightbox-download" data-lb-action="download" title="' + _pgTc('הורדה') + '" download><i class="bi bi-download"></i></a>' +
        '<button type="button" class="pg-chat__lightbox-btn" data-lb-action="close" title="' + _pgTc('סגירה') + '"><i class="bi bi-x-lg"></i></button>' +
      '</div>' +
      '<div class="pg-chat__lightbox-stage"><img class="pg-chat__lightbox-img" alt=""></div>';
    document.body.appendChild(elLightbox);

    var stage = elLightbox.querySelector('.pg-chat__lightbox-stage');
    var stageImg = elLightbox.querySelector('.pg-chat__lightbox-img');
    stage.addEventListener('touchstart', function (ev) {
      if (ev.touches.length === 2) {
        lightboxPinch.active = true;
        lightboxPinch.startDist = lightboxTouchDist(ev.touches);
        lightboxPinch.startZoom = lightboxZoom;
        if (stageImg) stageImg.style.transition = 'none';
        ev.preventDefault();
      }
    }, { passive: false });
    stage.addEventListener('touchmove', function (ev) {
      if (lightboxPinch.active && ev.touches.length === 2) {
        var ratio = lightboxTouchDist(ev.touches) / (lightboxPinch.startDist || 1);
        setLightboxZoom(lightboxPinch.startZoom * ratio);
        ev.preventDefault();
      }
    }, { passive: false });
    stage.addEventListener('touchend', function (ev) {
      if (lightboxPinch.active && ev.touches.length < 2) {
        lightboxPinch.active = false;
        if (stageImg) stageImg.style.transition = '';
      }
    });

    elLightbox.addEventListener('click', function (ev) {
      var actionEl = ev.target.closest('[data-lb-action]');
      var action = actionEl ? actionEl.getAttribute('data-lb-action') : null;
      if (action === 'zoom-in') {
        setLightboxZoom(lightboxZoom + 0.25);
      } else if (action === 'zoom-out') {
        setLightboxZoom(lightboxZoom - 0.25);
      } else if (action === 'download') {
        ev.preventDefault();
        lightboxDownload();
      } else if (action === 'close' || ev.target === elLightbox || ev.target.classList.contains('pg-chat__lightbox-stage')) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape') closeLightbox();
    });
  }

  function openImageLightbox(src, downloadUrl, name) {
    if (!elLightbox) buildLightbox();
    lightboxZoom = 1;
    var img = elLightbox.querySelector('.pg-chat__lightbox-img');
    img.src = src;
    img.alt = name || '';
    applyLightboxZoom();
    var dl = elLightbox.querySelector('.pg-chat__lightbox-download');
    dl.href = downloadUrl;
    if (name) dl.setAttribute('download', name);
    elLightbox.classList.add('open');
  }

  if (elMessages) {
    elMessages.addEventListener('click', function (ev) {
      var img = ev.target.closest('.pg-chat__attachment-img');
      if (!img) return;
      openImageLightbox(
        img.getAttribute('data-lightbox-src'),
        img.getAttribute('data-lightbox-dl'),
        img.getAttribute('data-lightbox-name')
      );
    });
  }

  // ── Emoji reactions (WhatsApp-style). Whitelist mirrors the server. ──
  var REACTION_EMOJIS = ['👍', '❤️', '😂', '😮', '😢', '🙏'];

  function normalizeReactions(arr) {
    return (Array.isArray(arr) ? arr : []).map(function (r) {
      return { emoji: r.emoji, members: Array.isArray(r.members) ? r.members.slice() : [] };
    }).filter(function (r) { return r.emoji && r.members.length; });
  }

  function reactionChipsInner(mid) {
    var list = state.reactionsByMsg.get(String(mid));
    if (!list || !list.length) return '';
    var selfKey = cfg.current.type + ':' + cfg.current.id;
    return list.map(function (r) {
      var count = r.members.length;
      if (!count) return '';
      var mine = r.members.indexOf(selfKey) !== -1;
      return '<button type="button" class="pg-chat__reaction-chip' + (mine ? ' pg-chat__reaction-chip--mine' : '') + '" ' +
        'data-reaction-chip data-message-id="' + escapeHtml(String(mid)) + '">' +
        '<span class="pg-chat__reaction-emoji">' + escapeHtml(r.emoji) + '</span>' +
        '<span class="pg-chat__reaction-count">' + count + '</span>' +
        '</button>';
    }).join('');
  }

  function renderReactionsFor(mid) {
    if (!elMessages) return;
    var row = elMessages.querySelector('.pg-chat__row[data-message-id="' + String(mid) + '"]');
    if (!row) return;
    var box = row.querySelector('[data-reactions]');
    if (!box) return;
    box.innerHTML = reactionChipsInner(mid);
  }

  function applyReactions(mid, reactions) {
    var key = String(mid);
    state.reactionsByMsg.set(key, normalizeReactions(reactions));
    var stored = renderedMessages.get(key);
    if (stored) stored.reactions = state.reactionsByMsg.get(key);
    renderReactionsFor(key);
  }

  function reactViaPhp(messageId, emoji) {
    apiFetchJson('react', { threadId: state.activeThreadId, messageId: messageId, emoji: emoji })
      .then(function (data) { if (data && data.ok) applyReactions(messageId, data.reactions); })
      .catch(function () { notifyUser(_pgTc('לא ניתן להגיב כרגע', null, 'reaction'), 'error'); });
  }

  function reactToMessage(messageId, emoji) {
    var payload = { threadId: state.activeThreadId, messageId: messageId, emoji: emoji };
    if (state.serverConnected && socket && typeof socket.timeout === 'function') {
      socket.timeout(5000).emit('message:react', payload, function (err, res) {
        if (res && res.ok) { applyReactions(messageId, res.reactions); return; }
        if (err || !res) { reactViaPhp(messageId, emoji); return; }
        // Explicit server rejection (e.g. invalid) — do nothing.
      });
    } else if (state.serverConnected && socket) {
      socket.emit('message:react', payload);
    } else {
      reactViaPhp(messageId, emoji);
    }
  }

  // ── Reaction picker (small emoji bar over a message) ──
  var elReactionPicker = null;

  function closeReactionPicker() {
    if (elReactionPicker) { elReactionPicker.remove(); elReactionPicker = null; }
    document.removeEventListener('click', onReactionPickerOutside, true);
    document.removeEventListener('keydown', onReactionPickerKey, true);
    if (elMessages) elMessages.removeEventListener('scroll', closeReactionPicker, true);
  }

  function onReactionPickerOutside(ev) {
    if (elReactionPicker && !elReactionPicker.contains(ev.target)) closeReactionPicker();
  }

  function onReactionPickerKey(ev) {
    if (ev.key === 'Escape') closeReactionPicker();
  }

  function openReactionPicker(anchorEl, messageId) {
    closeReactionPicker();
    elReactionPicker = document.createElement('div');
    elReactionPicker.className = 'pg-chat__reaction-picker';
    elReactionPicker.innerHTML = REACTION_EMOJIS.map(function (e) {
      return '<button type="button" class="pg-chat__reaction-pick" data-react-emoji="' + escapeHtml(e) + '">' + escapeHtml(e) + '</button>';
    }).join('');
    document.body.appendChild(elReactionPicker);
    var r = anchorEl.getBoundingClientRect();
    var pw = elReactionPicker.offsetWidth || 220;
    var ph = elReactionPicker.offsetHeight || 40;
    var top = (r.top - ph - 6 > 8) ? (r.top - ph - 6) : (r.bottom + 6);
    var left = Math.min(Math.max(8, r.right - pw), window.innerWidth - pw - 8);
    elReactionPicker.style.top = Math.max(8, top) + 'px';
    elReactionPicker.style.left = Math.max(8, left) + 'px';
    elReactionPicker.querySelectorAll('[data-react-emoji]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var emoji = btn.getAttribute('data-react-emoji');
        closeReactionPicker();
        reactToMessage(messageId, emoji);
      });
    });
    setTimeout(function () {
      document.addEventListener('click', onReactionPickerOutside, true);
      document.addEventListener('keydown', onReactionPickerKey, true);
      if (elMessages) elMessages.addEventListener('scroll', closeReactionPicker, true);
    }, 0);
  }

  // ── "מי הגיב" panel (reaction authors, grouped by emoji) ──
  var elReactionsPanel = null;

  function closeReactionsPanel() {
    if (elReactionsPanel) { elReactionsPanel.remove(); elReactionsPanel = null; }
  }

  function showMessageReactions(messageId) {
    if (!elMessages) return;
    closeReactionsPanel();
    var panel = document.createElement('div');
    panel.className = 'pg-chat__members-panel open';
    panel.innerHTML =
      '<div class="pg-chat__members-panel-header">' +
      '<div><h6 class="mb-0">' + _pgTc('תגובות', null, 'reaction') + '</h6></div>' +
      '<button type="button" class="btn btn-sm btn-link text-muted p-0 min-w-auto" id="pgChatReactionsClose" aria-label="' + _pgTc('סגור') + '"><i class="bi bi-x-lg"></i></button>' +
      '</div>' +
      '<div class="pg-chat__members-list" id="pgChatReactionsList"><div class="text-muted text-center py-4">' + _pgTc('טוען...') + '</div></div>';
    elMessages.appendChild(panel);
    elReactionsPanel = panel;
    var closeBtn = panel.querySelector('#pgChatReactionsClose');
    if (closeBtn) closeBtn.addEventListener('click', closeReactionsPanel);

    apiFetchJson('message_reactions', { threadId: state.activeThreadId, messageId: messageId }).then(function (data) {
      if (elReactionsPanel !== panel) return;
      var listEl = panel.querySelector('#pgChatReactionsList');
      if (!data || !data.ok) { if (listEl) listEl.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('לא ניתן לטעון') + '</div>'; return; }
      var groups = Array.isArray(data.groups) ? data.groups : [];
      if (!groups.length) { if (listEl) listEl.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('אין תגובות', null, 'reaction') + '</div>'; return; }
      var html = groups.map(function (g) {
        var head = '<div class="small text-muted px-3 pt-2 pb-1">' + escapeHtml(g.emoji) + ' ' + (g.members ? g.members.length : 0) + '</div>';
        var rows = (g.members || []).map(function (mm) {
          return '<div class="pg-chat__members-item">' +
            '<div class="pg-chat__members-meta">' +
            '<div class="pg-chat__members-name">' + escapeHtml(mm.name || '') + ' <span class="text-muted small">(' + roleLabel(mm.type) + ')</span></div>' +
            '</div>' +
            '<span class="ms-auto">' + escapeHtml(g.emoji) + '</span>' +
            '</div>';
        }).join('');
        return head + rows;
      }).join('');
      if (listEl) listEl.innerHTML = html;
    }).catch(function () {
      if (elReactionsPanel !== panel) return;
      var listEl = panel.querySelector('#pgChatReactionsList');
      if (listEl) listEl.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('שגיאה בטעינה') + '</div>';
    });
  }

  // DM read state: the other member's last-read pointer passed this message id.
  function isDmMessageRead(realId) {
    var reads = state.activeThreadReads;
    if (!reads || typeof reads.forEach !== 'function') return false;
    var mid = parseInt(realId, 10) || 0;
    if (!mid) return false;
    var selfKey = cfg.current.type + ':' + cfg.current.id;
    var read = false;
    reads.forEach(function (lastRead, key) {
      if (key === selfKey) return;
      if ((parseInt(lastRead, 10) || 0) >= mid) read = true;
    });
    return read;
  }

  // DM 3-state tick: 'read' (blue ✓✓), 'delivered' (grey ✓✓), or 'sent' (grey ✓).
  // Falls back to 2-state (read / sent) when the delivered column isn't present.
  function dmTickState(realId) {
    var mid = parseInt(realId, 10) || 0;
    if (!mid) return 'sent';
    if (isDmMessageRead(realId)) return 'read';
    if (!state.activeThreadDeliveredSupported) return 'sent';
    var delivered = state.activeThreadDelivered;
    if (!delivered || typeof delivered.forEach !== 'function') return 'sent';
    var selfKey = cfg.current.type + ':' + cfg.current.id;
    var isDelivered = false;
    delivered.forEach(function (ld, key) {
      if (key === selfKey) return;
      if ((parseInt(ld, 10) || 0) >= mid) isDelivered = true;
    });
    return isDelivered ? 'delivered' : 'sent';
  }

  function buildMessageEl(m, isGroup) {
    const isMe = m.sender_type === cfg.current.type && m.sender_id === cfg.current.id;
    const isSystem = m.sender_type === 'system';
    // 'mirror' is a dispatch's copy of a WhatsApp / SMS / e-mail / push message: the same school bubble
    const isBroadcast = m.sender_type === 'broadcast' || m.sender_type === 'mirror';
    const isDeleted = !!(m.deleted_at || m.is_deleted);
    const isEdited = !!(m.edited_at || m.is_edited);
    const realId = (m.id !== undefined && m.id !== null && !String(m.id).startsWith('opt_')) ? String(m.id) : '';
    // Seed reaction state from the payload before chips render. On an edit/delete
    // rebuild `m` is the stored message whose .reactions applyReactions keeps
    // current, so live reactions survive; brand-new messages seed to empty.
    if (realId) {
      state.reactionsByMsg.set(realId, normalizeReactions(m.reactions));
    }
    const div = document.createElement("div");
    if (isSystem) {
      // Genuine system events (joined/left, etc.) — rendered as a tiny
      // centered badge. Broadcasts intentionally fall through to the
      // regular bubble path below so they get the title heading + body.
      div.className = "text-center my-2";
      div.innerHTML = `<span class="badge bg-light text-muted small border">${escapeHtml(decodeMsg(m.message))}</span>`;
    } else {
      div.className = "pg-chat__row " + (isMe ? "pg-chat__row--me" : "pg-chat__row--them");
      div.dataset.mine = isMe ? "1" : "0";
      if (realId) div.dataset.messageId = realId;
      // Broadcast bubbles always sit on the "them" side (no senderId to
      // match against) and get a "school" sender label for clarity.
      let bubbleSide = isMe ? 'pg-chat__bubble--me' : 'pg-chat__bubble--them';
      if (isBroadcast) bubbleSide = 'pg-chat__bubble--them pg-chat__bubble--broadcast';
      if (isDeleted) bubbleSide += ' pg-chat__bubble--deleted';

      if (isDeleted) {
        // "Deleted for everyone" — keep the side + (group) sender label, replace
        // the body with the WhatsApp-style placeholder, drop file + actions.
        const senderNameHtml = (isGroup && !isMe)
          ? `<div class="fw-bold mb-1" style="font-size: 0.75rem; color: var(--bs-primary);">${escapeHtml(m.sender_name || _pgTc('משתמש'))}</div>`
          : '';
        div.innerHTML = `
          <div class="pg-chat__bubble ${bubbleSide}" style="padding: 0.5rem 0.75rem; font-size: 0.9rem;">
            ${senderNameHtml}
            <div class="mb-1 pg-chat__deleted-text"><i class="bi bi-slash-circle me-1"></i>${_pgTc('הודעה נמחקה')}</div>
            <div class="pg-chat__meta" style="font-size: 0.65rem;">${formatMessageTime(m.created_at)}</div>
          </div>
        `;
      } else {
        const showSender = (isBroadcast || (isGroup && !isMe));
        const senderLabel = isBroadcast
          ? _pgTc(m.sender_name || 'הודעות בית הספר')
          : (m.sender_name || _pgTc('משתמש'));
        const senderChildrenHtml = (showSender && m.sender_type === 'parent' && m.sender_children)
          ? `<div class="text-muted" style="font-size: 0.68rem; margin-top: -2px; margin-bottom: 2px;">${escapeHtml(m.sender_children)}</div>`
          : '';
        const senderNameHtml = showSender
          ? `<div class="fw-bold mb-1" style="font-size: 0.75rem; color: var(--bs-primary);">${escapeHtml(senderLabel)}</div>${senderChildrenHtml}`
          : '';
        const fileInfo = getFileFromMessage(m);
        const fileHtml = fileInfo ? renderFileAttachment(fileInfo, m.id) : '';
        const textHtml = fileInfo ? '' : renderBubbleBody(m.message || '');
        const editedHtml = isEdited ? ' <span class="pg-chat__edited">(' + _pgTc('נערך') + ')</span>' : '';
        // Show edit/delete only on your OWN real message that is still inside the
        // time window. Edit is hidden on file messages (only text can be edited).
        // The reply-gate + exact expiry are re-checked on click and authoritatively
        // enforced by the server.
        const inWindow = isMe && realId && (Date.now() - new Date(m.created_at).getTime() < EDIT_DELETE_WINDOW_MS);
        // A single "⋮" trigger opens a dropdown (עריכה / מחיקה לכולם / נקרא על ידי) —
        // keeps the bubble uncluttered on both desktop (hover) and mobile (always shown).
        // Own group messages keep the trigger past the edit window for read receipts.
        const showActions = inWindow || (isMe && realId && isGroup && !isBroadcast);
        // A reaction affordance sits on real, non-deleted messages from OTHERS
        // (you can't react to your own) — works even in a "manager writes only"
        // group so muted members can still react.
        const canReact = !!realId && !isMe;
        const reactBtnHtml = canReact
          ? '<button type="button" class="pg-chat__msg-action" data-react-trigger title="' + _pgTc('הוסף תגובה', null, 'reaction') + '" aria-label="' + _pgTc('הוסף תגובה', null, 'reaction') + '"><i class="bi bi-emoji-smile"></i></button>'
          : '';
        const menuBtnHtml = showActions
          ? '<button type="button" class="pg-chat__msg-action" data-msg-menu title="' + _pgTc('אפשרויות') + '" aria-label="' + _pgTc('אפשרויות') + '"><i class="bi bi-three-dots-vertical"></i></button>'
          : '';
        const actionsHtml = (reactBtnHtml || menuBtnHtml)
          ? '<div class="pg-chat__msg-actions">' + reactBtnHtml + menuBtnHtml + '</div>'
          : '';
        const tickState = (isMe && !isGroup && !isBroadcast && realId) ? dmTickState(realId) : '';
        const ticksHtml = tickState === 'read'
          ? ' <span class="pg-chat__ticks pg-chat__ticks--read" data-ticks="read"><i class="bi bi-check2-all"></i></span>'
          : tickState === 'delivered'
            ? ' <span class="pg-chat__ticks" data-ticks="delivered"><i class="bi bi-check2-all"></i></span>'
            : tickState === 'sent'
              ? ' <span class="pg-chat__ticks" data-ticks="sent"><i class="bi bi-check2"></i></span>'
              : '';
        const reactionsHtml = realId ? '<div class="pg-chat__reactions" data-reactions>' + reactionChipsInner(realId) + '</div>' : '';
        // The actions sit as a sibling of the bubble (not inside it) so the
        // bubble's overflow:hidden can never clip them.
        div.innerHTML = `
          ${actionsHtml}
          <div class="pg-chat__bubble ${bubbleSide}" style="padding: 0.5rem 0.75rem; font-size: 0.9rem;">
            ${senderNameHtml}
            ${fileHtml ? '<div class="mb-1">' + fileHtml + '</div>' : ''}
            ${textHtml ? '<div class="mb-1" style="overflow-wrap: break-word;">' + textHtml + '</div>' : ''}
            <div class="pg-chat__meta" style="font-size: 0.65rem;">${formatMessageTime(m.created_at)}${editedHtml}${ticksHtml}</div>
          </div>
          ${reactionsHtml}
        `;
      }
    }
    if (m.id && String(m.id).startsWith('opt_')) {
      div.setAttribute('data-optimistic-id', m.id);
    }
    if (realId) {
      renderedMessages.set(realId, m);
    }
    loadAttachmentImages(div);
    return div;
  }

  // Image attachments load in the background behind a progress line: a bare <img> of a
  // 2MB photo paints one strip at a time on a phone (470443, 08/10). download.php?stream=1
  // answers from our own origin, which the progress needs — the S3 bucket sends no CORS
  // headers, so after its redirect the browser would hide the byte count.
  function attachmentBlobUrl(blob) {
    const url = URL.createObjectURL(blob);
    attachmentBlobUrls.add(url);
    return url;
  }

  function loadAttachmentImages(root) {
    root.querySelectorAll('img[data-message-file]').forEach(function (img) {
      const messageId = img.getAttribute('data-message-file');
      img.removeAttribute('data-message-file');
      const box = img.previousElementSibling;
      const show = function (src) {
        img.addEventListener('load', revealAttachmentImage, { once: true });
        img.addEventListener('error', revealAttachmentImage, { once: true });
        img.src = src;
      };
      const local = localAttachmentBlobs.get(messageId);
      if (local) {
        localAttachmentBlobs.delete(messageId);
        const url = attachmentBlobUrl(local);
        img.setAttribute('data-lightbox-src', url);
        show(url);
        return;
      }
      const request = function (retried) {
        const xhr = new XMLHttpRequest();
        xhr.open('GET', '/chat/download.php?id=' + encodeURIComponent(messageId) + '&stream=1');
        xhr.responseType = 'blob';
        xhr.addEventListener('progress', function (e) {
          if (box && e.lengthComputable && e.total > 0) setUploadProgress(box, e.loaded / e.total);
        });
        xhr.onload = function () {
          if (!img.isConnected) return;
          if (xhr.status === 401 && !retried) {
            // The session expired under the open page: get it back, then this image once more.
            restoreChatSession().then(function () {
              if (img.isConnected) request(true);
            });
            return;
          }
          if (xhr.status === 200 && xhr.response && xhr.response.size > 0) {
            const url = attachmentBlobUrl(xhr.response);
            img.setAttribute('data-lightbox-src', url); // the lightbox shows it without a second download
            show(url);
          } else {
            show(img.getAttribute('data-lightbox-src')); // the S3 redirect, as before
          }
        };
        xhr.onerror = function () {
          if (img.isConnected) show(img.getAttribute('data-lightbox-src'));
        };
        xhr.send();
      };
      request(false);
    });
  }

  // download.php serves both panels from one address, so it cannot tell which remember-me cookie
  // to sign back in with; this panel's threads_api.php can, and does on any call. One call serves
  // every image of the thread that came back 401 at the same time.
  let chatSessionRestore = null;
  function restoreChatSession() {
    if (!chatSessionRestore) {
      chatSessionRestore = fetch(apiBase + '?action=unread_count', { credentials: 'same-origin' })
        .catch(function () {})
        .then(function () {
          setTimeout(function () { chatSessionRestore = null; }, 5000);
        });
    }
    return chatSessionRestore;
  }

  // Swap the placeholder for the image, keeping the thread pinned to the bottom only
  // when it already was there (someone reading older messages is not yanked down).
  function revealAttachmentImage(ev) {
    const img = ev.target;
    const atBottom = !!elMessages && (elMessages.scrollHeight - elMessages.scrollTop - elMessages.clientHeight < 80);
    const box = img.previousElementSibling;
    if (box && box.classList.contains('pg-chat__img-loading')) box.remove();
    img.classList.remove('d-none');
    if (atBottom) elMessages.scrollTop = elMessages.scrollHeight;
  }

  function appendMessage(m, scroll = true, isGroup = false) {
    if (!elMessages) return;
    // Remove no messages placeholder if it exists
    if (elMessages.querySelector(".text-muted.text-center")) {
      elMessages.innerHTML = "";
    }
    var div = buildMessageEl(m, isGroup);
    // An upload in flight gets its id only once stored, so whatever lands meanwhile
    // (a text whose PHP send answers late, a reply) goes above it, not below.
    const pendingUpload = elMessages.querySelector('.pg-chat__row--uploading');
    if (pendingUpload) {
      elMessages.insertBefore(div, pendingUpload);
    } else {
      elMessages.appendChild(div);
    }
    if (scroll) elMessages.scrollTop = elMessages.scrollHeight;
  }

  // ── Edit / delete-for-everyone (WhatsApp-style) ──
  function isWithinEditWindow(createdAt) {
    var t = new Date(createdAt).getTime();
    if (isNaN(t)) return false;
    return (Date.now() - t) < EDIT_DELETE_WINDOW_MS;
  }

  // The window also closes once anyone else has sent a message after this one.
  function hasLaterReply(rowEl) {
    if (!rowEl) return false;
    var sib = rowEl.nextElementSibling;
    while (sib) {
      if (sib.classList && sib.classList.contains('pg-chat__row') && sib.dataset && sib.dataset.mine === '0') {
        return true;
      }
      sib = sib.nextElementSibling;
    }
    return false;
  }

  function canModifyOwnMessage(id, rowEl) {
    var m = renderedMessages.get(String(id));
    if (!m) return false;
    if (m.deleted_at || m.is_deleted) return false;
    if (!isWithinEditWindow(m.created_at)) return false;
    if (hasLaterReply(rowEl)) return false;
    return true;
  }

  // Re-render a single bubble in place after an edit/delete (local or pushed).
  function updateRenderedMessage(id, updates) {
    var key = String(id);
    if (typeof closeMsgMenu === 'function' && msgMenuTarget && String(msgMenuTarget.id) === key) closeMsgMenu();
    var m = renderedMessages.get(key);
    if (!m || !elMessages) return;
    Object.keys(updates).forEach(function (k) { m[k] = updates[k]; });
    var oldEl = elMessages.querySelector('[data-message-id="' + key + '"]');
    if (!oldEl) return;
    var thread = state.threads.find(function (t) { return t.id === state.activeThreadId; });
    var isGroup = thread ? !!thread.is_group : false;
    // If this is the thread's most recent message, keep the conversation-list preview in
    // sync (an edit/delete of the latest message would otherwise stay stale until reload).
    var renderedEls = elMessages.querySelectorAll('[data-message-id]');
    var isLatest = renderedEls.length > 0 && renderedEls[renderedEls.length - 1] === oldEl;
    oldEl.replaceWith(buildMessageEl(m, isGroup));
    if (isLatest && thread) {
      thread.last_text = m.message || thread.last_text;
      renderList();
    }
  }

  function startEditMessage(id, rowEl) {
    var m = renderedMessages.get(String(id));
    if (!m) return;
    if (!canModifyOwnMessage(id, rowEl)) {
      notifyUser(_pgTc('לא ניתן לערוך הודעה זו יותר'), 'info');
      return;
    }
    state.editingMessageId = id;
    if (elInput) {
      elInput.value = decodeMsg(m.message || '');
      elInput.style.height = 'auto';
      elInput.style.height = Math.min(elInput.scrollHeight, 120) + 'px';
      elInput.focus();
    }
    if (elEditBanner) elEditBanner.classList.add('open');
  }

  function cancelEditMessage() {
    if (!state.editingMessageId) {
      if (elEditBanner) elEditBanner.classList.remove('open');
      return;
    }
    state.editingMessageId = null;
    if (elEditBanner) elEditBanner.classList.remove('open');
    if (elInput) {
      elInput.value = '';
      elInput.style.height = 'auto';
    }
  }

  function editMessageViaPhp(id, txt) {
    return apiFetchJson('edit', { threadId: state.activeThreadId, messageId: id, message: txt })
      .then(function (data) {
        updateRenderedMessage(id, { message: txt, edited_at: (data && data.edited_at) || new Date().toISOString() });
      })
      .catch(function (e) {
        var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('לא ניתן לערוך את ההודעה');
        notifyUser(msg, 'error');
      });
  }

  function deleteMessageViaPhp(id) {
    return apiFetchJson('delete', { threadId: state.activeThreadId, messageId: id })
      .then(function () {
        updateRenderedMessage(id, { deleted_at: new Date().toISOString(), message: _pgTc('הודעה נמחקה') });
      })
      .catch(function (e) {
        var msg = (e && e.payload && e.payload.message) ? e.payload.message : _pgTc('לא ניתן למחוק את ההודעה');
        notifyUser(msg, 'error');
      });
  }

  function submitMessageEdit(id, txt) {
    var payload = { threadId: state.activeThreadId, messageId: id, message: txt };
    if (state.serverConnected && socket && typeof socket.timeout === 'function') {
      // Ack so an edit isn't silently dropped if the server is up but lacks the
      // handler (e.g. not yet restarted) or errors — fall back to the PHP endpoint.
      socket.timeout(5000).emit('message:edit', payload, function (err, res) {
        if (res && res.ok) return;                                            // success — broadcast updated the bubble
        if (res && res.message) { notifyUser(_pgServerText(res.message), 'error'); return; } // explicit server reject (e.g. window closed)
        editMessageViaPhp(id, txt);                                           // timeout / no handler — fall back
      });
    } else if (state.serverConnected && socket) {
      socket.emit('message:edit', payload);                                   // old socket.io w/o ack — rely on broadcast
    } else {
      editMessageViaPhp(id, txt);
    }
    cancelEditMessage();
  }

  function confirmDeleteMessage(id, rowEl) {
    if (!canModifyOwnMessage(id, rowEl)) {
      notifyUser(_pgTc('לא ניתן למחוק הודעה זו יותר'), 'info');
      return;
    }
    var doDelete = function () {
      var payload = { threadId: state.activeThreadId, messageId: id };
      if (state.serverConnected && socket && typeof socket.timeout === 'function') {
        socket.timeout(5000).emit('message:delete', payload, function (err, res) {
          if (res && res.ok) return;
          if (res && res.message) { notifyUser(_pgServerText(res.message), 'error'); return; }
          deleteMessageViaPhp(id);
        });
      } else if (state.serverConnected && socket) {
        socket.emit('message:delete', payload);
      } else {
        deleteMessageViaPhp(id);
      }
    };
    if (typeof confirmAction === 'function') {
      confirmAction(_pgTc('למחוק את ההודעה לכולם?'), { danger: true, confirmText: _pgTc('מחק'), cancelText: _pgTc('ביטול') })
        .then(function (ok) { if (ok) doDelete(); });
    } else {
      doDelete();
    }
  }

  // ── "נקרא על ידי" panel (group read receipts, sender-only) ──
  var elReadersPanel = null;

  function closeMessageReadersPanel() {
    if (elReadersPanel) { elReadersPanel.remove(); elReadersPanel = null; }
  }

  function showMessageReaders(messageId) {
    if (!elMessages) return;
    closeMessageReadersPanel();
    var panel = document.createElement('div');
    panel.className = 'pg-chat__members-panel open';
    panel.innerHTML =
      '<div class="pg-chat__members-panel-header">' +
      '<div>' +
      '<h6 class="mb-0">' + _pgTc('נקרא על ידי') + '</h6>' +
      '<small class="text-muted" id="pgChatReadersCount">' + _pgTc('טוען...') + '</small>' +
      '</div>' +
      '<button type="button" class="btn btn-sm btn-link text-muted p-0 min-w-auto" id="pgChatReadersClose" aria-label="' + _pgTc('סגור') + '"><i class="bi bi-x-lg"></i></button>' +
      '</div>' +
      '<div class="pg-chat__members-list" id="pgChatReadersList"><div class="text-muted text-center py-4">' + _pgTc('טוען...') + '</div></div>';
    elMessages.appendChild(panel);
    elReadersPanel = panel;
    var readersCloseBtn = panel.querySelector('#pgChatReadersClose');
    if (readersCloseBtn) readersCloseBtn.addEventListener('click', closeMessageReadersPanel);

    apiFetchJson('message_readers', { threadId: state.activeThreadId, messageId: messageId }).then(function (data) {
      if (elReadersPanel !== panel) return;
      var countEl = panel.querySelector('#pgChatReadersCount');
      var listEl = panel.querySelector('#pgChatReadersList');
      if (!data || !data.ok) {
        if (listEl) listEl.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('לא ניתן לטעון את הנתונים') + '</div>';
        return;
      }
      var readers = Array.isArray(data.readers) ? data.readers : [];
      if (countEl) countEl.textContent = _pgTc('נקרא על ידי {read} מתוך {total}', { read: (data.read_count || 0), total: (data.total || readers.length) });
      // Who read and who did not is the member list again — a manager's; the sender gets the count.
      if (data.names_hidden) {
        if (listEl) listEl.innerHTML = '';
        return;
      }
      var rowHtml = function (r, read) {
        return '<div class="pg-chat__members-item' + (read ? '' : ' opacity-50') + '">' +
          '<div class="pg-chat__members-meta">' +
          '<div class="pg-chat__members-name">' + escapeHtml(r.name || '') + ' <span class="text-muted small">(' + roleLabel(r.type) + ')</span></div>' +
          '</div>' +
          (read ? '<span class="pg-chat__ticks pg-chat__ticks--read ms-auto"><i class="bi bi-check2-all"></i></span>' : '') +
          '</div>';
      };
      var readRows = readers.filter(function (r) { return !!r.read; });
      var unreadRows = readers.filter(function (r) { return !r.read; });
      var html = readRows.map(function (r) { return rowHtml(r, true); }).join('');
      if (unreadRows.length) {
        html += '<div class="small text-muted px-3 pt-2 pb-1">' + _pgTc('טרם קראו') + '</div>' +
          unreadRows.map(function (r) { return rowHtml(r, false); }).join('');
      }
      if (!html) html = '<div class="text-muted text-center py-4">' + _pgTc('אין משתתפים נוספים בקבוצה') + '</div>';
      if (listEl) listEl.innerHTML = html;
    }).catch(function () {
      if (elReadersPanel !== panel) return;
      var listEl = panel.querySelector('#pgChatReadersList');
      if (listEl) listEl.innerHTML = '<div class="text-muted text-center py-4">' + _pgTc('שגיאה בטעינת הנתונים') + '</div>';
    });
  }

  // ── Per-message options dropdown (⋮ → עריכה / מחיקה לכולם / נקרא על ידי) ──
  var elMsgMenu = null;
  var msgMenuTarget = null;

  function closeMsgMenu() {
    if (elMsgMenu) { elMsgMenu.remove(); elMsgMenu = null; }
    msgMenuTarget = null;
    document.removeEventListener('click', onMsgMenuOutside, true);
    document.removeEventListener('keydown', onMsgMenuKey, true);
    if (elMessages) elMessages.removeEventListener('scroll', closeMsgMenu, true);
  }

  function onMsgMenuOutside(ev) {
    if (elMsgMenu && !elMsgMenu.contains(ev.target)) closeMsgMenu();
  }

  function onMsgMenuKey(ev) {
    if (ev.key === 'Escape') closeMsgMenu();
  }

  function openMsgMenu(triggerEl, id, rowEl) {
    closeMsgMenu();
    var m = renderedMessages.get(String(id));
    var hasFile = !!(m && getFileFromMessage(m));
    var canModify = canModifyOwnMessage(id, rowEl);
    var menuThread = state.threads.find(function (t) { return t.id === state.activeThreadId; });
    var isGroupThread = !!(menuThread && menuThread.is_group);
    var isMine = !!(rowEl && rowEl.dataset && rowEl.dataset.mine === '1');
    var isDeletedMsg = !!(m && (m.deleted_at || m.is_deleted));
    var showReaders = isGroupThread && isMine && m && !isDeletedMsg && !isBroadcastThread(menuThread);
    var menuHtml =
      (canModify && !hasFile ? '<button type="button" class="pg-chat__msg-menu-item" data-menu-act="edit"><i class="bi bi-pencil me-2"></i>' + _pgTc('עריכה') + '</button>' : '') +
      (canModify ? '<button type="button" class="pg-chat__msg-menu-item text-danger" data-menu-act="delete"><i class="bi bi-trash me-2"></i>' + _pgTc('מחיקה לכולם') + '</button>' : '') +
      (showReaders ? '<button type="button" class="pg-chat__msg-menu-item" data-menu-act="readers"><i class="bi bi-check2-all me-2"></i>' + _pgTc('נקרא על ידי') + '</button>' : '');
    if (!menuHtml) {
      notifyUser(_pgTc('לא ניתן לבצע פעולות על הודעה זו יותר'), 'info');
      return;
    }
    msgMenuTarget = { id: id, rowEl: rowEl };
    // Appended to <body> (not inside the widget) so the widget's overflow can't clip it.
    elMsgMenu = document.createElement('div');
    elMsgMenu.className = 'pg-chat__msg-menu';
    elMsgMenu.innerHTML = menuHtml;
    document.body.appendChild(elMsgMenu);
    // Position near the trigger; align the menu's right edge to it (RTL), flip up if no room below.
    var r = triggerEl.getBoundingClientRect();
    var mw = elMsgMenu.offsetWidth || 160;
    var mh = elMsgMenu.offsetHeight || 80;
    var top = (r.bottom + mh + 4 > window.innerHeight) ? (r.top - mh - 4) : (r.bottom + 4);
    elMsgMenu.style.top = Math.max(8, top) + 'px';
    elMsgMenu.style.left = Math.max(8, r.right - mw) + 'px';
    elMsgMenu.querySelectorAll('[data-menu-act]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var act = btn.getAttribute('data-menu-act');
        var tId = msgMenuTarget ? msgMenuTarget.id : id;
        var tRow = msgMenuTarget ? msgMenuTarget.rowEl : rowEl;
        closeMsgMenu();
        if (act === 'edit') startEditMessage(tId, tRow);
        else if (act === 'delete') confirmDeleteMessage(tId, tRow);
        else if (act === 'readers') showMessageReaders(tId);
      });
    });
    // Defer outside-click binding so the opening click doesn't immediately close it.
    setTimeout(function () {
      document.addEventListener('click', onMsgMenuOutside, true);
      document.addEventListener('keydown', onMsgMenuKey, true);
      if (elMessages) elMessages.addEventListener('scroll', closeMsgMenu, true);
    }, 0);
  }

  if (elMessages) {
    elMessages.addEventListener('click', function (ev) {
      if (!ev.target || !ev.target.closest) return;
      var menuTrigger = ev.target.closest('[data-msg-menu]');
      if (menuTrigger) {
        ev.preventDefault();
        ev.stopPropagation();
        var menuRow = menuTrigger.closest('.pg-chat__row');
        if (!menuRow || !menuRow.dataset || !menuRow.dataset.messageId) return;
        openMsgMenu(menuTrigger, menuRow.dataset.messageId, menuRow);
        return;
      }
      var reactTrigger = ev.target.closest('[data-react-trigger]');
      if (reactTrigger) {
        ev.preventDefault();
        ev.stopPropagation();
        var reactRow = reactTrigger.closest('.pg-chat__row');
        if (!reactRow || !reactRow.dataset || !reactRow.dataset.messageId) return;
        openReactionPicker(reactTrigger, reactRow.dataset.messageId);
        return;
      }
      var chip = ev.target.closest('[data-reaction-chip]');
      if (chip) {
        ev.preventDefault();
        ev.stopPropagation();
        var mid = chip.getAttribute('data-message-id');
        if (mid) showMessageReactions(mid);
      }
    });

    // Long-press (touch) anywhere on a bubble opens the reaction picker.
    var longPressTimer = null;
    var longPressRow = null;
    var clearLongPress = function () {
      if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
      longPressRow = null;
    };
    elMessages.addEventListener('touchstart', function (ev) {
      var bubble = ev.target && ev.target.closest ? ev.target.closest('.pg-chat__bubble') : null;
      if (!bubble) return;
      var row = bubble.closest('.pg-chat__row');
      if (!row || !row.dataset || !row.dataset.messageId || row.querySelector('.pg-chat__bubble--deleted')) return;
      if (row.dataset.mine === '1') return; // no reacting to your own messages
      longPressRow = row;
      longPressTimer = setTimeout(function () {
        if (longPressRow === row) openReactionPicker(bubble, row.dataset.messageId);
        clearLongPress();
      }, 500);
    }, { passive: true });
    elMessages.addEventListener('touchend', clearLongPress);
    elMessages.addEventListener('touchmove', clearLongPress);
    elMessages.addEventListener('touchcancel', clearLongPress);
  }

  if (elEditCancel) elEditCancel.addEventListener('click', cancelEditMessage);

  // Socket events
  socket.on("connect", () => {
    console.log("Socket connected to:", cfg.chatServerUrl);
    setStatus(_pgTc("מחבר..."));
    setServerConnected(false); // Not authenticated yet
    if (cfg.socketToken) {
      socket.emit("auth", { token: cfg.socketToken });
    } else {
      console.error("No socket token available");
      setStatus(_pgTc("אין טוקן אימות"));
      setServerConnected(false);
      if (elMessages) {
        elMessages.innerHTML = '<div class="alert alert-warning m-3">' + _pgTc('שגיאת אימות: אין טוקן זמין. אנא בדוק את הגדרות השרת.') + '</div>';
      }
      if (elList) {
        elList.innerHTML = '<div class="p-4 text-center text-danger"><strong>' + _pgTc('שגיאת שרת:') + '</strong> ' + _pgTc('אין טוקן אימות זמין.') + '</div>';
      }
    }
  });

  socket.on("connect_error", (error) => {
    console.error("Socket connection error:", error);
    setStatus(_pgTc("שגיאת חיבור"));
    setServerConnected(false);
    runSocketDiagnostics(error);
  });

  socket.on("disconnect", (reason) => {
    console.log("[PgChat " + new Date().toLocaleTimeString() + "] Socket disconnected — reason:", reason);
    setStatus(_pgTc("מתחבר מחדש..."));
    setServerConnected(false);
  });

  socket.io.on("reconnect_attempt", (attempt) => {
    console.log("[PgChat " + new Date().toLocaleTimeString() + "] Reconnect attempt #" + attempt);
  });

  socket.io.on("reconnect_failed", () => {
    console.log("[PgChat " + new Date().toLocaleTimeString() + "] Reconnect failed — all attempts exhausted");
  });

  socket.io.on("reconnect", (attempt) => {
    console.log("[PgChat " + new Date().toLocaleTimeString() + "] Reconnected after " + attempt + " attempts");
  });

  socket.on("auth_ok", () => {
    setStatus("");
    setServerConnected(true);
    socket.emit("threads:list");
    socket.emit("online:request");

    // Rejoin active thread room after reconnection
    if (state.activeThreadId) {
      socket.emit("thread:open", { threadId: state.activeThreadId });
    }

    if (cfg.directOpen && cfg.directOpen.type && cfg.directOpen.id) {
      socket.emit("dm:open", {
        memberType: cfg.directOpen.type,
        memberId: cfg.directOpen.id
      });
      cfg.directOpen = null;
      toggleWidget(true);
    } else if (cfg.directOpen && cfg.directOpen.threadId) {
      openThread(parseInt(cfg.directOpen.threadId), _pgTc("טוען..."));
      cfg.directOpen = null;
      toggleWidget(true);
    }
    renderList();
  });

  socket.on("auth_error", (e) => {
    console.error("Auth error:", e);
    setStatus(_pgTc("שגיאת אימות"));
    setServerConnected(false);
    try { socket.close(); } catch (e) { }
  });

  socket.on("online:users", (payload) => {
    var prevOnline = new Set(state.onlineUsers.keys());
    state.onlineUsers.clear();
    var nowOnline = new Set();
    (payload?.users || []).forEach((u) => {
      var normalizedType = normalizeMemberType(u.type) || String(u.type || '').trim().toLowerCase();
      var normalizedId = String(u.id == null ? '' : u.id).trim();
      if (!normalizedType || !normalizedId) return;
      var key = `${normalizedType}:${normalizedId}`;
      state.onlineUsers.set(key, u);
      nowOnline.add(key);
      // Mark current time as last seen for anyone who is online
      state.lastSeenAt.set(key, new Date());
    });
    // For users who were online before but are now offline, their lastSeenAt is already set from the previous tick


    // Update active thread subtitle if its a DM
    if (state.activeThreadId) {
      const thread = state.threads.find(t => t.id === state.activeThreadId);
      var other = getThreadOtherMember(thread);
      if (thread && other) {
        const isUserOnline = isOnline(other.type, other.id);
        if (elSubtitle) elSubtitle.textContent = getPresenceSubtitle(thread, isUserOnline);
        if (elActiveAvatar) {
          elActiveAvatar.className = "avatar avatar-sm ms-2 " + getOnlineStatusClass(other.type, other.id);
        }
      }
    }

    renderList();
  });

  socket.on("threads:list:result", (payload) => {
    if (!state.serverConnected) return;
    var _newThreads = payload?.threads || [];
    // Don't overwrite existing threads with empty response (protects against token/session expiry)
    if (_newThreads.length === 0 && state.threads.length > 0) return;
    state.threads = _newThreads;
    // Extract last_seen into lastSeenAt map
    state.threads.forEach(function (t) {
      if (t.last_seen && t.other_type && t.other_id) {
        var key = (normalizeMemberType(t.other_type) || t.other_type) + ':' + String(t.other_id);
        state.lastSeenAt.set(key, new Date(t.last_seen));
      }
    });
    if (state.activeThreadId) {
      const active = state.threads.find((t) => String(t.id) === String(state.activeThreadId));
      if (active && active.is_group) {
        state.activeThreadMuted = !!active.is_muted;
        updateActiveGroupSubtitle();
        renderHeaderThreadActions();
      }
    }
    state.threadsLoaded = true;
    renderList();
    updateBadge();
    loadParentChildren();
  });

  socket.on("thread:open:result", (payload) => {
    if (openFallbackTimeout) { clearTimeout(openFallbackTimeout); openFallbackTimeout = null; }
    // Message history is always loaded from PHP (fetchMessagesFromPHP) so we do not overwrite with socket data
  });

  socket.on("thread:opened", (payload) => {
    if (openFallbackTimeout) { clearTimeout(openFallbackTimeout); openFallbackTimeout = null; }
    state.tab = "threads";
    socket.emit("threads:list");
    if (payload?.thread) {
      openThread(payload.thread.id, payload.thread.title);
    }
  });

  socket.on("error", (e) => {
    setStatus("");
    // Remove optimistic message if the send was rejected (e.g. rate limit)
    if (lastOptimisticId && elMessages) {
      var optEl = elMessages.querySelector('[data-optimistic-id="' + lastOptimisticId + '"]');
      if (optEl) optEl.remove();
      lastOptimisticId = null;
    }
    notifyUser(e?.message ? _pgServerText(e.message) : _pgTc("אירעה שגיאה"), 'error');
  });

  socket.on("message:new", (payload) => {
    const threadId = payload?.thread_id;
    if (!threadId) return;

    // Clear optimistic tracking — message was accepted by server
    lastOptimisticId = null;
    // Skip if this is our own message that was already shown optimistically
    var isOwnMessage = payload.sender_type === cfg.current.type && String(payload.sender_id) === String(cfg.current.id);
    var dupKey = threadId + ':' + (payload.message || '');
    var isDuplicate = isOwnMessage && optimisticSentIds.has(dupKey);
    if (isDuplicate) {
      optimisticSentIds.delete(dupKey);
      // Promote the optimistic bubble to a real one so it carries the server
      // message id — this is what makes edit/delete work on a just-sent message
      // without waiting for a reload.
      var optId = optimisticByKey.get(dupKey);
      optimisticByKey.delete(dupKey);
      if (optId && elMessages && state.activeThreadId === threadId) {
        var optEl = elMessages.querySelector('[data-optimistic-id="' + optId + '"]');
        if (optEl) {
          var threadP = state.threads.find(function (t) { return t.id === threadId; });
          optEl.replaceWith(buildMessageEl(payload, threadP ? !!threadP.is_group : false));
        }
      }
    }

    let thread = state.threads.find(t => t.id === threadId);
    if (thread) {
      thread.last_text = payload.message || thread.last_text;
      thread.last_at = payload.created_at || thread.last_at;
      if (state.activeThreadId !== threadId) {
        thread.unread_count = (thread.unread_count || 0) + 1;
      }
    }

    updateBadge();
    renderList();

    if (state.activeThreadId === threadId && !isDuplicate) {
      const isGroup = thread ? !!thread.is_group : false;
      appendMessage(payload, true, isGroup);
      socket.emit("thread:open", { threadId });
    }
  });

  socket.on("message:edited", (payload) => {
    if (!payload || !payload.id) return;
    updateRenderedMessage(payload.id, {
      message: payload.message,
      edited_at: payload.edited_at || new Date().toISOString(),
    });
  });

  socket.on("message:deleted", (payload) => {
    if (!payload || !payload.id) return;
    updateRenderedMessage(payload.id, {
      deleted_at: new Date().toISOString(),
      message: _pgTc('הודעה נמחקה'),
    });
  });

  socket.on("reaction:update", (payload) => {
    if (!payload || !payload.message_id) return;
    if (String(state.activeThreadId) !== String(payload.thread_id)) return;
    applyReactions(payload.message_id, payload.reactions);
  });

  socket.on("read:update", (payload) => {
    if (!payload || !payload.thread_id) return;
    if (String(state.activeThreadId) !== String(payload.thread_id)) return;
    var readKey = (payload.member_type || '') + ':' + (payload.member_id || '');
    var selfKey = cfg.current.type + ':' + cfg.current.id;
    if (readKey === selfKey) return;
    var lastReadId = parseInt(payload.last_read_id, 10) || 0;
    if (!lastReadId) return;
    if (!state.activeThreadReads || typeof state.activeThreadReads.set !== 'function') {
      state.activeThreadReads = new Map();
    }
    var prev = parseInt(state.activeThreadReads.get(readKey), 10) || 0;
    if (lastReadId <= prev) return;
    state.activeThreadReads.set(readKey, lastReadId);
    // DM: flip ✓ → ✓✓ in place on own bubbles up to the new pointer.
    var readThread = state.threads.find(function (t) { return String(t.id) === String(payload.thread_id); });
    if (readThread && readThread.is_group) return;
    if (!elMessages) return;
    elMessages.querySelectorAll('.pg-chat__row[data-mine="1"][data-message-id]').forEach(function (rowEl) {
      var mid = parseInt(rowEl.dataset.messageId, 10) || 0;
      if (!mid || mid > lastReadId) return;
      var tick = rowEl.querySelector('[data-ticks]');
      if (tick && tick.getAttribute('data-ticks') !== 'read') {
        tick.setAttribute('data-ticks', 'read');
        tick.classList.add('pg-chat__ticks--read');
        tick.innerHTML = '<i class="bi bi-check2-all"></i>';
      }
    });
  });

  socket.on("delivered:update", (payload) => {
    if (!payload || !payload.thread_id) return;
    if (String(state.activeThreadId) !== String(payload.thread_id)) return;
    var dKey = (payload.member_type || '') + ':' + (payload.member_id || '');
    var selfKey = cfg.current.type + ':' + cfg.current.id;
    if (dKey === selfKey) return;
    var lastDeliveredId = parseInt(payload.last_delivered_id, 10) || 0;
    if (!lastDeliveredId) return;
    if (!state.activeThreadDelivered || typeof state.activeThreadDelivered.set !== 'function') {
      state.activeThreadDelivered = new Map();
    }
    state.activeThreadDeliveredSupported = true;
    var prevD = parseInt(state.activeThreadDelivered.get(dKey), 10) || 0;
    if (lastDeliveredId <= prevD) return;
    state.activeThreadDelivered.set(dKey, lastDeliveredId);
    // DM: upgrade single ✓ → grey ✓✓ (delivered). Leave blue ✓✓ (read) alone.
    var dThread = state.threads.find(function (t) { return String(t.id) === String(payload.thread_id); });
    if (dThread && dThread.is_group) return;
    if (!elMessages) return;
    elMessages.querySelectorAll('.pg-chat__row[data-mine="1"][data-message-id]').forEach(function (rowEl) {
      var mid = parseInt(rowEl.dataset.messageId, 10) || 0;
      if (!mid || mid > lastDeliveredId) return;
      var tick = rowEl.querySelector('[data-ticks]');
      if (tick && tick.getAttribute('data-ticks') === 'sent') {
        tick.setAttribute('data-ticks', 'delivered');
        tick.innerHTML = '<i class="bi bi-check2-all"></i>';
      }
    });
  });

  // UI bindings
  elToggle?.addEventListener("click", () => toggleWidget());
  elClose?.addEventListener("click", () => toggleWidget(false));

  function setMaximized(isMax) {
    if (!elWidget) return;
    elWidget.classList.toggle("pg-chat-maximized", isMax);
    document.querySelectorAll(".pg-chat-maximize-btn").forEach((btn) => {
      const ic = btn.querySelector("i");
      if (ic) ic.className = isMax ? "bi bi-fullscreen-exit text-primary" : "bi bi-arrows-fullscreen text-primary";
      btn.title = isMax ? _pgTc("הקטן") : _pgTc("הגדל");
    });
    try { localStorage.setItem("pg_chat_maximized", isMax ? "1" : "0"); } catch (e) {}
  }
  document.querySelectorAll(".pg-chat-maximize-btn").forEach((btn) => {
    btn.addEventListener("click", () => setMaximized(!elWidget.classList.contains("pg-chat-maximized")));
  });
  // Remember the user's enlarged/normal choice across page loads (desktop only —
  // the mobile media query ignores the class, so it's a no-op on phones).
  try { if (localStorage.getItem("pg_chat_maximized") === "1") setMaximized(true); } catch (e) {}

  const elCloseMain = document.getElementById("pgChatCloseMain");
  if (elCloseMain) elCloseMain.addEventListener("click", () => toggleWidget(false));
  elBack?.addEventListener("click", function() {
    // If an in-conversation overlay is open (readers / reactions / members),
    // back closes that first and returns to the conversation — not the list.
    if (elReactionsPanel) { closeReactionsPanel(); return; }
    if (elReadersPanel) { closeMessageReadersPanel(); return; }
    if (elGroupMembersPanel && elGroupMembersPanel.classList.contains('open')) { hideGroupMembersPanel(); return; }
    if (cfg.standaloneSupport) {
      openSupportWidget();
    } else {
      showSidebar();
    }
  });

  document.querySelectorAll("[data-tab]").forEach((btn) => {
    btn.addEventListener("click", () => switchTab(btn.getAttribute("data-tab")));
  });

  if (elSearch) {
    var searchDebounceTimer = null;
    elSearch.addEventListener("input", function () {
      if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(function () {
        renderList();
        searchContactsOnServer((elSearch.value || "").trim().toLowerCase());
      }, 250);
    });
  }

  // Infinite scroll - load older messages when scrolling to top
  if (elMessages) {
    elMessages.addEventListener('scroll', function () {
      if (elMessages.scrollTop < 60 && state.hasMoreMessages && !state.loadingMoreMessages && state.activeThreadId) {
        loadOlderMessages();
      }
    });
  }

  if (elInput) {
    elInput.addEventListener("input", () => {
      elInput.style.height = "auto";
      elInput.style.height = Math.min(elInput.scrollHeight, 120) + "px";
    });

    elInput.addEventListener("keydown", (e) => {
      // A phone keyboard has no Shift+Enter, so there its Enter key adds a line and the send
      // button sends (as in WhatsApp); with a physical keyboard Enter still sends.
      const touchKeyboard = !!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches);
      if (e.key === "Enter" && !e.shiftKey && !touchKeyboard) {
        e.preventDefault();
        elForm.dispatchEvent(new Event("submit"));
      }
    });
  }

  // Track optimistically appended messages to avoid duplicates from server echo
  var optimisticSentIds = new Set();
  // Track the last optimistic message ID so we can remove it on send error
  var lastOptimisticId = null;

  if (elForm) {
    elForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const txt = (elInput?.value || "").trim();
      // When editing an existing message, the composer submits the edit instead
      // of sending a new message.
      if (state.editingMessageId) {
        if (txt) submitMessageEdit(state.editingMessageId, txt);
        else cancelEditMessage();
        return;
      }
      if (!txt || !state.activeThreadId) return;

      // Belt-and-braces: openThread() already calls setComposerVisible(false)
      // for broadcast threads, but if the is_broadcast flag never arrived
      // (legacy threads created before chat_thread_type existed, or DOM
      // tampering) the composer can still appear. Refuse the send and tell
      // the user why instead of silently dropping the message.
      var activeThread = state.threads.find(function (t) { return t.id === state.activeThreadId; });
      if (activeThread && isBroadcastThread(activeThread)) {
        notifyUser(_pgTc('זוהי הודעה חד-כיוונית — לא ניתן להשיב כאן.'), 'info');
        return;
      }

      if (state.serverConnected) {
        // Optimistically show the message immediately
        var optimisticId = 'opt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
        // Key on the server-normalized text (the server strips <...> tags before echoing
        // message:new), so a message containing '<' still dedupes and promotes correctly.
        var optimisticKey = state.activeThreadId + ':' + txt.replace(/<[^>]*>?/gm, '').substring(0, 1000).trim();
        optimisticSentIds.add(optimisticKey);
        optimisticByKey.set(optimisticKey, optimisticId);
        var thread = activeThread || state.threads.find(function (t) { return t.id === state.activeThreadId; });
        appendMessage({
          id: optimisticId,
          thread_id: state.activeThreadId,
          sender_type: cfg.current.type,
          sender_id: cfg.current.id,
          sender_name: '',
          message: txt,
          created_at: new Date().toISOString()
        }, true, thread ? !!thread.is_group : false);
        // Clear duplicate tracking after 5 seconds
        var dupKeyToClear = optimisticKey;
        setTimeout(function () { optimisticSentIds.delete(dupKeyToClear); optimisticByKey.delete(dupKeyToClear); }, 5000);

        lastOptimisticId = optimisticId;
        socket.emit("message:send", { threadId: state.activeThreadId, message: txt });
      } else {
        sendMessageViaPHP(state.activeThreadId, txt).catch(function (err) {
          var msg = (err && err.payload && err.payload.message) ? err.payload.message : _pgTc("לא ניתן לשלוח הודעה כרגע");
          notifyUser(msg, 'error');
        });
      }

      if (elInput) {
        elInput.value = "";
        elInput.style.height = "auto";
      }
    });
  }

  // File upload handler
  const elFileInput = document.getElementById('pgChatFileInput');
  const elUploadBtn = document.getElementById('pgChatUploadBtn');

  if (elUploadBtn && elFileInput) {
    elUploadBtn.addEventListener('click', function () {
      if (!state.activeThreadId) return;
      elFileInput.value = '';
      elFileInput.click();
    });

    elFileInput.addEventListener('change', function () {
      const file = elFileInput.files[0];
      if (!file || !state.activeThreadId) return;
      // Sending a file is a NEW message — leave edit mode so the next composed
      // text isn't mistaken for an edit of the previously-selected message.
      cancelEditMessage();

      // A photo is shrunk before it goes up, so the limit applies to what is sent, not to the
      // original: a parent's iPhone image was refused here although it would have gone up at 1600px.
      const maxSize = 10 * 1024 * 1024;
      const tooLargeText = _pgTc('הקובץ גדול מדי (מקסימום 10MB)');
      const isImage = /^image\/(jpeg|png)$/i.test(file.type);
      if (!isImage && file.size > maxSize) {
        notifyUser(tooLargeText, 'error');
        return;
      }

      const threadId = state.activeThreadId;
      elUploadBtn.disabled = true;
      elUploadBtn.classList.add('pg-chat__upload-btn--uploading');

      // The file shows up in the conversation at once, with a live progress bar,
      // and the real message bubble takes its place when the server answers.
      let previewUrl = isImage ? URL.createObjectURL(file) : '';
      const uploadingEl = buildUploadingEl(previewUrl, file.name);
      if (elMessages) {
        if (elMessages.querySelector(".text-muted.text-center")) elMessages.innerHTML = "";
        elMessages.appendChild(uploadingEl);
        elMessages.scrollTop = elMessages.scrollHeight;
        keepBottomWhenImagesLoad(uploadingEl);
      }

      let sentBlob = null;
      shrinkImageForUpload(file)
        .then(function (upload) {
          // Same shape as upload_api.php's answer, so the branch below removes the bubble and says why.
          if (upload.blob.size > maxSize) return { ok: false, message: tooLargeText };
          sentBlob = upload.blob;
          if (upload.blob !== file) {
            URL.revokeObjectURL(previewUrl);
            previewUrl = URL.createObjectURL(upload.blob);
            const preview = uploadingEl.querySelector('.pg-chat__upload-preview');
            if (preview) preview.src = previewUrl;
          }
          return uploadChatFile(threadId, upload, function (fraction) {
            setUploadProgress(uploadingEl, fraction);
          });
        })
        .then(function (data) {
          if (data.ok && data.message) {
            // The bubble shows the file this tab just sent instead of downloading it back.
            if (isImage && sentBlob) localAttachmentBlobs.set(String(data.message.id), sentBlob);
            if (state.activeThreadId === threadId) {
              const thread = state.threads.find(function (t) { return t.id === threadId; });
              const isGroup = thread ? !!thread.is_group : false;
              if (uploadingEl.isConnected) {
                const realEl = buildMessageEl(data.message, isGroup);
                uploadingEl.replaceWith(realEl);
                keepBottomWhenImagesLoad(realEl);
              } else {
                appendMessage(data.message, true, isGroup);
              }
            }
            const fileDupKey = threadId + ':' + (data.message.message || '');
            optimisticSentIds.add(fileDupKey);
            setTimeout(function () { optimisticSentIds.delete(fileDupKey); }, 5000);
            if (socket && state.serverConnected) {
              socket.emit('message:file-notify', { messageId: data.message.id, threadId: data.message.thread_id });
            }
          } else {
            uploadingEl.remove();
            notifyUser(data.message || _pgTc('שגיאה בהעלאת הקובץ'), 'error');
          }
        })
        .catch(function () {
          uploadingEl.remove();
          notifyUser(_pgTc('שגיאה בהעלאת הקובץ'), 'error');
        })
        .finally(function () {
          if (previewUrl) URL.revokeObjectURL(previewUrl);
          elUploadBtn.disabled = false;
          elUploadBtn.classList.remove('pg-chat__upload-btn--uploading');
        });
    });
  }

  // A phone photo is 2-6MB and went up as is — about 8s on 4G for 2MB. Like WhatsApp,
  // send it at most 1600px on the long side as a JPEG; a small image, or one the
  // browser can't decode, goes as it is. Resolves { blob, name }.
  const CHAT_IMAGE_MAX_SIDE = 1600;
  const CHAT_IMAGE_KEEP_BYTES = 600 * 1024;
  function shrinkImageForUpload(file) {
    return new Promise(function (resolve) {
      const original = { blob: file, name: file.name };
      if (!/^image\/(jpeg|png)$/i.test(file.type)) { resolve(original); return; }
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function () {
        URL.revokeObjectURL(url);
        const w0 = img.naturalWidth, h0 = img.naturalHeight;
        const scale = Math.min(1, CHAT_IMAGE_MAX_SIDE / Math.max(w0, h0));
        if (!w0 || !h0 || (scale === 1 && file.size <= CHAT_IMAGE_KEEP_BYTES)) { resolve(original); return; }
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(w0 * scale);
        canvas.height = Math.round(h0 * scale);
        const ctx = canvas.getContext('2d');
        if (!ctx || !canvas.toBlob) { resolve(original); return; }
        ctx.fillStyle = '#fff'; // JPEG has no alpha: a transparent PNG would come out black
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(function (blob) {
          if (!blob || blob.size >= file.size) { resolve(original); return; }
          resolve({ blob: blob, name: file.name.replace(/\.[^.]+$/, '') + '.jpg' });
        }, 'image/jpeg', 0.82);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(original); };
      img.src = url;
    });
  }

  // XHR rather than fetch: fetch reports no upload progress.
  function uploadChatFile(threadId, upload, onProgress) {
    return new Promise(function (resolve, reject) {
      const formData = new FormData();
      formData.append('file', upload.blob, upload.name);
      formData.append('threadId', threadId);
      const xhr = new XMLHttpRequest();
      xhr.open('POST', cfg.threadsApiUrl.replace('threads_api.php', 'upload_api.php'));
      xhr.upload.addEventListener('progress', function (e) {
        if (e.lengthComputable && e.total > 0) onProgress(e.loaded / e.total);
      });
      xhr.onload = function () {
        let data = null;
        try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
        resolve(data || {});
      };
      xhr.onerror = function () { reject(new Error('upload_failed')); };
      xhr.send(formData);
    });
  }

  function buildUploadingEl(previewUrl, fileName) {
    const div = document.createElement('div');
    div.className = 'pg-chat__row pg-chat__row--me pg-chat__row--uploading';
    div.dataset.mine = '1';
    const mediaHtml = previewUrl
      ? '<img src="' + escapeHtml(previewUrl) + '" alt="" class="pg-chat__upload-preview">'
      : '<div class="pg-chat__attachment-file"><i class="bi bi-file-earmark me-1"></i><span>' + escapeHtml(fileName) + '</span></div>';
    div.innerHTML =
      '<div class="pg-chat__bubble pg-chat__bubble--me pg-chat__upload-bubble">' +
        '<div class="mb-1">' + mediaHtml + '</div>' +
        '<div class="pg-chat__upload-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">' +
          '<div class="pg-chat__upload-fill"></div>' +
        '</div>' +
        '<div class="pg-chat__meta pg-chat__upload-status"><span class="spinner-border"></span></div>' +
      '</div>';
    return div;
  }

  // An image has no height until it loads, so a bubble appended at the bottom grows
  // after the scroll and its lower part (the progress bar) ends up under the composer.
  function keepBottomWhenImagesLoad(el) {
    el.querySelectorAll('img').forEach(function (img) {
      if (img.complete) return;
      img.addEventListener('load', function () {
        if (elMessages && el.isConnected) elMessages.scrollTop = elMessages.scrollHeight;
      }, { once: true });
    });
  }

  // The percentage while bytes go out; a spinner before the first byte and once all
  // of them are sent, while the server scans and stores the file.
  function setUploadProgress(el, fraction) {
    const pct = Math.max(0, Math.min(100, Math.round(fraction * 100)));
    const fill = el.querySelector('.pg-chat__upload-fill');
    const track = el.querySelector('.pg-chat__upload-track');
    const status = el.querySelector('.pg-chat__upload-status');
    if (fill) fill.style.width = pct + '%';
    if (track) track.setAttribute('aria-valuenow', String(pct));
    if (status) status.innerHTML = pct < 100 ? pct + '%' : '<span class="spinner-border"></span>';
  }

  if (typeof window !== 'undefined') {
    window.addEventListener('resize', syncMobilePageScrollLock);
    window.addEventListener('beforeunload', function () {
      if (!_skipSaveOnUnload) saveWidgetState();
      if (document && document.documentElement) {
        document.documentElement.classList.remove('pg-chat-mobile-lock');
      }
      if (document && document.body) {
        document.body.classList.remove('pg-chat-mobile-lock');
      }
    });
    // Resize the chat widget to match the visible viewport (keyboard-aware).
    // Works with visualViewport (Safari) and falls back to window.innerHeight
    // for InAppBrowser / WKWebView where visualViewport may not fire correctly.
    var adjustWidgetToViewport = function () {
      if (!window.matchMedia('(max-width: 950px)').matches || !elWidget) return;
      var h, top;
      if (window.visualViewport) {
        h = window.visualViewport.height;
        top = window.visualViewport.offsetTop;
      } else {
        h = window.innerHeight;
        top = 0;
      }
      elWidget.style.height = h + 'px';
      elWidget.style.bottom = 'auto';
      elWidget.style.top = top + 'px';
      if (elMessages && state.activeThreadId) {
        elMessages.scrollTop = elMessages.scrollHeight;
      }
    };

    // Fix mobile viewport jumps (keyboard open/close, address bar)
    if (window.visualViewport) {
      var vpUpdatePending = false;
      var vpUpdate = function () {
        if (vpUpdatePending) return;
        vpUpdatePending = true;
        requestAnimationFrame(function () {
          vpUpdatePending = false;
          adjustWidgetToViewport();
        });
      };
      window.visualViewport.addEventListener('resize', vpUpdate);
      window.visualViewport.addEventListener('scroll', vpUpdate);
    }

    // Fallback: window resize also triggers adjustment.
    // In InAppBrowser, visualViewport exists but may not fire its own events,
    // so this catches cases where only the window resize event fires.
    window.addEventListener('resize', function () {
      adjustWidgetToViewport();
    });

    // On iOS InAppBrowser, focusing the input triggers the keyboard but the
    // widget may not resize in time. Explicitly adjust the widget height at
    // multiple intervals to catch the keyboard animation, then scroll messages.
    if (elInput) {
      elInput.addEventListener('focus', function () {
        if (!window.matchMedia('(max-width: 950px)').matches) return;
        // Multiple passes to catch the keyboard animation at different stages.
        // InAppBrowser can be slower than Safari to report the new viewport.
        var delays = [50, 150, 300, 500, 800];
        delays.forEach(function (ms) {
          setTimeout(adjustWidgetToViewport, ms);
        });
      });
    }
  }

  // Restore saved widget state or handle directOpen
  var _hasDirectOpen = cfg.directOpen && ((cfg.directOpen.type && cfg.directOpen.id) || cfg.directOpen.threadId);
  var _savedState = _hasDirectOpen ? null : loadWidgetState();

  if (cfg.directOpen && cfg.directOpen.type && cfg.directOpen.id) {
    setTimeout(function () {
      openDirectConversation(cfg.directOpen.type, cfg.directOpen.id, _pgTc('שיחה', null, 'chat'));
      cfg.directOpen = null;
      toggleWidget(true);
    }, 300);
  } else if (cfg.directOpen && cfg.directOpen.threadId) {
    setTimeout(function () {
      openThread(parseInt(cfg.directOpen.threadId, 10), _pgTc('טוען...'));
      cfg.directOpen = null;
      toggleWidget(true);
    }, 300);
  } else if (_savedState && _savedState.isOpen) {
    // Restore previous session state
    if (window.innerWidth > 576) {
      // Only restore open widget on desktop — mobile should start closed
      setTimeout(function () {
        if (_savedState.tab) switchTab(_savedState.tab);
        toggleWidget(true);
        if (_savedState.supportOpen) {
          if (_savedState.aiChatBotType) {
            loadSupportAIChat(_savedState.aiChatBotType);
          } else {
            openSupportWidget();
          }
        } else if (_savedState.activeThreadId) {
          openThread(parseInt(_savedState.activeThreadId, 10), _pgTc('טוען...'));
        }
      }, 300);
    }
  }

  if (!_savedState || !_savedState.isOpen) {
    switchTab("threads");
  }

  // Ensure toggle button is visible on load
  if (elToggle) {
    elToggle.style.display = "flex";
  }

  syncMobilePageScrollLock();

  // From the push "צוות התמיכה של פגישונים ענה לך" (inc/functions/support_inbox.php, sibLoginLink()): the link
  // lands here with ?pgSupportChat=1, and the support chat opens on the conversation the team answered in. The
  // marker leaves the address so a reload does not open it again.
  try {
    const supportParams = new URLSearchParams(window.location.search);
    if (supportParams.get('pgSupportChat') === '1') {
      supportParams.delete('pgSupportChat');
      const rest = supportParams.toString();
      history.replaceState(null, '', window.location.pathname + (rest ? '?' + rest : '') + window.location.hash);
      setTimeout(function () {
        loadSupportAIChat(cfg.isAdminPanel ? 'admin' : 'users');
        toggleWidget(true);
      }, 350);
    }
  } catch (e) {
    // No URLSearchParams / history (a very old browser): the page opens as usual.
  }

  // A request with the support team is open in this session (chat_api.php sibWatchSet()) and the support chat is not
  // loaded on this page: the page asks now and then whether the team answered, and shows it by the button
  // (support_notice.js). A page with nothing open never asks. Started after the saved state may have reopened the
  // support chat above — its own poll is the one then (startHuman stops this watch). Also when the support chat is
  // opened anew while its request is with the team (pollHuman).
  function startSupportWatch() {
    if (!cfg.supportInbox || !window.pgSupportNotice || state.supportPolling) return;
    const watchBotType = cfg.isAdminPanel ? 'admin' : 'users';
    window.pgSupportNotice.watch({
      url: (cfg.aiChatApiUrl || '/M/chat/support/chat_api.php') + '?action=human_poll&bot_type=' + watchBotType,
      launcher: function () { return elToggle; },
      isOpen: function () { return state.isOpen; },
      onOpen: function () {
        loadSupportAIChat(watchBotType);
        toggleWidget(true);
      },
      closeLabel: _pgTc('סגירה'),
      setCount: function (n) { state.supportUnseen = n; updateBadge(); }
    });
  }
  if (cfg.supportWatch) {
    setTimeout(startSupportWatch, 1500);
  }

  // Opens the AI support chat with a question already typed in, but NOT sent. This is the
  // single entry point other screens use to hand a user over — today the admin search palette
  // (M/assets/js/global_search.js) when a search returned nothing. The twin definition for
  // pages where this widget is not rendered lives in M/inc/footer.php; exactly one of the two
  // exists on any given page, so callers must feature-detect before calling.
  window.pgSupportAskAI = function (text) {
    // loadSupportAIChat() before toggleWidget(): it sets state.supportOpen, which stops
    // toggleWidget from rendering the support menu over the chat we just built.
    loadSupportAIChat(cfg.isAdminPanel ? 'admin' : 'users', text);
    toggleWidget(true);
    // The composer was focused while the widget was still display:none, where focus does not
    // stick. Put the caret back now that it is on screen.
    const composer = document.querySelector('.pg-ai-chat-input-wrap input');
    if (composer) composer.focus();
  };

  // A school without the chat loads this file on the button's first tap (chat_widget.php, PG-910); the loader opens the
  // widget through this, as that tap would have.
  window.pgChatOpenWidget = function () {
    toggleWidget(true);
  };

  // Handoff from standalone onboarding overlay
  window._pgChatHandoff = function(msg) {
    loadSupportAIChat(cfg.isAdminPanel ? 'admin' : 'users');
    toggleWidget(true);
    setTimeout(function() {
      const aiInput = document.querySelector('.pg-ai-chat-input-wrap input');
      const aiSendBtn = document.querySelector('.pg-ai-chat-send-btn');
      if (aiInput) { aiInput.value = msg; if (aiSendBtn) aiSendBtn.click(); }
    }, 800);
  };
  if (window._pgOnboardMsg) {
    window._pgChatHandoff(window._pgOnboardMsg);
    window._pgOnboardMsg = null;
  }

})();
