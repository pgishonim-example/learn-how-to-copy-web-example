const THEME_KEY="theme";function toggleDarkTheme(){setTheme("dark"===document.documentElement.getAttribute("data-bs-theme")?"light":"dark")}function setTheme(e,t=!1){document.body.classList.add(e),document.documentElement.setAttribute("data-bs-theme",e),t&&localStorage.setItem(THEME_KEY,e)}function initTheme(){let e=localStorage.getItem(THEME_KEY);if(e)return setTheme(e)}window.addEventListener("DOMContentLoaded",()=>{let e=document.getElementById("toggle-dark"),t=localStorage.getItem(THEME_KEY);e&&(e.checked="dark"===t,e.addEventListener("input",e=>{setTheme(e.target.checked?"dark":"light",!0)}))}),initTheme();