const stepsArray=[],tutorialElements=document.querySelectorAll("[tutorial-description]"),locationCurrentPage=window.location.pathname.split("/").pop();function isTutorialElementOnPage(t){if(!t||!t.isConnected)return!1;const e=t.getBoundingClientRect();if(e.width<=0&&e.height<=0)return!1;const l=window.getComputedStyle(t);return"none"!==l.display&&"hidden"!==l.visibility}tutorialElements.forEach(t=>{let e=t.getAttribute("tutorial-title"),r=t.getAttribute("tutorial-description"),i=t.getAttribute("tutorial-page-only");if((null===i||i===locationCurrentPage)&&isTutorialElementOnPage(t)&&!stepsArray.some(t=>t.popover.title===e||t.popover.description===r)){let o={element:t,popover:{title:e,description:r}};stepsArray.push(o)}});const driver=window.driver&&window.driver.js?window.driver.js.driver:null,driverObj=driver?driver({showProgress:!0,steps:stepsArray}):null;function finishCurrentTutorial(){var t=document.getElementById("tutorial_ajax_form");fetch("/ajax/tutorial_finish_ajax.php",{method:"POST",body:new FormData(t)})}stepsArray.length>0&&driverObj&&driverObj.drive(),window.addEventListener("load",function(){stepsArray.length>0&&driverObj&&finishCurrentTutorial()});
